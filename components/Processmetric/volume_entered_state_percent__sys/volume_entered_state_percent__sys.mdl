RECREATE Processmetric volume_entered_state_percent__sys (
   label('Entered X State %'),
   active(true),
   default(false),
   default_type_order(),
   description('The percentage of unique records that entered a specific state ''X'' out of all qualifying records.'),
   type_picklist('Picklist.metric_type__sys'),
   type_value('Picklistentry.volume__sys')
);