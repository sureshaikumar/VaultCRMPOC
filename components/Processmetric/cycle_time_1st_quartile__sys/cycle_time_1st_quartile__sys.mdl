RECREATE Processmetric cycle_time_1st_quartile__sys (
   label('1st Quartile'),
   active(true),
   default(true),
   default_type_order(3),
   description('The 25th percentile of time between the start and end states. Only records that enter the end state are included in this calculation.'),
   type_picklist('Picklist.metric_type__sys'),
   type_value('Picklistentry.cycle_time__sys')
);