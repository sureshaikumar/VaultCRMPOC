RECREATE Processmetric quality_completed_late_total__sys (
   label('Completed Late'),
   active(true),
   default(false),
   default_type_order(),
   description('The number of records where the time between the start and end states is greater than the cycle time target. The cycle time target must be set to calculate this metric.'),
   type_picklist('Picklist.metric_type__sys'),
   type_value('Picklistentry.quality__sys')
);