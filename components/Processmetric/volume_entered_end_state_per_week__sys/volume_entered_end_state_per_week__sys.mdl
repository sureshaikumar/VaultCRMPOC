RECREATE Processmetric volume_entered_end_state_per_week__sys (
   label('Entered End State / Week'),
   active(true),
   default(false),
   default_type_order(),
   description('The average number of unique records that entered the end state per week.'),
   type_picklist('Picklist.metric_type__sys'),
   type_value('Picklistentry.volume__sys')
);