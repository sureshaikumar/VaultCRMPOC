RECREATE Processmetric cycle_time_median__sys (
   label('Median'),
   active(true),
   default(true),
   default_type_order(2),
   description('The median time between the start and end states. Only records that enter the end state are included in this calculation.'),
   type_picklist('Picklist.metric_type__sys'),
   type_value('Picklistentry.cycle_time__sys')
);