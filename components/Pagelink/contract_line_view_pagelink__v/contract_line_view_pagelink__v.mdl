RECREATE Pagelink contract_line_view_pagelink__v (
   label('Contract Line View'),
   description('Redirects viewing Contract Lines to the Contract Lines App Page'),
   url('https://{{Vault.domain}}/ui/#app/page/{{Page.url_path_name}}/~/{{Object.id}}/view'),
   mode('View'),
   page_type('Object'),
   object('Object.contract_line__v'),
   active(true),
   disable_type_select(false),
   page('Page.contract_line_app_page__v')
);