RECREATE Pagelink em_event_material_view_pagelink__v (
   label('EM Event Material View'),
   description('Redirects viewing Event Material to the EM Event Material Detail App Page'),
   url('https://{{Vault.domain}}/ui/#app/page/{{Page.url_path_name}}/~/{{Object.id}}/view'),
   mode('View'),
   page_type('Object'),
   object('Object.em_event_material__v'),
   active(true),
   disable_type_select(false),
   page('Page.em_event_material_detail_app_page__v')
);