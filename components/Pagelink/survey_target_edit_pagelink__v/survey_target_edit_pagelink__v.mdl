RECREATE Pagelink survey_target_edit_pagelink__v (
   label('Survey Target Edit'),
   description('Redirect Survey Target Edit to Survey Target Detail Page.'),
   url('https://{{Vault.domain}}/ui/#app/page/{{Page.url_path_name}}/~/edit?fieldParameters={{Related.fieldParameters}}&surveyTargetId={{Object.id}}'),
   mode('Edit'),
   page_type('Object'),
   object('Object.survey_target__v'),
   active(true),
   disable_type_select(false),
   page('Page.survey_target_detail_page__v')
);