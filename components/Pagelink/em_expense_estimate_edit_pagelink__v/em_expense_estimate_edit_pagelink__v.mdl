RECREATE Pagelink em_expense_estimate_edit_pagelink__v (
   label('EM Expense Estimate Edit'),
   description('Redirects editing Expense Estimate to the EM Expense Estimate Detail App Page'),
   url('https://{{Vault.domain}}/ui/#app/page/{{Page.url_path_name}}/~/{{Metadata.name}}/{{Object.id}}/edit'),
   mode('Edit'),
   page_type('Object'),
   object('Object.em_expense_estimate__v'),
   active(true),
   disable_type_select(false),
   page('Page.em_router_page__v')
);