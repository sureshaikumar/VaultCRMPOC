RECREATE Pagelink order_edit_pagelink__v (
   label('Order Edit'),
   description('Redirects editing Orders to the Order Detail App Page'),
   url('https://{{Vault.domain}}/ui/#app/page/{{Page.url_path_name}}/~/{{Object.id}}/edit'),
   mode('Edit'),
   page_type('Object'),
   object('Object.order__v'),
   active(true),
   disable_type_select(false),
   page('Page.order_detail_page__v')
);