RECREATE Pagelink em_event_session_view_pagelink__v (
   label('EM Event Session View'),
   description('Redirects viewing Event Session to the EM Event Session Detail App Page'),
   url('https://{{Vault.domain}}/ui/#app/page/{{Page.url_path_name}}/~/{{Object.id}}/view'),
   mode('View'),
   page_type('Object'),
   object('Object.em_event_session__v'),
   active(true),
   disable_type_select(false),
   page('Page.em_event_session_detail_app_page__v')
);