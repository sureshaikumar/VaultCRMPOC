   label('Child Account Create'),
   description('Redirect Child Account Creation to Child Account App Page'),
   url('https://{{Vault.domain}}/ui/#app/page/{{Page.url_path_name}}/~/create?fieldParameters={{Related.fieldParameters}}'),
   mode('Create'),
   page_type('Object'),
   object('Object.child_account__v'),
   active(true),
   disable_type_select(false),
   page('Page.child_account_page__v')
);