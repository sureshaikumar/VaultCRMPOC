   label('EM Event Action Edit'),
   description('Redirects editing Event Action to the EM Event Action Detail App Page'),
   url('https://{{Vault.domain}}/ui/#app/page/{{Page.url_path_name}}/~/{{Object.id}}/edit'),
   mode('Edit'),
