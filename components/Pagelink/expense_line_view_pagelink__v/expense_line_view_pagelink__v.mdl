RECREATE Pagelink expense_line_view_pagelink__v (
   label('Expense Line View'),
   description('Redirects viewing Expense Line to the Expense Line Detail App Page'),
   url('https://{{Vault.domain}}/ui/#app/page/{{Page.url_path_name}}/~/{{Object.id}}/view'),
   mode('View'),
   page_type('Object'),
   object('Object.expense_line__v'),
   active(true),
   disable_type_select(false),
   page('Page.expense_line_detail_app_page__v')
);