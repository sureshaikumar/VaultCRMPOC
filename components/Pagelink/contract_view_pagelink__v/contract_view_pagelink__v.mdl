RECREATE Pagelink contract_view_pagelink__v (
   label('Contract View'),
   description('Redirects viewing Contracts to the Contract App Page'),
   url('https://{{Vault.domain}}/ui/#app/page/{{Page.url_path_name}}/~/{{Object.id}}/view'),
   mode('View'),
   page_type('Object'),
   object('Object.contract__v'),
   active(true),
   disable_type_select(false),
   page('Page.contract_app_page__v')
);