RECREATE Pagelink em_event_speaker_view_pagelink__v (
   label('EM Event Speaker View'),
   description('Redirects viewing Event Speaker to the EM Event Speaker Detail App Page'),
   url('https://{{Vault.domain}}/ui/#app/page/{{Page.url_path_name}}/~/{{Object.id}}/view'),
   mode('View'),
   page_type('Object'),
   object('Object.em_event_speaker__v'),
   active(true),
   disable_type_select(false),
   page('Page.em_event_speaker_detail_app_page__v')
);