RECREATE Pagelink child_account_edit_pagelink__v (
   label('Child Account Edit'),
   description('Redirect Child Account editing to Child Account App Page'),
   url('https://{{Vault.domain}}/ui/#app/page/{{Page.url_path_name}}/~/edit/{{Object.id}}'),
   mode('Edit'),
   page_type('Object'),
   object('Object.child_account__v'),
   active(true),
   disable_type_select(false),
   page('Page.child_account_page__v')
);