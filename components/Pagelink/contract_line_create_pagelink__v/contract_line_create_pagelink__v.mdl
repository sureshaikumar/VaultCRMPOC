RECREATE Pagelink contract_line_create_pagelink__v (
   label('Contract Line Create'),
   description('Redirects creating Contract Lines to the Contract Line App Page'),
   url('https://{{Vault.domain}}/ui/#app/page/{{Page.url_path_name}}/~/create?fieldParameters={{Related.fieldParameters}}'),
   mode('Create'),
   page_type('Object'),
   object('Object.contract_line__v'),
   active(true),
   disable_type_select(false),
   page('Page.contract_line_app_page__v')
);