   label('EM Event Session Edit'),
   description('Redirects editing Event Session to the EM Event Session Detail App Page'),
   url('https://{{Vault.domain}}/ui/#app/page/{{Page.url_path_name}}/~/{{Metadata.name}}/{{Object.id}}/edit'),
   mode('Edit'),
   page_type('Object'),
   object('Object.em_event_session__v'),
   active(true),
   disable_type_select(false),
   page('Page.em_router_page__v')
);