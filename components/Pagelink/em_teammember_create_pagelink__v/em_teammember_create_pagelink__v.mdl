RECREATE Pagelink em_teammember_create_pagelink__v (
   label('EM Team Member Create'),
   description('Redirects creating Team Member to the EM Team Member Detail App Page'),
   url('https://{{Vault.domain}}/ui/#app/page/{{Page.url_path_name}}/~/create?fieldParameters={{Related.fieldParameters}}'),
   mode('Create'),
   page_type('Object'),
   object('Object.em_event_team_member__v'),
   active(true),
   disable_type_select(false),
   page('Page.em_team_member_detail_app_page__v')
);