RECREATE Pagelink em_speaker_create_pagelink__v (
   label('EM Speaker Create'),
   description('Redirects Speaker creation to the EM Speaker Detail App Page'),
   url('https://{{Vault.domain}}/ui/#app/page/{{Page.url_path_name}}/~/create?fieldParameters={{Related.fieldParameters}}'),
   mode('Create'),
   page_type('Object'),
   object('Object.em_speaker__v'),
   active(true),
   disable_type_select(false),
   page('Page.em_speaker_detail_app_page__v')
);