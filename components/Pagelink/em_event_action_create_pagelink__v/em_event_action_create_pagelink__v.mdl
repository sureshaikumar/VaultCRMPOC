RECREATE Pagelink em_event_action_create_pagelink__v (
   label('EM Event Action Create'),
   description('Redirects creating Event Action to the EM Event Action Detail App Page'),
   url('https://{{Vault.domain}}/ui/#app/page/{{Page.url_path_name}}/~/create?fieldParameters={{Related.fieldParameters}}'),
   mode('Create'),
   page_type('Object'),
   object('Object.em_event_action__v'),
   active(true),
   disable_type_select(false),
   page('Page.em_event_action_detail_app_page__v')
);