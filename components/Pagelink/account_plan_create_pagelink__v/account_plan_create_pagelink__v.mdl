   label('Account Plan Create'),
   description('Redirects creating Account Plans to the Account Plan Create App Page'),
   url('https://{{Vault.domain}}/ui/#app/page/{{Page.url_path_name}}?fieldParameters={{Related.fieldParameters}}'),
   mode('Create'),
   page_type('Object'),
   object('Object.account_plan__v'),
   active(true),
   disable_type_select(false),
   page('Page.account_plan_create_page__v')
);