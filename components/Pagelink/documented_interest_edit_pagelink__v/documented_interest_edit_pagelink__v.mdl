RECREATE Pagelink documented_interest_edit_pagelink__v (
   label('Edit Documented Interest'),
   description('Redirects Documented Interest Edit to the App Page'),
   url('https://{{Vault.domain}}/ui/#app/page/{{Page.url_path_name}}/~/edit?fieldParameters={{Related.fieldParameters}}&id={{Object.id}}'),
   mode('Edit'),
   page_type('Object'),
   object('Object.documented_interest__v'),
   active(true),
   disable_type_select(false),
   page('Page.documented_interest_page__v')
);