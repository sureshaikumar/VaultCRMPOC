RECREATE Pagelink em_event_view_pagelink__v (
   label('EM Event View'),
   description('Redirects Events to the EM Event Detail App Page'),
   url('https://{{Vault.domain}}/ui/#app/page/{{Page.url_path_name}}/~/{{Object.id}}/view'),
   mode('View'),
   page_type('Object'),
   object('Object.em_event__v'),
   active(true),
   disable_type_select(false),
   page('Page.em_event_detail_app_page__v')
);