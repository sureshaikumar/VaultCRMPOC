RECREATE Pagelink em_event_session_create_pagelink__v (
   label('EM Event Session Create'),
   description('Redirects creating Event Session to the EM Event Session Detail App Page'),
   url('https://{{Vault.domain}}/ui/#app/page/{{Page.url_path_name}}/~/create?fieldParameters={{Related.fieldParameters}}'),
   mode('Create'),
   page_type('Object'),
   object('Object.em_event_session__v'),
   active(true),
   disable_type_select(false),
   page('Page.em_event_session_detail_app_page__v')
);