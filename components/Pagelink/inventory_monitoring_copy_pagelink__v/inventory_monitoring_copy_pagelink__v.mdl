RECREATE Pagelink inventory_monitoring_copy_pagelink__v (
   label('Inventory Monitoring Copy'),
   description('Redirect copy Inventory Monitorings requests to the Inventory Monitoring Detail App Page'),
   url('https://{{Vault.domain}}/ui/#app/page/{{Page.url_path_name}}/~/copy'),
   mode('Copy'),
   page_type('Object'),
   object('Object.inventory_monitoring__v'),
   active(true),
   disable_type_select(false),
   page('Page.inventory_monitoring_detail_page__v')
);