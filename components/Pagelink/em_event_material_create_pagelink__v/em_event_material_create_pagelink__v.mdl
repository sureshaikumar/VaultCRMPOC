RECREATE Pagelink em_event_material_create_pagelink__v (
   label('EM Event Material Create'),
   description('Redirects creating Event Material to the EM Event Material Detail App Page'),
   url('https://{{Vault.domain}}/ui/#app/page/{{Page.url_path_name}}/~/create?fieldParameters={{Related.fieldParameters}}'),
   mode('Create'),
   page_type('Object'),
   object('Object.em_event_material__v'),
   active(true),
   disable_type_select(false),
   page('Page.em_event_material_detail_app_page__v')
);