RECREATE Pagelink em_event_create_pagelink__v (
   label('EM Event Create'),
   description('Redirects Event creation to the EM Event Detail App Page'),
   url('https://{{Vault.domain}}/ui/#app/page/{{Page.url_path_name}}/~/create?fieldParameters={{Related.fieldParameters}}'),
   mode('Create'),
   page_type('Object'),
   object('Object.em_event__v'),
   active(true),
   disable_type_select(true),
   page('Page.em_event_wizard_page__v')
);