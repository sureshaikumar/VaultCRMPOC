RECREATE Pagelink em_event_material_edit_pagelink__v (
   label('EM Event Material Edit'),
   description('Redirects editing Event Material to the EM Event Material Detail App Page'),
   url('https://{{Vault.domain}}/ui/#app/page/{{Page.url_path_name}}/~/{{Metadata.name}}/{{Object.id}}/edit'),
   mode('Edit'),
   page_type('Object'),
   object('Object.em_event_material__v'),
   active(true),
   disable_type_select(false),
   page('Page.em_router_page__v')
);