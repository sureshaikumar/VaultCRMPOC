RECREATE Pagelink contract_edit_pagelink__v (
   label('Contract Edit'),
   description('Redirects editing Contracts to the Contract App Page'),
   url('https://{{Vault.domain}}/ui/#app/page/{{Page.url_path_name}}/~/{{Object.id}}/edit'),
   mode('Edit'),
   page_type('Object'),
   object('Object.contract__v'),
   active(true),
   disable_type_select(false),
   page('Page.contract_app_page__v')
);