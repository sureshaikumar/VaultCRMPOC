RECREATE Pagelink checklist_design__sys (
   label('Checklist Design'),
   description('Redirects Checklist Design view to a router for the Visual Checklist Designer page layout'),
   url('https://{{Vault.domain}}/ui/#sys/page/{{Page.url_path_name}}/~/{{Object.id}}'),
   mode('View'),
   page_type('Object'),
   object('Object.checklist_design__sys'),
   active(true),
   disable_type_select(false),
   page('Page.vcd_router_page__sys')
);