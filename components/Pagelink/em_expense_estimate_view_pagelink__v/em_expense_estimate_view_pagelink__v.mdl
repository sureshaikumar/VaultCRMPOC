RECREATE Pagelink em_expense_estimate_view_pagelink__v (
   label('EM Expense Estimate View'),
   description('Redirects viewing Expense Estimate to the EM Expense Estimate Detail App Page'),
   url('https://{{Vault.domain}}/ui/#app/page/{{Page.url_path_name}}/~/{{Object.id}}/view'),
   mode('View'),
   page_type('Object'),
   object('Object.em_expense_estimate__v'),
   active(true),
   disable_type_select(false),
   page('Page.em_expense_estimate_detail_app_page__v')
);