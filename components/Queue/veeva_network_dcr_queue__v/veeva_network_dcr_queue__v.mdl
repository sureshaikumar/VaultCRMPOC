RECREATE Queue veeva_network_dcr_queue__v (
   label('Veeva Network DCR Queue'),
   active(true),
   description(),
   message_delivery_event_handler('Messagedeliveryeventhandler.com.veeva.vault.app.vaultcrm.core.datachangerequests.eventhandlers.VeevaNetworkDcrQueueMessageDeliveryHandler'),
   message_delivery_event_handler_user('User.vault_app_owner'),
   message_processor(),
   message_processor_user(),
   rollback_on_error(true),
   sequential(true),
   type('outbound'),
   Queueconnection(@Queueconnection/veeva_network_queue_connection__v.mdl)
);