RECREATE Queue cm_target_loader__v (
   label('Campaign Manager Target Loader Queue'),
   active(true),
   description(),
   message_delivery_event_handler('Messagedeliveryeventhandler.com.veeva.vault.app.vaultcrm.campaignmanager.eventhandlers.TargetLoaderMessageDeliveryHandler'),
   message_delivery_event_handler_user('User.vault_app_owner'),
   message_processor(),
   message_processor_user(),
   rollback_on_error(true),
   sequential(false),
   type('outbound'),
   Queueconnection(@Queueconnection/cm_target_loader_connection__v.mdl)
);