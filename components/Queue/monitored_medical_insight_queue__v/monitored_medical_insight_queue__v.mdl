RECREATE Queue monitored_medical_insight_queue__v (
   label('Monitored Medical Insight Inbound Queue'),
   active(true),
   description(),
   message_delivery_event_handler(),
   message_delivery_event_handler_user(),
   message_processor('Messageprocessor.com.veeva.vault.app.vaultcrm.core.homeoffice.messageprocessors.MonitoredMedicalInsightMessageProcessor'),
   message_processor_user('User.vault_app_owner'),
   rollback_on_error(true),
   sequential(true),
   type('inbound'),
   Queueconnection(@Queueconnection/monitored_medical_insight_connection__v.mdl)
);