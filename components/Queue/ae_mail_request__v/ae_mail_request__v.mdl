   label('Approved Email Mail Request Queue'),
   active(true),
   description(),
   message_delivery_event_handler('Messagedeliveryeventhandler.com.veeva.vault.app.vaultcrm.common.eventhandlers.OffPlatformMessageDeliveryHandler'),
   message_delivery_event_handler_user('User.vault_app_owner'),
   message_processor(),
