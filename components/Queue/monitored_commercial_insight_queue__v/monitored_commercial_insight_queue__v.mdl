RECREATE Queue monitored_commercial_insight_queue__v (
   label('Monitored Commercial Insight Inbound Queue'),
   active(true),
   description(),
   message_delivery_event_handler(),
   message_delivery_event_handler_user(),
   message_processor('Messageprocessor.com.veeva.vault.app.vaultcrm.core.homeoffice.messageprocessors.MonitoredCommercialInsightMessageProcessor'),
   message_processor_user('User.vault_app_owner'),
   rollback_on_error(true),
   sequential(true),
   type('inbound'),
   Queueconnection(@Queueconnection/monitored_commercial_insight_connection__v.mdl)
);