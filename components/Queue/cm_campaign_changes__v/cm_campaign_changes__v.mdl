RECREATE Queue cm_campaign_changes__v (
   label('Campaign Manager Campaign Changes Queue'),
   active(true),
   description(),
   message_delivery_event_handler('Messagedeliveryeventhandler.com.veeva.vault.app.vaultcrm.common.eventhandlers.OffPlatformMessageDeliveryHandler'),
   message_delivery_event_handler_user('User.vault_app_owner'),
   message_processor(),
   message_processor_user(),
   rollback_on_error(true),
   sequential(false),
   type('outbound'),
   Queueconnection(@Queueconnection/cm_campaign_changes_connection__v.mdl)
);