RECREATE Queue monitored_action_item_queue__v (
   label('Monitored Action Item Inbound Queue'),
   active(true),
   description(),
   message_delivery_event_handler(),
   message_delivery_event_handler_user(),
   message_processor('Messageprocessor.com.veeva.vault.app.vaultcrm.core.homeoffice.messageprocessors.MonitoredActionItemMessageProcessor'),
   message_processor_user('User.vault_app_owner'),
   rollback_on_error(true),
   sequential(true),
   type('inbound'),
   Queueconnection(@Queueconnection/monitored_action_item_connection__v.mdl)
);