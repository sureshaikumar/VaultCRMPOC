RECREATE Queue promomats_crm_inbound_queue__v (
   label('PromoMats-CRM Inbound Queue'),
   active(true),
   description(),
   message_delivery_event_handler(),
   message_delivery_event_handler_user(),
   message_processor('Messageprocessor.com.veeva.vault.app.vaultcrm.core.promomats.messageprocessors.PromomatsConnectionMessageProcessor'),
   message_processor_user('User.vault_app_owner'),
   rollback_on_error(true),
   sequential(false),
   type('inbound'),
   Queueconnection(@Queueconnection/promomats_crm_iqc__v.mdl)
);