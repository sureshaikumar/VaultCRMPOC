RECREATE Notificationtemplate delete_cld_in_background_success__v (
   label('Delete In Background Succeeded'),
   active(true),
   description('Notification template notifying user that their checklist design has been deleted in background.'),
   email_preferences('summary__sys'),
   referenced_component(),
   subject('Delete Checklist Design in Background Succeeded'),
   notification('<p>Your Checklist Design: ${checklist_design__sys_name} was successfully deleted.</p>'),
   email_body('${notificationMessage}'),
   entity_type('object'),
   notification_category('none__sys')
);