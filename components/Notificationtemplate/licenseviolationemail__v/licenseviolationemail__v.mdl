RECREATE Notificationtemplate licenseviolationemail__v (
   label('licenseViolationEmail'),
   active(true),
   description(),
   email_preferences('every_occurrence__sys'),
   referenced_component(),
   subject('License Violation: ${referencedUserNames} has committed a license violation on "${docNameNoLink}".'),
   notification('<p>User ${referencedUserNames} has performed an action on ${docName} that is prohibited by the licensing terms for their user type.</p>

Please review the Document Audit History and ensure that the correct user type is selected for ${referencedUserNames}.'),
   email_body('<p>${notificationMessage}</p>
'),
   entity_type('document'),
   notification_category('none__sys')
);