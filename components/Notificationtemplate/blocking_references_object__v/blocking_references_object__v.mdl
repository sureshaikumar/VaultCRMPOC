RECREATE Notificationtemplate blocking_references_object__v (
   label('Blocking References Object'),
   active(true),
   description('Message template for exporting blocking references for object deletion or state change'),
   email_preferences('summary__sys'),
   referenced_component(),
   subject('Blocking Reference Report for ${objectLabel} ${recordName}'),
   notification('<p>Your reference report has completed successfully for ${objectLabel} ${recordName}.</p><p><a href="${linkToFile}">${fileName}</a></p>'),
   email_body('<p>Your reference report has completed successfully for ${objectLabel} ${recordName}.</p><p><a href="${linkToFile}">${fileName}</a></p>'),
   entity_type('object'),
   notification_category('none__sys')
);