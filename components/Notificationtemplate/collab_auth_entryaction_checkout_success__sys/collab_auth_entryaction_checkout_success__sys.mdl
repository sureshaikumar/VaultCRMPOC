RECREATE Notificationtemplate collab_auth_entryaction_checkout_success__sys (
   label('Collab Auth Entry Checkout Success'),
   active(true),
   description('Notification template notifying user of the success of their collaborative authoring checkout entry action.'),
   email_preferences('summary__sys'),
   referenced_component(),
   subject('Notification: Collaborative Authoring checkout entry action completed successfully'),
   notification('<p>The document <a href="${CollabAuthActionResultDocumentURL}">${CollabAuthActionResultDocumentName}</a> checked out to Microsoft Office successfully. <a href="${CollabAuthActionResultCsvURL}">See results.</a></p>'),
   email_body('<p>The document <a href="${CollabAuthActionResultDocumentURL}">${CollabAuthActionResultDocumentName}</a> checked out to Microsoft Office successfully. <a href="${CollabAuthActionResultCsvURL}">See results.</a></p>'),
   entity_type('document'),
   notification_category('none__sys')
);