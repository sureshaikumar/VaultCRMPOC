RECREATE Notificationtemplate add_language_preference_notification__v (
   label('New Language Preference Set'),
   active(true),
   description(),
   email_preferences('summary__sys'),
   referenced_component(),
   subject('A language has been added to your search language preferences'),
   notification('${addedSearchableLanguage} was added to your search language preferences. You can update these language settings in your <a href="${userProfileUrl}">User Profile Page</a>'),
   email_body('${addedSearchableLanguage} was added to your search language preferences. You can update these language settings in your <a href="${userProfileUrl}">User Profile Page</a>'),
   entity_type('document'),
   notification_category('none__sys')
);