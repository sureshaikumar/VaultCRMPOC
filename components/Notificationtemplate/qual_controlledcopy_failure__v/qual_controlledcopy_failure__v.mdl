RECREATE Notificationtemplate qual_controlledcopy_failure__v (
   label('controlledCopyFailure'),
   active(true),
   description(),
   email_preferences('every_occurrence__sys'),
   referenced_component(),
   subject('Controlled Copy Job Encountered Errors'),
   notification('<p>Your Controlled Copy Job has encountered an error</p>
<p>Details:
<ul>
<li>Copy Type: ${dist_copy_type__v}</li>
<li>Document: ${docNumber}</li>
<li>Audience Details: ${dist_audience_details__v}</li>
<li>Reason/Justification: ${dist_reason_justification__v}</li>
<li>Number of Copies: ${numCopies}</li>
<li>${numCopiesPrepared} copies prepared <a href=${controlledCopyDownloadLink}>here</a></li>
<li>Error Messages: ${controlledCopyErrorList}</li>
</ul>
</p>'),
   email_body('${notificationMessage}'),
   entity_type('document'),
   notification_category('none__sys')
);