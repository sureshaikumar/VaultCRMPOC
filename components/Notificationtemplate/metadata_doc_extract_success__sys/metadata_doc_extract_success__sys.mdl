RECREATE Notificationtemplate metadata_doc_extract_success__sys (
   label('Document Extraction Success'),
   active(true),
   description(),
   email_preferences('every_occurrence__sys'),
   referenced_component('Object.trained_model__sys'),
   subject('Document Extract for the Trained Model "${Object.name__v}" has completed successfully.'),
   notification('<p>Document Extract for the Trained Model "${Object.name__v}" has completed successfully. Your Trained Model record will now begin testing metadata extraction with this extracted data.</p><p>Please review the documentset_extract_results.csv in the list of Trained Model Artifacts on the Trained Model record, and its related Trained Model Performance Metrics records.</p>'),
   email_body('<p>${notificationMessage}</p> <p>Please <a href="${uiBaseExtUrl}">login to Vault</a> to view all of your tasks and notifications.</p>'),
   entity_type('object'),
   notification_category('none__sys')
);