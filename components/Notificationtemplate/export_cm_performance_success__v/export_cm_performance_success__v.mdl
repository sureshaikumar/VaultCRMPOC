RECREATE Notificationtemplate export_cm_performance_success__v (
   label('Export Campaign Performance Job Success'),
   active(true),
   description('Notifies the user that the campaign performance data have been exported successfully'),
   email_preferences('every_occurrence__sys'),
   referenced_component('Object.campaign__v'),
   subject('Campaign Performance Have Been Exported Successfully - ${Custom.campaign_name}'),
   notification('Your campaign performance data have been exported successfully<br/>
    Details:<br/>
    <ul>
       <li>Campaign Name: ${Custom.campaign_name}</li>
       <li>Successes: ${Custom.success_count}</li>
       <li>Job Start Time: ${Custom.start_time}</li>
       <li>Job Duration: ${Custom.duration}</li>
       <li>${Custom.file_type} File: <a href=${uiBaseExtUrl}/proxy/jobs/${Custom.job_id}/sdk/${Custom.hyphenated_campaign_name}_CampaignPerformance_${Custom.job_id}.${Custom.file_extension}?ttl=7>${Custom.hyphenated_campaign_name}_CampaignPerformance_${Custom.job_id}.${Custom.file_extension}</a></li>
    </ul>'),
   email_body('Your campaign performance data have been exported successfully<br/>
    Details:<br/>
    <ul>
       <li>Campaign Name: ${Custom.campaign_name}</li>
       <li>Successes: ${Custom.success_count}</li>
       <li>Job Start Time: ${Custom.start_time}</li>
       <li>Job Duration: ${Custom.duration}</li>
       <li>${Custom.file_type} File: <a href=${uiBaseExtUrl}/?campaign-name=${Custom.hyphenated_campaign_name}&job-id=${Custom.job_id}&file-extension=${Custom.file_extension}&tab-collection=campaign_manager__v#app/page/campaigns?ui-tab=${Custom.tab_id}>${Custom.hyphenated_campaign_name}_CampaignPerformance_${Custom.job_id}.${Custom.file_extension}</a></li>
    </ul>'),
   entity_type('object'),
   notification_category('none__sys')
);