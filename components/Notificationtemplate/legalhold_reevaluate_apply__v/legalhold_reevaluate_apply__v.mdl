RECREATE Notificationtemplate legalhold_reevaluate_apply__v (
   label('legalHoldReevaluateSuccess_b'),
   active(true),
   description(),
   email_preferences('summary__sys'),
   referenced_component(),
   subject('Notification: Legal hold notification'),
   notification('<p>Legal hold ${legalHoldObjectLink} successfully re-evaluated to ${appliedDocumentCount} documents.</p>
'),
   email_body('<p><b>Change Summary:</b></p>
<p>
    <ul>
        <li>Legal hold "${legalHoldName}" re-evaluated to ${appliedDocumentCount} documents</li>
    </ul>
</p>'),
   entity_type('object'),
   notification_category('none__sys')
);