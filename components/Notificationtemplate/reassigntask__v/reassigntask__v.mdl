RECREATE Notificationtemplate reassigntask__v (
   label('reassignTask'),
   active(true),
   description(),
   email_preferences('every_occurrence__sys'),
   referenced_component(),
   subject('Task reassigned'),
   notification('Task ${taskName} for ${docName} has been reassigned.
'),
   email_body('The following task has been reassigned:

<p>${taskName}</p>

<p>Document name: ${docName}<br>
Document owner: ${docOwnerName}<br> 
Workflow owner: ${workflowInitiatorName}<br></p>
'),
   entity_type('document'),
   notification_category('none__sys')
);