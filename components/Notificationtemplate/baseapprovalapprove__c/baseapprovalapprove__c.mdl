RECREATE Notificationtemplate baseapprovalapprove__c (
   label('BASE-Approval-Approve'),
   active(true),
   description(),
   email_preferences('every_occurrence__sys'),
   referenced_component(),
   subject('New Task: Approve or Reject "${docNameNoLink}"'),
   notification('The above referenced document has been sent for your approval.'),
   email_body('You have been assigned a task for <b>${docName}</b>. ${notificationMessage}</p> Due date: ${taskDueDate}<br> Document owner: ${docOwnerName}<br> Workflow owner: ${workflowInitiatorName}<br> <p>You can see all of your tasks on your Vault home page under <a href="${taskHome}">Tasks</a>.</p>'),
   entity_type('document'),
   notification_category('none__sys')
);