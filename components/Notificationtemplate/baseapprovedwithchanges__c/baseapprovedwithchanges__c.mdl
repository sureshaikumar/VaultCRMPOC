RECREATE Notificationtemplate baseapprovedwithchanges__c (
   label('BASE-approvedWithChanges'),
   active(true),
   description(),
   email_preferences('every_occurrence__sys'),
   referenced_component(),
   subject('Notification: "${docNameNoLink}" not approved, changes required'),
   notification('<b>${docName}</b> is not approved because additional changes are required. All approval comments have been captured as annotations on the document.'),
   email_body('<p>${notificationMessage}</p> <p>You can see all of your Notifications on your Vault home page under <a href="${notificationHome}">Notifications</a>.</p>'),
   entity_type('document'),
   notification_category('none__sys')
);