RECREATE Notificationtemplate pdfacreationfailure__v (
   label('pdfaCreationFailure_b'),
   active(true),
   description(),
   email_preferences('every_occurrence__sys'),
   referenced_component(),
   subject('PDF/A creation failed'),
   notification('Vault could not render a PDF/A compliant rendition for document <b>${docName}</b>.'),
   email_body('<p>${notificationMessage}</p>

<p>Vault could not generate a PDF/A compliant rendition. Please make sure your source file complies with PDF/A standard requirements and try to re-render the document. If PDF/A rendering fails again, please contact your system administrator or Vault Support.</p>
'),
   entity_type('document'),
   notification_category('none__sys')
);