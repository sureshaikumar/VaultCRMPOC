RECREATE Notificationtemplate cfgtool_export_vpk_error__v (
   label('ExportVPKError'),
   active(true),
   description('Export package error template'),
   email_preferences('every_occurrence__sys'),
   referenced_component(),
   subject('Your Outbound Package: ${packageName} has failed to export.'),
   notification('<b><p>Your Outbound Package: ${packageName} has failed to export.</p></b>
<br/>
<li> Reason for Failure : ${failureMessage} </li>
<li> Start Time: ${startTime} </li>
<li> Duration: ${duration} </li>'),
   email_body('<b><p>Your Outbound Package: ${packageName} has failed to export.</p></b>
<br/>
<li> Reason for Failure : ${failureMessage} </li>
<li> Start Time: ${startTime} </li>
<li> Duration: ${duration} </li>'),
   entity_type('document'),
   notification_category('none__sys')
);