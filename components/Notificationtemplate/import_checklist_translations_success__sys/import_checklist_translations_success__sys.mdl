RECREATE Notificationtemplate import_checklist_translations_success__sys (
   label('Import Checklist Translations Success'),
   active(true),
   description('Notification template notifying user that their checklist translations were successfully imported'),
   email_preferences('summary__sys'),
   referenced_component(),
   subject('Bulk Import of ${checklist_design__sys_label} Translations Completed'),
   notification('<p>Your ${checklist_design__sys_label} translations were successfully imported.<br></p><p>Results:<br>${numImported} translations successfully imported<br>${numIgnored} translations ignored because there was no change<br>${numErrored} translations not updated due to import errors<br>${numInserted} translations newly inserted</p>'),
   email_body('${notificationMessage}'),
   entity_type('object'),
   notification_category('none__sys')
);