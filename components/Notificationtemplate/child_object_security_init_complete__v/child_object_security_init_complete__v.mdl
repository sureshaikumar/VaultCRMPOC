RECREATE Notificationtemplate child_object_security_init_complete__v (
   label('Child Object Security Init Complete'),
   active(true),
   description('Child Object Security Initialization Complete Notification Template'),
   email_preferences('every_occurrence__sys'),
   referenced_component(),
   subject('Notification: Child Object security initialization complete.'),
   notification('
        <p>Your child object security initialization has completed.</p>
        <ul>
            <li>Child Object: ${Custom.childObject}</li>
            <li>Child Object field: ${Custom.childObjectField}</li>
            <li>Parent Object: ${Custom.parentObject}</li>
            <li>Records Updated: ${Custom.recordsUpdated}</li>
            <li>Start Time: ${startTime}</li>
            <li>Duration: ${Custom.taskDuration}</li>
        </ul>
   '),
   email_body('
        <p>Your child object security initialization has completed.</p>
        <ul>
            <li>Child Object: ${Custom.childObject}</li>
            <li>Child Object field: ${Custom.childObjectField}</li>
            <li>Parent Object: ${Custom.parentObject}</li>
            <li>Records Updated: ${Custom.recordsUpdated}</li>
            <li>Start Time: ${startTime}</li>
            <li>Duration: ${Custom.taskDuration}</li>
        </ul>
   '),
   entity_type('object'),
   notification_category('none__sys')
);