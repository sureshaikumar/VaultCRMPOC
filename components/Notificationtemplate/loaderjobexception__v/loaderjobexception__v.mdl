RECREATE Notificationtemplate loaderjobexception__v (
   label('loaderJobException'),
   active(true),
   description('Vault Loader Job Notification exception template'),
   email_preferences('summary__sys'),
   referenced_component(),
   subject('Notification: Loader Job partially completed'),
   notification('<p>Your Loader Job has Partially Failed</p>
<p>Details:
<ul>
<li>Reason for Failure: ${vaultLoaderFailureReason}</li>
<li> CSV File: <a href="${vaultLoaderFileLink}">${vaultLoaderFileName}</a></li>
<li>Action Type: ${vaultLoaderActionType}</li>
<li>Object Type: ${vaultLoaderObjectType}</li>
<li>Load Start Time: ${vaultLoaderStartTime} </li>
<li>Duration: ${vaultLoaderDuration} (${vaultLoaderRecordsPerSecond} records per second)</li>
<li>${vaultLoaderNumSuccesses}</li>
<li>${vaultLoaderNumFailures} </li>
</ul>'),
   email_body('${notificationMessage}'),
   entity_type('document'),
   notification_category('none__sys')
);