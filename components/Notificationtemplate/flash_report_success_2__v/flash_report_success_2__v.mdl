RECREATE Notificationtemplate flash_report_success_2__v (
   label('flashReportSuccess2'),
   active(true),
   description('Job notification success template for flash report execution'),
   email_preferences('every_occurrence__sys'),
   referenced_component(),
   subject('${flashReportSuccessSubject}'),
   notification('${flashReportSuccessNotification}
'),
   email_body('${flashReportSuccessEmail}
'),
   entity_type('document'),
   notification_category('none__sys')
);