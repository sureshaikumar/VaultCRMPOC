RECREATE Notificationtemplate vault_loader_extract_failure__v (
   label('Extract Job Failure'),
   active(true),
   description('Extract job failure template.'),
   email_preferences('summary__sys'),
   referenced_component(),
   subject('Notification: Loader Job has failed'),
   notification('
        <p>Your Loader Job has Failed</p>
        <p>Details:</p>
        <ul>
            <li>Reason for Failure: ${vaultLoaderFailureReason}</li>
            <li>Action Type: Extract</li>
            <li>Object Type: ${vaultLoaderObjectType}</li>
            <li>Settings: ${vaultLoaderSettings}</li>
            <li>Where Clause: ${vaultLoaderWhereClause}</li>
            <li>Load Start Time: ${vaultLoaderStartTime} </li>
        </ul>
   '),
   email_body('
        <p>Your Loader Job has Failed</p>
        <p>Details:</p>
        <ul>
            <li>Reason for Failure: ${vaultLoaderFailureReason}</li>
            <li>Action Type: Extract</li>
            <li>Object Type: ${vaultLoaderObjectType}</li>
            <li>Settings: ${vaultLoaderSettings}</li>
            <li>Where Clause: ${vaultLoaderWhereClause}</li>
            <li>Load Start Time: ${vaultLoaderStartTime} </li>
        </ul>
   '),
   entity_type('document'),
   notification_category('none__sys')
);