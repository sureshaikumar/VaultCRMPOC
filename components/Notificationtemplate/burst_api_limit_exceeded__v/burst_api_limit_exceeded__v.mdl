RECREATE Notificationtemplate burst_api_limit_exceeded__v (
   label('Burst API Limit Exceeded'),
   active(true),
   description(),
   email_preferences('every_occurrence__sys'),
   referenced_component(),
   subject('Attention: Burst API Limit Exceeded'),
   notification('<p>The vault has exceeded the burst limit of ${burstAPICount} API calls over the past 5 minutes and is no longer accepting API calls until the rolling 5 minute API count drops below the limit.</p>

<p>Please review the programs and scripts calling the Vault API to ensure they are operating correctly. The burst API count is the count of all API calls over the past 5 minutes and is constantly updated.</p>

<p>You are receiving this notification from Vault due to the API limit notification setting within Vault and the fact you have indicated you want to receive system notifications in your User Profile. Please contact Veeva support if you have any questions about this notification.</p>'),
   email_body('<p>The vault has exceeded the burst limit of ${burstAPICount} API calls over the past 5 minutes and is no longer accepting API calls until the rolling 5 minute API count drops below the limit.</p>

<p>Please review the programs and scripts calling the Vault API to ensure they are operating correctly. The burst API count is the count of all API calls over the past 5 minutes and is constantly updated.</p>

<p>You are receiving this notification from Vault due to the API limit notification setting within Vault and the fact you have indicated you want to receive system notifications in your User Profile. Please contact Veeva support if you have any questions about this notification.</p>'),
   entity_type('document'),
   notification_category('none__sys')
);