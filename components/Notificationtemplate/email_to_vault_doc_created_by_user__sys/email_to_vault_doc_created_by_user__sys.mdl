RECREATE Notificationtemplate email_to_vault_doc_created_by_user__sys (
   label('Email to Vault: Document Created by User'),
   active(true),
   description(),
   email_preferences('every_occurrence__sys'),
   referenced_component(),
   subject('A Vault document was successfully created from your email'),
   notification('Vault document ${docName} was successfully created from your email.'),
   email_body('${notificationMessage}'),
   entity_type('document'),
   notification_category('none__sys')
);