RECREATE Notificationtemplate extractjobcomplete__v (
   label('extractJobComplete'),
   active(true),
   description(),
   email_preferences('summary__sys'),
   referenced_component(),
   subject('Notification: Loader Job completed'),
   notification('<p>Your Loader Job has completed</p>
<p>Details:
<ul>
<li>Action Type: Extract</li>
<li>Object Type: ${vaultLoaderObjectType}</li>
<li>Settings: ${vaultLoaderSettings}</li>
<li>Where Clause: ${vaultLoaderWhereClause}</li>
<li>Load Start Time: ${vaultLoaderStartTime} </li>
<li>Duration: ${vaultLoaderDuration} (${vaultLoaderRecordsPerSecond} records per second)</li>
<li>${vaultLoaderNumSuccesses}</li>
</ul>
'),
   email_body('${notificationMessage}
'),
   entity_type('document'),
   notification_category('none__sys')
);