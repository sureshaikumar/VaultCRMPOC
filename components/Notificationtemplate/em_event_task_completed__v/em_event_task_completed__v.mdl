RECREATE Notificationtemplate em_event_task_completed__v (
   label('Event Task Completed'),
   active(true),
   description('Notification to the task Owner that the Assigned To user has completed his task.'),
   email_preferences('summary__sys'),
   referenced_component('Object.em_event_task__v'),
   subject('Task Completed: ${Object.name__v}'),
   notification('The task ${Object.name__v} has been completed'),
   email_body('The task ${Object.name__v} has been completed'),
   entity_type('object'),
   notification_category('none__sys')
);