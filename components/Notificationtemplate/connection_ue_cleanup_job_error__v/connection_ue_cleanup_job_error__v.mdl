RECREATE Notificationtemplate connection_ue_cleanup_job_error__v (
   label('User Exception Clean-up Job Errors'),
   active(false),
   description('Connection exception clean-up job failure email template.'),
   email_preferences('every_occurrence__sys'),
   referenced_component(),
   subject('Notification: Connection Exception Clean-up Job Errors'),
   notification('<p><b>Your connection exception clean-up job [${Custom.jobId}] has failed.</b><p>Details:<br/>Reason for Failure: ${Custom.cause}<br/>Start time: ${Custom.startTime}<br/>End time: ${Custom.endTime}<br/><br/> More Details <a href="${Custom.urlToErrorsListFile}">here</a></p></p>'),
   email_body('${notificationMessage}'),
   entity_type('object'),
   notification_category('none__sys')
);