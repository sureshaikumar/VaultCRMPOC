RECREATE Notificationtemplate vault_loader_extract_exception2__v (
   label('Extract Job Exception'),
   active(true),
   description('Extract job exception template.'),
   email_preferences('summary__sys'),
   referenced_component(),
   subject('Notification: Loader Job completed'),
   notification('<p>Your ${vaultLoaderLogFileLink} has Partially Failed</p><p>Details:</p><ul><li>Reason for Failure: ${vaultLoaderFailureReason}</li><li>Action Type: Extract</li><li>Entity Type: ${vaultLoaderObjectType}</li><li>Settings: ${vaultLoaderSettings}</li><li>Where Clause: ${vaultLoaderWhereClause}</li><li>Load Start Time: ${vaultLoaderStartTime} </li><li>Duration: ${vaultLoaderDuration} (${vaultLoaderRecordsPerSecond} records per second)</li><li>${vaultLoaderNumSuccesses}</li></ul>'),
   email_body('<p>Your Loader Job has Partially Failed</p><p>Details:</p><ul><li>Reason for Failure: ${vaultLoaderFailureReason}</li><li>Action Type: Extract</li><li>Entity Type: ${vaultLoaderObjectType}</li><li>Settings: ${vaultLoaderSettings}</li><li>Where Clause: ${vaultLoaderWhereClause}</li><li>Load Start Time: ${vaultLoaderStartTime} </li><li>Duration: ${vaultLoaderDuration} (${vaultLoaderRecordsPerSecond} records per second)</li><li>${vaultLoaderNumSuccesses}</li></ul>'),
   entity_type('document'),
   notification_category('none__sys')
);