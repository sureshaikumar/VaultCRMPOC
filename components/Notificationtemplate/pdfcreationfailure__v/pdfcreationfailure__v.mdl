RECREATE Notificationtemplate pdfcreationfailure__v (
   label('pdfCreationFailure'),
   active(true),
   description(),
   email_preferences('every_occurrence__sys'),
   referenced_component(),
   subject('Document PDF creation failed'),
   notification('PDF creation failed for document <b>${docName}</b>.'),
   email_body('<p>${notificationMessage}</p>

<p>Without a PDF rendition, you will not be able to view the content in-line or apply annotations. Dependent on your security settings, you can attempt to re-render the document. If rendering fails again, please contact your system administrator or Vault Support.</p>
'),
   entity_type('document'),
   notification_category('none__sys')
);