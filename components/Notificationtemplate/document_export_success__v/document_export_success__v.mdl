RECREATE Notificationtemplate document_export_success__v (
   label('Document export success notification'),
   active(true),
   description('Notification template notifying user after document export completed successfully.'),
   email_preferences('summary__sys'),
   referenced_component(),
   subject('Notification: document export completed.'),
   notification('<p>Document export is ready for download. Click on the link below to download the export file.</p> <p>${documentExportDownloadLink}</p> <p>This link will expire on ${documentExportExpirationDate}.</p> <br><b>Export Results</b> <br>Artifacts processed: ${docsProcessed} <br>Artifacts downloaded: ${docsDownloaded}.'),
   email_body('<p>Document export is ready for download. Click on the link below to download the export file.</p> <p>${documentExportDownloadLink}</p> <p>This link will expire on ${documentExportExpirationDate}.</p> <br> <b>Export Results</b> <br>Artifacts processed: ${docsProcessed} <br>Artifacts downloaded: ${docsDownloaded}.<p>You can see all your Notifications on your Vault home page under <a href="${notificationHome}">Notifications</a>.</p>'),
   entity_type('document'),
   notification_category('none__sys')
);