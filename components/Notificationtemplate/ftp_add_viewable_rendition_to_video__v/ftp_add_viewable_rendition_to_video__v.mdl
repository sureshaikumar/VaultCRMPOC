RECREATE Notificationtemplate ftp_add_viewable_rendition_to_video__v (
   label('Cannot Attach Viewable Rendition to Video'),
   active(true),
   description(),
   email_preferences('every_occurrence__sys'),
   referenced_component(),
   subject('Invalid rendition - "${fileName}" not uploaded to "${docNameNoLink}"'),
   notification('Error uploading "${fileName}" to "${docLatestName}". You cannot upload viewable renditions for video documents.'),
   email_body('<b>Vault: </b>${vaultName}
<br><b>File: </b>"${fileName}".
<p>There was an error uploading "${fileName}" to "${docLatestName}". You cannot upload viewable renditions for video documents because these are generated by the system.</p>'),
   entity_type('document'),
   notification_category('none__sys')
);