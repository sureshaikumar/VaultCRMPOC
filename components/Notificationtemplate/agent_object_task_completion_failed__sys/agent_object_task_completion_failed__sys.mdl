RECREATE Notificationtemplate agent_object_task_completion_failed__sys (
   label('Agent Workflow Task Completion Failure'),
   active(true),
   description('Notification sent to the workflow owner when an agent fails to complete a workflow task.'),
   email_preferences('every_occurrence__sys'),
   referenced_component(),
   subject('Agent task: ${taskName} completion failure'),
   notification('
       <p>An error was encountered when the task was submitted by: ${agentLabel}</p>
       <p>Workflow: ${workflowLabel}</p>
       <p>Task: ${taskName}</p>
       <p>Object Record: ${Object.name__v}</p>

       <p>Reason: Error on task completion submission</p>

       <p>${errorDetails}</p>
   '),
   email_body('${notificationMessage}'),
   entity_type('object'),
   notification_category('none__sys')
);