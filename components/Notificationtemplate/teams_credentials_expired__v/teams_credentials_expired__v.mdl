RECREATE Notificationtemplate teams_credentials_expired__v (
   label('Teams Credentials Expired'),
   active(true),
   description('This notification is sent if the Microsoft credentials associated to the owner of a Collaboration Space Configuration record expire.'),
   email_preferences('every_occurrence__sys'),
   referenced_component('Object.collaboration_space_configuration__v'),
   subject('Teams Credentials Expired'),
   notification('The credentials for the Collaboration Space Configuration "${Custom.collaboration_space_config_name}" have expired. Please update the credentials in Vault CRM: <a href=${Custom.link_to_record}>Link to Record</a>'),
   email_body('${notificationMessage}'),
   entity_type('object'),
   notification_category('none__sys')
);