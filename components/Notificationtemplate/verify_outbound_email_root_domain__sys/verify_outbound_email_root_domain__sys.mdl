RECREATE Notificationtemplate verify_outbound_email_root_domain__sys (
   label('Verify Outbound Email Root Domain'),
   active(true),
   description('Notification template informing user that they are to verify the root domain for use by outbound email domains'),
   email_preferences('every_occurrence__sys'),
   referenced_component(),
   subject('Verify Outbound Email Root Domain for ${vaultName}'),
   notification('<p>A Veeva Vault admin provided your email address to confirm the use of this domain for outbound email. <a href="${verificationLink}">Click here to confirm.</a></p>'),
   email_body('${notificationMessage}'),
   entity_type('custom'),
   notification_category('none__sys')
);