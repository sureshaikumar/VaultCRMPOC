RECREATE Notificationtemplate vault_compare_report_warning__v (
   label('Compare Report Warning'),
   active(true),
   description('Compare Components Job Notification warning template'),
   email_preferences('every_occurrence__sys'),
   referenced_component(),
   subject('Your Vault Comparison has completed with warning'),
   notification('<b>Your <a href="${urlExport}">Vault Comparison</a> has completed with warning</b><br><br><ul><li>Source Vault: ${sourceVaultName} (${sourceVaultId})</li><li>Target Vault: ${targetVaultName} (${targetVaultId})</li><li>Results Type: ${resultsType}</li><li>Details Type: ${detailsType}</li><li>Include Documents & Binder Templates: ${includeDocsAndBinderTemplates}</li><li>Include Vault Settings: ${includeVaultSettings}</li><li>Component Types: ${componentTypes}</li><li>Generate Outbound Packages: ${generateOutboundPackages}</li><span style="${outboundPackagesDisplayStyle}"><li>Outbound Packages: ${outboundPackagesMessage}</li></span><li>Start Time: ${startTime}</li><li>Duration: ${duration}</li><li>Components compared: ${comparedCount}</li></ul><a href="${urlExport}">Download report</a> | <a href="${urlErrorExport}">Download error log</a>'),
   email_body('<b>Your Vault Comparison has completed with warning</b> <br><br>Details:<ul><li>Source Vault: ${sourceVaultName} (${sourceVaultId})</li><li>Target Vault: ${targetVaultName} (${targetVaultId})</li><li>Results Type: ${resultsType}</li><li>Details Type: ${detailsType}</li><li>Include Documents & Binder Templates: ${includeDocsAndBinderTemplates}</li><li>Include Vault Settings: ${includeVaultSettings}</li><li>Component Types: ${componentTypes}</li><li>Generate Outbound Packages: ${generateOutboundPackages}</li><span style="${outboundPackagesDisplayStyle}"><li>Outbound Packages: ${outboundPackagesMessage}</li></span><li>Start Time: ${startTime}</li><li>Duration: ${duration}</li><li>Components compared: ${comparedCount}</li></ul><a href="${urlExport}">Download report</a> | <a href="${urlErrorExport}">Download error log</a>'),
   entity_type('document'),
   notification_category('none__sys')
);