RECREATE Notificationtemplate basereviewcompletereview__c (
   label('BASE-Review-CompleteReview'),
   active(true),
   description(),
   email_preferences('every_occurrence__sys'),
   referenced_component(),
   subject('New Task: Assess Review Outcome for "${docNameNoLink}"'),
   notification('Please review all comments for the above referenced document and determine if it is ready for formal approval, or if significant changes are required and it should be returned to the owner. All comments can be viewed from the document information page.'),
   email_body('You have been assigned a task for <b>${docName}</b>. ${notificationMessage}</p> Due date: ${taskDueDate}<br> Document owner: ${docOwnerName}<br> Workflow owner: ${workflowInitiatorName}<br> <p>You can see all of your tasks on your Vault home page under <a href="${taskHome}">Tasks</a>.</p>'),
   entity_type('document'),
   notification_category('tasks__sys')
);