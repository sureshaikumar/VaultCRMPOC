RECREATE Notificationtemplate signature_page_generation_success__sys (
   label('Signature Page Generation Success'),
   active(true),
   description('Notification template notifying user that the signature page creation has succeeded.'),
   email_preferences('summary__sys'),
   referenced_component(),
   subject('Notification: Signature Page Creation Succeeded'),
   notification('<p>Signature Page for <b><a href=${docInfoUrl}>${docName}</a></b> created successfully.</p>'),
   email_body('<p>Signature Page for <b><a href=${docInfoUrl}>${docName}</a></b> created successfully.</p>'),
   entity_type('document'),
   notification_category('none__sys')
);