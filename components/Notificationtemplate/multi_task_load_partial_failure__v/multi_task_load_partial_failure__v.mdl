RECREATE Notificationtemplate multi_task_load_partial_failure__v (
   label('MultiTaskLoadPartialFailure'),
   active(true),
   description('MultiTask load job partial failure template'),
   email_preferences('summary__sys'),
   referenced_component(),
   subject('Loader load job has partially completed'),
   notification('<p>Your Loader load job ${job_id} has partially completed. Details and result files can be retrieved from the Job Status page: <a href="${jobStatusPageLink}">${jobStatusPageLinkText} </a></p>'),
   email_body('${notificationMessage}'),
   entity_type('document'),
   notification_category('none__sys')
);