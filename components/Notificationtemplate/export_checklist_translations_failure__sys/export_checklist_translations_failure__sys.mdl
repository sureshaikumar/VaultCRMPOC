RECREATE Notificationtemplate export_checklist_translations_failure__sys (
   label('Export Checklist Translations Failure'),
   active(true),
   description('Notification template notifying user that their checklist translations export failed'),
   email_preferences('every_occurrence__sys'),
   referenced_component(),
   subject('Bulk Export of ${checklist_design__sys_label} Translations Failed'),
   notification('<p>Your ${checklist_design__sys_label} translations export attempt has failed. Errors were encountered during processing.<br><br><a href="${urlChecklistHelp}">Learn more</a> about bulk exporting translations.</p>'),
   email_body('${notificationMessage}'),
   entity_type('object'),
   notification_category('none__sys')
);