RECREATE Notificationtemplate process_view_execution_success__sys (
   label('Process View Execution Success'),
   active(true),
   description('Notification template notifying user process view execution has completed successfully.'),
   email_preferences('never__sys'),
   referenced_component(),
   subject('Your Process Monitor Run has completed for ${processLabel}'),
   notification('<p>Your Process Monitor Run has completed for ${processLabel}: <a href="${processViewResultUrl}">${processViewLinkSummary}</a></p>'),
   email_body('${notificationMessage}'),
   entity_type('object'),
   notification_category('none__sys')
);