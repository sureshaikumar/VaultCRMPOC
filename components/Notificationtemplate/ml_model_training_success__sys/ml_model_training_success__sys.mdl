RECREATE Notificationtemplate ml_model_training_success__sys (
   label('Model Training Success'),
   active(true),
   description(),
   email_preferences('every_occurrence__sys'),
   referenced_component('Object.trained_model__sys'),
   subject('Model Training for the Trained Model ''${Object.name__v}'' has completed successfully.'),
   notification('<p>Model Training for the Trained Model ''${Object.name__v}'' has completed successfully.</p><p>Please review the Performance Metrics and the additional Trained Model Artifacts on the Trained Model record.</p>'),
   email_body('<p>${notificationMessage}</p> <p>Please <a href="${uiBaseExtUrl}">login to Vault</a> to view all of your tasks and notifications.</p>'),
   entity_type('object'),
   notification_category('none__sys')
);