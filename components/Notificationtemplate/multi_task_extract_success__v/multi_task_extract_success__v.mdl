RECREATE Notificationtemplate multi_task_extract_success__v (
   label('MultiTaskExtractSuccess'),
   active(true),
   description('MultiTask extract job success template'),
   email_preferences('summary__sys'),
   referenced_component(),
   subject('Loader extract job completed'),
   notification('<p>Your Loader extract job ${job_id} has completed. Result files can be retrieved from the Job Status page: <a href="${jobStatusPageLink}">${jobStatusPageLinkText} </a></p>'),
   email_body('${notificationMessage}'),
   entity_type('document'),
   notification_category('none__sys')
);