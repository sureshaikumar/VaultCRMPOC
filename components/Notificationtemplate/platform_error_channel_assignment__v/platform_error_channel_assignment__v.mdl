RECREATE Notificationtemplate platform_error_channel_assignment__v (
   label('Channel Assignment Platform Error'),
   active(true),
   description('Notifies the user when an Email Channel Assignment encounters a platform error'),
   email_preferences('every_occurrence__sys'),
   referenced_component('Object.channel_assignment__v'),
   subject('Error: Email Inbox Platform Service Error'),
   notification('An email inbox error has occurred. <br/>Details:<br/><ul><li>Email Inbox Name: ${Object.name__v}</li><li>Status Message: Lost connection to Vault CRM Platform service. Contact Veeva support for assistance.</li><li>Modified Date: ${Object.modified_date__v}</li></ul>'),
   email_body('An email inbox error has occurred. <br/>Details:<br/><ul><li>Email Inbox Name: ${Object.name__v}</li><li>Status Message: Lost connection to Vault CRM Platform service. Contact Veeva support for assistance.</li><li>Modified Date: ${Object.modified_date__v}</li></ul>'),
   entity_type('object'),
   notification_category('none__sys')
);