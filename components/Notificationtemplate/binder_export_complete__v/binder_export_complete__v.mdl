RECREATE Notificationtemplate binder_export_complete__v (
   label('Binder export success notification'),
   active(true),
   description('Notification template notifying user after binder export completed successfully.'),
   email_preferences('summary__sys'),
   referenced_component(),
   subject('Notification: ${docNameNoLink}  binder export completed.'),
   notification('<p>Binder export for ${docName} is ready for download. Click on the link below to download the export file.</p> <p>${binderExportDownloadLink}</p> <p>This link will expire on ${binderExportExpirationDate}.</p><br> <b>Export Results</b> <br>Artifacts processed: ${binderDocsProcessed} <br>Artifacts downloaded: ${binderDocsDownloaded}.'),
   email_body('<p>Binder export for ${docName} is ready for download. Click on the link below to download the export file.</p> <p>${binderExportDownloadLink}</p> <p>This link will expire on ${binderExportExpirationDate}.</p> <br><b>Export Results</b> <br>Artifacts processed: ${binderDocsProcessed} <br>Artifacts downloaded: ${binderDocsDownloaded}.'),
   entity_type('document'),
   notification_category('none__sys')
);