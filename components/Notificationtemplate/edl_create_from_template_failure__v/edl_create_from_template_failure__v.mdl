RECREATE Notificationtemplate edl_create_from_template_failure__v (
   label('EDL Create from Template Failure Notification'),
   active(true),
   description(),
   email_preferences('every_occurrence__sys'),
   referenced_component(),
   subject('Notification: Create EDL from Template Terminated Unexpectedly

'),
   notification('<p> Your Create EDL from Template job has terminated unexpectedly </p>
<p> Details </p>
<ul>
<li> <li> EDL Create from Template for EDL - ${objectName} - &quot;${recordName}&quot; ended unexpectedly. Some records were copied but not all records in the hierarchy were copied <br>
${objectHierarchy} </li>
<li> Start Time: ${startTime} </li>
<li> Duration : ${duration} </li>
<li> ${failureCountLink} </li>
<li> ${successCountLink} </li>
</ul>
'),
   email_body('${notificationMessage}
'),
   entity_type('document'),
   notification_category('none__sys')
);