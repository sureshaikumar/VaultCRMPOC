RECREATE Notificationtemplate emailparticipants__v (
   label('EmailParticipants'),
   active(true),
   description(),
   email_preferences('every_occurrence__sys'),
   referenced_component(),
   subject('Note regarding ${taskName}'),
   notification('<p>${senderName} has sent you a note regarding the task: ${taskName} on the following document: <br>
${docLatestName}.</p>

<p>${personalizedMessage}</p>'),
   email_body('<p>${notificationMessage}</p>'),
   entity_type('document'),
   notification_category('none__sys')
);