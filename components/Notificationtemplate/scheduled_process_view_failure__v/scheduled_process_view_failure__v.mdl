RECREATE Notificationtemplate scheduled_process_view_failure__v (
   label('Scheduled Process View Failure'),
   active(true),
   description('Notification template for a failed scheduled Process View run.'),
   email_preferences('every_occurrence__sys'),
   referenced_component(),
   subject('Process View Scheduled Run Failure'),
   notification('<p>Your scheduled run for <a href="${processViewViewerUrl}">${processViewLabelHtml}</a> has failed. Please run it manually and correct any errors.</p>'),
   email_body('<p>Your scheduled run for <a href="${processViewViewerUrl}">${processViewLabelHtml}</a> has failed. Please run it manually and correct any errors.</p>'),
   entity_type('document'),
   notification_category('none__sys')
);