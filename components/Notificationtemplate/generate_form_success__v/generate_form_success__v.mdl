RECREATE Notificationtemplate generate_form_success__v (
   label('Generate Form Success'),
   active(true),
   description(),
   email_preferences('every_occurrence__sys'),
   referenced_component(),
   subject('Notification: Form Generation Complete'),
   notification('Generating form ${docName} succeeded.

<p>
    Warnings:
    <ul>
        ${generateFormWarnings}
    </ul>
</p>'),
   email_body('<p>${recipientTitle} ${recipientName},</p>

<p><b>Vault: </b>${vaultName}

<p>${notificationMessage}</p>

<p>Access your Vault here: <a href="${uiBaseExtUrl}">${vaultName}</a></p>'),
   entity_type('document'),
   notification_category('none__sys')
);