Vsmvalue zmw__v (
   label('ZMW'),
   active(true),
   description('Used for transactions denominated in the Zambian Kwacha, the official currency of Zambia introduced in 2013 as a redenomination of the old kwacha.'),
   synonyms('Zambian kwacha',
         'new kwacha',
         'ZMW'),
   target('zmw__sys'),
   target_label('ZMW')
);