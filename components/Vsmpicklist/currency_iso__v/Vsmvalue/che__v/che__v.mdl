Vsmvalue che__v (
   label('CHE'),
   active(true),
   description('Use when recording monetary amounts in the WIR Euro, a complementary currency used by the Swiss WIR Bank alongside the Swiss Franc.'),
   synonyms('WIR Euro',
         'Swiss WIR Euro',
         'CHE complementary currency'),
   target('che__sys'),
   target_label('CHE')
);