Vsmvalue iep__v (
   label('IEP'),
   active(true),
   description('The Irish Pound (IEP), the former official currency of Ireland prior to the adoption of the Euro in 2002, used for historical or legacy financial records.'),
   synonyms('Irish pound',
         'Irish punt',
         'Ireland legacy currency'),
   target('iep__sys'),
   target_label('IEP')
);