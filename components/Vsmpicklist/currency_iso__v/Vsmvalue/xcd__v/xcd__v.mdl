Vsmvalue xcd__v (
   label('XCD'),
   active(true),
   description('Used for transactions denominated in the East Caribbean Dollar, the official currency shared by members of the Eastern Caribbean Currency Union including Antigua, Dominica, Grenada, and Saint Lucia.'),
   synonyms('East Caribbean dollar',
         'OECS currency',
         'EC dollar'),
   target('xcd__sys'),
   target_label('XCD')
);