RECREATE Doctype slide__v (
   label('Slide'),
   description('These documents represent individual Slides and are stored within the Presentation binders.'),
   active(true),
   document_number_format('Slide-{#####}'),
   document_name_format(),
   regen_doc_name_on_save(),
   available_lifecycles('crm_content_lifecycle__v'),
   allow_attachments(),
   crosslink('source_file_and_rendition__sys'),
   auto_bring_forward_annotations(),
   auto_bring_forward_annotation_types(),
   binder_unbound_document_display_option(),
   enable_binder_thumbnail(),
   rendition_types('veeva_distribution_package__v',
      'distribution_package__v'),
   create_document_permissions(),
   create_binder_permissions(),
   role_defaulting_editors(),
   role_defaulting_viewers(),
   role_defaulting_consumers(),
   relationship_types('related_shared_resource__v',
      'related_sub_presentation__v'),
   milestone_types(),
   processes(),
   etmf_department(),
   default_workflows(),
   inherit_doctype_groups(false),
   doctype_group('Content Alignment Sharing'),
   etmf_rm_v2(),
   etmf_rm_v3(),
   clinical_docs_rm(),
   filters(),
   fields('Docfield.rendition_md5__v',
      'Docfield.product_family__v',
      'Docfield.source_vault_dns__v',
      'Docfield.media_file_crc__v',
      'Docfield.content_group__v',
      'Docfield.country__v',
      'Docfield.source_vault_document_id__v',
      'Docfield.detail_product__v',
      'Docfield.custom_reaction__v',
      'Docfield.cdn_processing_status__v',
      'Docfield.source_vault_last_modified__v',
      'Docfield.disable_actions__v',
      'Docfield.mobile_id__v',
      'Docfield.url__v',
      'Docfield.detail_group__v',
      'Docfield.segment__v',
      'Docfield.legacy_crm_id__v',
      'Docfield.source_vault_guid__v',
      'Docfield.brand__v',
      'Docfield.cdn_status__v',
      'Docfield.media_file_size__v',
      'Docfield.vexternal_id__v',
      'Docfield.media_file_name__v',
      'Docfield.clm_id__v',
      'Docfield.media_type__v',
      'Docfield.keyword__v',
      'Docfield.rendition_transfer_status__v',
      'Docfield.cdn_path__v',
      'Docfield.media_type_extension__v',
      'Docfield.ios_resolution__v',
      'Docfield.source_vault_document_version__v',
      'Docfield.source_vault_external_id__v',
      'Docfield.indication__v',
      'Docfield.target_platform__v',
      'Docfield.product_group__v')
);