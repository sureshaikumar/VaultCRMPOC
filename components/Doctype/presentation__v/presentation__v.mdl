RECREATE Doctype presentation__v (
   label('Presentation'),
   description('These binder documents represent the Presentation, which contains one or more Slide documents.'),
   active(true),
   document_number_format('Presentation-{#####}'),
   document_name_format(),
   regen_doc_name_on_save(),
   available_lifecycles('crm_content_lifecycle__v'),
   allow_attachments(),
   crosslink(),
   auto_bring_forward_annotations(),
   auto_bring_forward_annotation_types(),
   binder_unbound_document_display_option(),
   enable_binder_thumbnail(),
   rendition_types(),
   create_document_permissions(),
   create_binder_permissions(),
   role_defaulting_editors(),
   role_defaulting_viewers(),
   role_defaulting_consumers(),
   relationship_types(),
   milestone_types(),
   processes(),
   etmf_department(),
   default_workflows(),
   inherit_doctype_groups(false),
   doctype_group('Content Alignment Sharing'),
   etmf_rm_v2(),
   etmf_rm_v3(),
   clinical_docs_rm(),
   filters(),
   fields('Docfield.product_family__v',
      'Docfield.source_vault_dns__v',
      'Docfield.end_date__v',
      'Docfield.content_group__v',
      'Docfield.country__v',
      'Docfield.source_vault_document_id__v',
      'Docfield.share_as_engage_link__v',
      'Docfield.directory__v',
      'Docfield.detail_product__v',
      'Docfield.source_vault_last_modified__v',
      'Docfield.mobile_id__v',
      'Docfield.detail_group__v',
      'Docfield.legacy_crm_id__v',
      'Docfield.source_vault_guid__v',
      'Docfield.brand__v',
      'Docfield.legacy_ipad_content_mode__v',
      'Docfield.allow_pdf_download__v',
      'Docfield.allow_remote_clm__v',
      'Docfield.vexternal_id__v',
      'Docfield.hidden__v',
      'Docfield.keyword__v',
      'Docfield.external_display_name__v',
      'Docfield.allow_source_download__v',
      'Docfield.presentation_id__v',
      'Docfield.total_slides__v',
      'Docfield.message_template__v',
      'Docfield.enable_survey_overlay__v',
      'Docfield.source_vault_document_version__v',
      'Docfield.source_vault_external_id__v',
      'Docfield.training__v',
      'Docfield.survey__v',
      'Docfield.indication__v',
      'Docfield.presentation_type__v',
      'Docfield.start_date__v',
      'Docfield.product_group__v')
