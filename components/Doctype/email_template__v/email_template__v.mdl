RECREATE Doctype email_template__v (
   label('Email Template'),
   description('An Email Template is the main container for all the components within an Approved Email.'),
   active(true),
   document_number_format('ET-{####}'),
   document_name_format(),
   regen_doc_name_on_save(),
   available_lifecycles('crm_content_lifecycle__v'),
   allow_attachments(),
