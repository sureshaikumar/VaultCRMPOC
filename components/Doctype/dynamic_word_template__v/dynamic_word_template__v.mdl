RECREATE Doctype dynamic_word_template__v (
   label('Dynamic Word Template'),
   description('Word templates containing merge fields mapped to tokens, enabling dynamic personalization when content is shared through CRM channels.'),
   active(true),
   document_number_format('DWT-{#####}'),
   document_name_format(),
   regen_doc_name_on_save(),
   available_lifecycles('crm_content_lifecycle__v'),
   allow_attachments(),
   crosslink(),
   auto_bring_forward_annotations(),
   auto_bring_forward_annotation_types(),
   binder_unbound_document_display_option(),
   enable_binder_thumbnail(),
   rendition_types('veeva_distribution_package__v'),
   create_document_permissions(),
   create_binder_permissions(),
   role_defaulting_editors(),
   role_defaulting_viewers(),
   role_defaulting_consumers(),
   relationship_types(),
   milestone_types(),
   processes(),
   etmf_department(),
   default_workflows(),
   inherit_doctype_groups(false),
   doctype_group('Content Alignment Sharing'),
   etmf_rm_v2(),
   etmf_rm_v3(),
   clinical_docs_rm(),
   filters(),
   fields('Docfield.product_family__v',
      'Docfield.end_date__v',
      'Docfield.media_file_crc__v',
      'Docfield.content_group__v',
      'Docfield.country__v',
      'Docfield.from_fax_number__v',
      'Docfield.detail_product__v',
      'Docfield.content_processing_status__v',
      'Docfield.cdn_processing_status__v',
      'Docfield.detail_group__v',
      'Docfield.content_type__v',
      'Docfield.brand__v',
      'Docfield.cdn_status__v',
      'Docfield.display_fax_header_page_numbers__v',
      'Docfield.page_count__v',
      'Docfield.vexternal_id__v',
      'Docfield.dynamic_word_template_type__v',
      'Docfield.rendition_transfer_status__v',
      'Docfield.cdn_path__v',
      'Docfield.content_processing_error__v',
      'Docfield.consent_required_for_sending__v',
      'Docfield.publish_for_veeva_crm_fax__v',
      'Docfield.allow_attachments_in_patient_crm__v',
      'Docfield.indication__v',
      'Docfield.start_date__v',
      'Docfield.fax_header_text__v',
      'Docfield.product_group__v')
);