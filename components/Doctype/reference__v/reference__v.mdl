RECREATE Doctype reference__v (
   label('Reference'),
   description('Documents used by Knowledge Base'),
   active(true),
   document_number_format('REF-{####}'),
   document_name_format(),
   regen_doc_name_on_save(),
   available_lifecycles('general_lifecycle__c'),
   allow_attachments(),
   crosslink(),
   auto_bring_forward_annotations(),
   auto_bring_forward_annotation_types(),
   binder_unbound_document_display_option(),
   enable_binder_thumbnail(),
   rendition_types(),
   create_document_permissions('group:Group.vault_owners__v'),
   create_binder_permissions(),
   role_defaulting_editors('group:Group.vault_owners__v'),
   role_defaulting_viewers(),
   role_defaulting_consumers(),
   relationship_types(),
   milestone_types(),
   processes(),
   etmf_department(),
   default_workflows(),
   inherit_doctype_groups(true),
   doctype_group(),
   etmf_rm_v2(),
   etmf_rm_v3(),
   clinical_docs_rm(),
   filters(),
   fields('Docfield.country__v',
      'Docfield.detail_product__v')
);