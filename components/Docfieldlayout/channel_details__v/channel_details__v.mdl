RECREATE Docfieldlayout channel_details__v (
   label('Channel Details'),
   active(true),
   icon('UNDEFINED'),
   order(9),
   fields('Docfield.allow_attachments_in_patient_crm__v',
      'Docfield.consent_required_for_sending__v',
      'Docfield.content_processing_error__v',
      'Docfield.content_processing_status__v',
