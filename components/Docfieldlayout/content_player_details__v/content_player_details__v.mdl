   label('Content Player Details'),
   active(true),
   icon('UNDEFINED'),
   order(10),
   fields('Docfield.custom_reaction__v',
      'Docfield.disable_actions__v',
      'Docfield.ios_resolution__v',
      'Docfield.legacy_ipad_content_mode__v'),
   show_in_edit_mode(true),
