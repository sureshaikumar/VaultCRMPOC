RECREATE Docfieldlayout product_information__v (
   label('Product Information'),
   active(true),
   icon('UNDEFINED'),
   order(2),
   fields('Docfield.brand__v',
      'Docfield.detail_group__v',
      'Docfield.detail_product__v',
      'Docfield.indication__v',
      'Docfield.product_family__v',
      'Docfield.product_group__v'),
   show_in_edit_mode(true),
   allow_field_assignment(true),
   panel('Documentpanel.doc_info_information__sys')
);