RECREATE Docfieldlayout engage_details__v (
   label('Engage Details'),
   active(true),
   icon('UNDEFINED'),
   order(12),
   fields('Docfield.allow_remote_clm__v',
      'Docfield.share_as_engage_link__v',
      'Docfield.message_template__v',
      'Docfield.allow_pdf_download__v',
      'Docfield.allow_source_download__v'),
   show_in_edit_mode(true),
   allow_field_assignment(true),
   panel('Documentpanel.doc_info_information__sys')
);