RECREATE Docfieldlayout file_info__v (
   label('File Info'),
   active(true),
   icon('UNDEFINED'),
   order(1),
   fields('Docfield.filename__v',
      'Docfield.size__v',
      'Docfield.format__v',
      'Docfield.file_created_by__v',
      'Docfield.file_created_date__v',
