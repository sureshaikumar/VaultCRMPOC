      'Docfield.file_meta_duration__v',
      'Docfield.file_meta_orientation__v',
      'Docfield.file_meta_color_space__v',
      'Docfield.file_meta_image_size__v',
      'Docfield.file_meta_video_codecs__v',
      'Docfield.file_meta_resolution__v',
