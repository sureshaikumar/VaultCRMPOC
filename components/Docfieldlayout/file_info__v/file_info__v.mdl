      'Docfield.file_meta_alpha_channel__v',
      'Docfield.file_meta_red_eye__v',
      'Docfield.file_meta_component_configuration__v',
      'Docfield.file_meta_ycbcr_positioning__v',
      'Docfield.file_meta_encoding_process__v',
