RECREATE Docfieldlayout email_fields__v (
   label('Email Fields'),
   active(true),
   icon('UNDEFINED'),
   order(25),
   fields('Docfield.email_from_address__v',
      'Docfield.email_from_name__v',
      'Docfield.email_replyto_address__v',
      'Docfield.email_replyto_name__v',
      'Docfield.email_subject__v',
      'Docfield.email_domain__v',
      'Docfield.bcc__v'),
   show_in_edit_mode(true),
   allow_field_assignment(true),
   panel('Documentpanel.doc_info_information__sys')
);