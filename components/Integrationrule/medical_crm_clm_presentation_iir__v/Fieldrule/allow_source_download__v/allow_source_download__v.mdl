Fieldrule allow_source_download__v (
   label('Allow Source Download?'),
   active(true),
   query_object('document_allow_source_download__vr'),
   query_field('name__v'),
   target_object(),
   target_object_field(),
   target_docfield('Docfield.allow_source_download__v'),
   reference_lookup_type(),
   reference_lookup(),
   field_default(),
   query_field_select('(SELECT name__v FROM document_allow_source_download__vr)'),
   query_field_type('vobject_text__sys'),
   target_field_lookup()
);