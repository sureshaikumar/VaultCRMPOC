RECREATE Integrationrule promomats_crm_product_family_iir__v (
   label('Product Family Inbound Integration Rule'),
   active(true),
   connection('promomats_crm__v'),
   integration_point('promomats_crm_product_family_iip__v'),
   primary_query_object('product_family__v'),
   Fieldrule(@Fieldrule/abbreviation__v.mdl),
   Fieldrule(@Fieldrule/deleted_in_source__v.mdl),
   Fieldrule(@Fieldrule/generic_name__v.mdl),
   Fieldrule(@Fieldrule/link__v.mdl),
   Fieldrule(@Fieldrule/name__v.mdl),
   Fieldrule(@Fieldrule/original_source_id__v.mdl),
   Fieldrule(@Fieldrule/product_category__v.mdl),
   Fieldrule(@Fieldrule/scientific_name__v.mdl),
   Fieldrule(@Fieldrule/source_status__v.mdl),
   Fieldrule(@Fieldrule/therapeutic_area__v.mdl)
);