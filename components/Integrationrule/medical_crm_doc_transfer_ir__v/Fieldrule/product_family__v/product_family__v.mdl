Fieldrule product_family__v (
   label('Product Family'),
   active(true),
   query_object('document_product__vr'),
   query_field('name__v'),
   target_object(),
   target_object_field(),
   target_docfield('Docfield.product_family__v'),
   reference_lookup_type(),
   reference_lookup(),
   field_default(),
   query_field_select('(SELECT name__v FROM document_product__vr)'),
   query_field_type('vobject_text__sys'),
   target_field_lookup()
);