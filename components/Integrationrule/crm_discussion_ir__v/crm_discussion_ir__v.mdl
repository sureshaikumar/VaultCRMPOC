RECREATE Integrationrule crm_discussion_ir__v (
   label('CRM Discussion Integration Rule'),
   active(true),
   connection('clinops_crm__v'),
   integration_point('discussion_to_discussion_iip__v'),
   primary_query_object('crm_discussion__v'),
   Fieldrule(@Fieldrule/interaction__v.mdl),
   Fieldrule(@Fieldrule/link__v.mdl),
   Fieldrule(@Fieldrule/status__v.mdl),
   Fieldrule(@Fieldrule/study_country__v.mdl),
   Fieldrule(@Fieldrule/vault_clinical_site__v.mdl),
   Fieldrule(@Fieldrule/vault_clinical_study__v.mdl)
);