RECREATE Integrationrule medical_inquiry_ir__v (
   label('Medical Inquiry Integration Rule'),
   active(true),
   connection('medical_crm__v'),
   integration_point('medical_inquiry_iip__v'),
   primary_query_object('case_request__v'),
   Fieldrule(@Fieldrule/global_id__v.mdl),
   Fieldrule(@Fieldrule/link__v.mdl),
   Fieldrule(@Fieldrule/medinquiry_request_name__v.mdl),
   Fieldrule(@Fieldrule/medinquiry_transfer_status__v.mdl),
   Queryobjectrule(@Queryobjectrule/case_request__v.mdl)
);