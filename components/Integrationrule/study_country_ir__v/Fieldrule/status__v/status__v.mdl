Fieldrule status__v (
   label('Status'),
   active(true),
   query_object('study_country__v'),
   query_field('status__v'),
   target_object('Object.vault_clinical_study_country__v'),
   target_object_field('Field.status__v'),
   target_docfield(),
   reference_lookup_type('picklist'),
   reference_lookup('default_status__v'),
   field_default(),
   query_field_select(),
   query_field_type('vobject_picklist__sys'),
   target_field_lookup()
);