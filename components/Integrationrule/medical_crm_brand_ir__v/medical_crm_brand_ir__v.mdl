RECREATE Integrationrule medical_crm_brand_ir__v (
   label('Brand Integration Rule'),
   active(true),
   connection('medical_crm__v'),
   integration_point('medical_crm_brand_iip__v'),
   primary_query_object('local_product__v'),
   Fieldrule(@Fieldrule/deleted_in_source__v.mdl),
   Fieldrule(@Fieldrule/link__v.mdl),
   Fieldrule(@Fieldrule/name__v.mdl),
   Fieldrule(@Fieldrule/product_family__v.mdl),
   Fieldrule(@Fieldrule/product_type__v.mdl),
   Fieldrule(@Fieldrule/source_status__v.mdl),
   Fieldrule(@Fieldrule/vexternal_id__v.mdl)
);