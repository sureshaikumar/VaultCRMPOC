RECREATE Objectvalidation em_business_rule__v.min_max_travel_distance_expense_range__v (
   label('Max Distance more than Min Distance'),
   active(true),
   expression('
        object_type__vr.api_name__v != "expense_estimate_speaker_travel_rule__v" ||
        IsBlank(minimum_travel_distance__v) || IsBlank(maximum_travel_distance__v) || maximum_travel_distance__v >= minimum_travel_distance__v'),
   description('Maximum Distance more than Minimum Distance.'),
   error_message('Maximum Distance must be larger than Minimum Distance.'),
   error_location('maximum_travel_distance__v')
);