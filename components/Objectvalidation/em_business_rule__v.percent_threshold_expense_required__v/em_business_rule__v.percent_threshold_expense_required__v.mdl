RECREATE Objectvalidation em_business_rule__v.percent_threshold_expense_required__v (
   label('Percent Threshold Required'),
   active(true),
   expression('
        Case(object_type__vr.api_name__v,
            "em_actual_versus_estimate_expense_thr__v", true,
            false
        ) = false || Not(IsBlank(percent_threshold__v))'),
   description('Percent Threshold Required'),
   error_message('This field is required.'),
   error_location('percent_threshold__v')
);