RECREATE Objectvalidation em_business_rule_configuration__v.cost_estimate_required__v (
   label('Cost Required'),
   active(true),
   expression('
        Case(event_business_rule_type__vr.api_name__v,
            "expense_estimate_av_equipment_rule__v", true,
            "expense_estimate_flat_fee_rule__v", true,
            "expense_estimate_meal_rule__v", true,
            "expense_estimate_speaker_lodging_rule__v", true,
            "expense_estimate_speaker_travel_rule__v", true,
            false
        ) = false || Not(IsBlank(cost__v))'),
   description('Valid input for cost__v is not added.'),
   error_message('This field is required.'),
   error_location('cost__v')
);