RECREATE Objectvalidation contract__v.end_date_after_start_date__v (
   label('End Date After Start Date'),
   active(true),
   expression('start_date__v <= end_date__v'),
   description('End Date must be later than Start Date.'),
   error_message('The End Date cannot be before the Start Date.'),
   error_location('end_date__v')
);