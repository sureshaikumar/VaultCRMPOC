RECREATE Objectvalidation em_business_rule_configuration__v.limit_quantity_speaker_set__v (
   label('Cannot add Limit Quantity'),
   active(true),
   expression('
        Case(event_business_rule_type__vr.api_name__v,
            "em_cross_event_per_speaker_engagement__v", true,
            "em_per_event_speaker_limit_rule__v", true,
            false
        ) = false || IsBlank(limit_quantity__v)'),
   description('limit_quantity__v added to Event Business Rule.'),
   error_message('Cannot add Limit Quantity for this rule.'),
   error_location('limit_quantity__v')
);