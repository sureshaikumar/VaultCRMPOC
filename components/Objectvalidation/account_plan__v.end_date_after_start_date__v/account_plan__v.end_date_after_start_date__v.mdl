RECREATE Objectvalidation account_plan__v.end_date_after_start_date__v (
   label('EndDateAfterStartDate'),
   active(true),
   expression('If(Not(IsBlank(start_date__v)) && Not(IsBlank(end_date__v)), start_date__v < end_date__v, true)'),
   description('Start Date cannot be greater than or equal to the End Date.'),
   error_message('Start Date cannot be greater than or equal to the End Date.'),
   error_location('start_date__v',
      'end_date__v')
);