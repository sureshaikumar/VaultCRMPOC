RECREATE Objectvalidation samples_state_credential_settings__v.allowedschedules_collabrelations__v (
   label('Allowed Schedules No CollabRelationships'),
   active(true),
   expression('collaborative_relationship_required__v != true || IsBlank(allowed_schedules__v)'),
   description('Allowed Schedules and Collaborative Relationships cannot be defined in the same record. If collaborative_relationship_required__v = true and allowed_schedules__v is not blank, display an error.'),
   error_message('Cannot define Allowed Schedules and Collaborative Relationships in the same record'),
   error_location('allowed_schedules__v',
      'collaborative_relationship_required__v')
);