RECREATE Objectvalidation em_business_rule__v.expense_rolling_period_set__v (
   label('Date Threshold not Rolling'),
   active(true),
   expression('
        Case(object_type__vr.api_name__v,
            "em_attendee_expense_cap_rule__v", true,
            "em_cross_event_attendee_expense_cap_r__v", true,
            false
        ) = false || date_threshold_type__v = "rolling__v" || IsBlank(rolling_period__v)'),
   description('Date Threshold Type Required'),
   error_message('This field is required.'),
   error_location('date_threshold_type__v')
);