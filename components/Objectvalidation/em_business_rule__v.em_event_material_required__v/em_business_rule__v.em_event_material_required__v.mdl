RECREATE Objectvalidation em_business_rule__v.em_event_material_required__v (
   label('Event Material Required'),
   active(true),
   expression('object_type__vr.api_name__v != "em_required_event_material_rule__v" || Not(IsBlank(em_event_material__v))'),
   description('Valid input for em_event_material__v is not added to the Material Rule.'),
   error_message('This field is required.'),
   error_location('em_event_material__v')
);