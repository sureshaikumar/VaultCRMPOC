RECREATE Objectvalidation pricing_rule__v.free_goods_rule__v (
   label('Free Goods Rule'),
   active(true),
   expression('Not(
     If(
         And(
             IsBlank(free_goods__v),
             IsBlank(free_goods_percentage__v)
         ),
         Not(IsBlank(free_goods_max__v)),
         And(
             Not(IsBlank(free_goods_max__v)),
             Not(IsBlank(free_goods__v)),
             free_goods_max__v < free_goods__v
        )
    )
)'),
   description('Free Good Max is lower than Free Good. If Free Good Max is not blank, then either Free Goods or Free Good Percent must be populated'),
   error_message('Free Good Max is lower than Free Good. If Free Good Max is not blank, then either Free Goods or Free Good Percent must be populated'),
   error_location('free_goods_max__v')
);