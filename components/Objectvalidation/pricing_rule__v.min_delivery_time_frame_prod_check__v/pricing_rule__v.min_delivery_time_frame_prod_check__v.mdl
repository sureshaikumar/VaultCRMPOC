RECREATE Objectvalidation pricing_rule__v.min_delivery_time_frame_prod_check__v (
   label('Min Delivery Time Frame Prod Check'),
   active(true),
   expression('Not(
     And(
         Not(IsBlank(min_delivery_time_frame__v)),
         min_delivery_time_frame__v > 0,
         Not(IsBlank(product__v))
    )
)'),
   description('If Min Delivery Timeframe is populated, Product must be empty'),
   error_message('If Min Delivery Timeframe is populated, Product must be empty'),
   error_location('product__v')
);