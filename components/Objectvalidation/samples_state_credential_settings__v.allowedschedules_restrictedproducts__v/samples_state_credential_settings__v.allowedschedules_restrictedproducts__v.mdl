RECREATE Objectvalidation samples_state_credential_settings__v.allowedschedules_restrictedproducts__v (
   label('Allowed Schedules Restricted Products'),
   active(true),
   expression('IsBlank(allowed_schedules__v) || IsBlank(restricted_products__v)'),
   description('Allowed Schedules and Restricted Products cannot be defined in the same record. If allowed_schedules__v is not blank and restricted_products__v is not blank, display an error.'),
   error_message('Cannot define Allowed Schedules and Restricted Products in the same record'),
   error_location('allowed_schedules__v',
      'restricted_products__v')
);