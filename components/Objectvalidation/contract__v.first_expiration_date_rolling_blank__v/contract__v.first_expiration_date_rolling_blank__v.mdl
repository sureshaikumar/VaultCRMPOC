RECREATE Objectvalidation contract__v.first_expiration_date_rolling_blank__v (
   label('1st Exp Date Must be Blank For Rolling'),
   active(true),
   expression('Not((object_type__vr.api_name__v=''series_contract__v'')&&(period_type__v=''rolling__v'')&&(Not(IsBlank(first_expiration_date__v))))'),
   description('First Expiration Date cannot contain a value for Rolling Period Type.'),
   error_message('First Expiration Date cannot contain a value for Rolling Period Type.'),
   error_location('first_expiration_date__v')
);