RECREATE Objectvalidation medical_event__v.start_time_before_end_time__v (
   label('StartTimeBeforeEndTime'),
   active(true),
   expression('If(Not(IsBlank(start_time__v)) && Not(IsBlank(end_time__v)), start_time__v <= end_time__v, true)'),
   description('End time must be equal or greater than start time.'),
   error_message('End time must be equal or greater than start time.'),
   error_location('start_time__v',
      'end_time__v')
);