RECREATE Objectvalidation mc_cycle_plan_channel__v.team_max_validations__v (
   label('Team_Max_Validations'),
   active(true),
   expression('Or(IsBlank(team_channel_activity_max__v),IsBlank(team_channel_activity_goal__v),team_channel_activity_max__v >= team_channel_activity_goal__v)'),
   description('team_channel_activity_max__v cannot be less than team_channel_activity_goal__v'),
   error_message('Team Channel Activity Max cannot be less than Team Channel Activity Goal.'),
   error_location('team_channel_activity_max__v')
);