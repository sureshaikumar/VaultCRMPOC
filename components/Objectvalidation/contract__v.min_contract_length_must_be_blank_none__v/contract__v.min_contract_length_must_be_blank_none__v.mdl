RECREATE Objectvalidation contract__v.min_contract_length_must_be_blank_none__v (
   label('Min Contract Length Blank for None'),
   active(true),
   expression('Not((object_type__vr.api_name__v=''series_contract__v'')&&(IsBlank(period_type__v))&&(Not(IsBlank(minimum_contract_length__v))))'),
   description('Minimum Contract Length cannot contain a value for a Period Type of "None".'),
   error_message('Minimum Contract Length cannot contain a value for a Period Type of "None".'),
   error_location('minimum_contract_length__v')
);