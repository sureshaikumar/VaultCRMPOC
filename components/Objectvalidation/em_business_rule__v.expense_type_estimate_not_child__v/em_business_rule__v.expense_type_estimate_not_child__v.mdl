RECREATE Objectvalidation em_business_rule__v.expense_type_estimate_not_child__v (
   label('Expense Type Cannot Have a Parent'),
   active(true),
   expression('
        Case(object_type__vr.api_name__v,
            "expense_estimate_av_equipment_rule__v", true,
            "expense_estimate_flat_fee_rule__v", true,
            "expense_estimate_meal_rule__v", true,
            "expense_estimate_speaker_lodging_rule__v", true,
            "expense_estimate_speaker_travel_rule__v", true,
            "expense_estimate_speaker_rate_rule__v", true,
            false
        ) = false || IsBlank(expense_type__vr.parent_expense_type__v)'),
   description('expense_type__v has a parent.'),
   error_message('The Expense Type cannot have a Parent Expense Type. Please select a valid expense type to save.'),
   error_location('expense_type__v')
);