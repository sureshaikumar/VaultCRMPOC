RECREATE Objectvalidation pricing_rule__v.free_good_type_check__v (
   label('Free Good Type Check'),
   active(true),
   expression('Not(
     And(
          Or(
               object_type__vr.api_name__v = ''free_goods_rule__v'',
               object_type__vr.api_name__v = ''free_goods_percentage_rule__v''
          ),
          Not(
               Or(
                    product__vr.product_type__v = ''order__v'',
                    product__vr.product_type__v = ''kit_item__v''
               )
          )
     )
)'),
   description('For Free Goods and Free Goods Percentage Rules, only product type of ''Order'' and ''Kit Item'' is allowed'),
   error_message('For Free Goods and Free Goods Percentage Rules, only product type of ''Order'' and ''Kit Item'' is allowed'),
   error_location('product__v')
);