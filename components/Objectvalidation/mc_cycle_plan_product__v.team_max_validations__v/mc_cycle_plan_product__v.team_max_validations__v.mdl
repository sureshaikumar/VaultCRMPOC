RECREATE Objectvalidation mc_cycle_plan_product__v.team_max_validations__v (
   label('Team_Max_Validations'),
   active(true),
   expression('Or(IsBlank(team_product_activity_max__v),IsBlank(team_product_activity_goal__v),team_product_activity_max__v >= team_product_activity_goal__v)'),
   description('team_product_activity_max__v cannot be less than team_product_activity_goal__v'),
   error_message('Team Product Activity Max cannot be less than Team Product Activity Goal.'),
   error_location('team_product_activity_max__v')
);