RECREATE Objectvalidation samples_state_credential_settings__v.allowedschedules_nocountry__v (
   label('Allowed Schedules No Country'),
   active(true),
   expression('If(not(IsBlank(allowed_schedules__v)), IsBlank(country__v), true)'),
   description('Allowed Schedules is limited to states, and cannot be defined for a Country. If allowed_schedules__v is not blank and country__v is not blank, display an error.'),
   error_message('Cannot define Allowed Schedules for a Country'),
   error_location('allowed_schedules__v',
      'country__v')
);