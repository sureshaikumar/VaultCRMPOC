RECREATE Objectvalidation order_campaign__v.end_date_after_start_date__v (
   label('End Date After Start Date'),
   active(true),
   expression('Not(
    If(
        And(
            Not(IsBlank(start_date__v)),
            Not(IsBlank(end_date__v))
        ),
        start_date__v > end_date__v,
        false
    )
)'),
   description(),
   error_message('Start date after end date'),
   error_location('start_date__v')
);