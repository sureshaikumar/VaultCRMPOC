RECREATE Objectvalidation em_business_rule_configuration__v.end_date_after_start_date__v (
   label('End Date After Start Date'),
   active(true),
   expression('rule_start_date__v <= rule_end_date__v'),
   description('Rule End Date is earlier than Rule Start Date.'),
   error_message('The End Date must be later than the Start Date.'),
   error_location('rule_end_date__v')
);