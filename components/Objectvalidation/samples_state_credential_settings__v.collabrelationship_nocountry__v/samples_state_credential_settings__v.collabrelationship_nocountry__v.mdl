RECREATE Objectvalidation samples_state_credential_settings__v.collabrelationship_nocountry__v (
   label('Collab Relationship No Country'),
   active(true),
   expression('collaborative_relationship_required__v != true || IsBlank(country__v)'),
   description('Collaborative Relationships are limited to states, and cannot be defined for a Country. If collaborative_relationship_required__v = true and country__v is not blank, display an error.'),
   error_message('Cannot define Collaborative Relationships for a Country'),
   error_location('collaborative_relationship_required__v',
      'country__v')
);