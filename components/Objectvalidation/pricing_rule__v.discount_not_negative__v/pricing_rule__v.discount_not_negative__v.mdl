RECREATE Objectvalidation pricing_rule__v.discount_not_negative__v (
   label('Discount Not Negative'),
   active(true),
   expression('Not(
     And(
         Not(IsBlank(discount_override__v)),
         discount_override__v < 0
    )
)'),
   description('Discount Override cannot be negative'),
   error_message('Discount may not be negative'),
   error_location('discount_override__v')
);