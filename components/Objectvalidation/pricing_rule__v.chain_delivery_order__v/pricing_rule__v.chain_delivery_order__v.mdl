RECREATE Objectvalidation pricing_rule__v.chain_delivery_order__v (
   label('Chain Delivery Order'),
   active(true),
   expression('Not(
     And(
        chain_rule__v = true,
        delivery_order__v = true
    )
)'),
   description('Chain Rule cannot be Delivery Order'),
   error_message('Chain Rule cannot be Delivery Order'),
   error_location('delivery_order__v')
);