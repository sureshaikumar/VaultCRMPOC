RECREATE Objectvalidation em_catalog__v.event_registration_agreement_policy__v (
   label('Event Registration Agreement Policy'),
   active(true),
   expression('isBlank(event_registration_agreement_policy__v) || (FileSize(event_registration_agreement_policy__v) < 10000000 && Contains("application/pdf",MimeType(event_registration_agreement_policy__v)))'),
   description('Restricts the event registration agreement policy file size and type when uploaded.'),
   error_message('Event registration agreement policy file size must be less than 10 MB and one of the following types: .pdf'),
   error_location('event_registration_agreement_policy__v')
);