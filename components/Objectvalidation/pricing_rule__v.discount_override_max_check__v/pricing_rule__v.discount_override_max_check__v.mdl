RECREATE Objectvalidation pricing_rule__v.discount_override_max_check__v (
   label('Discount Override Max Check'),
   active(true),
   expression('Not(
     And(
         Not(IsBlank(discount_override_max__v)),
         IsBlank(discount_override__v)
    )
)'),
   description('Discount Override Max cannot be populated without Discount Override'),
   error_message('Discount Override Max cannot be populated without Discount Override'),
   error_location('discount_override_max__v')
);