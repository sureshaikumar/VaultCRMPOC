RECREATE Objectvalidation em_event_rule__v.automated_emails__v.invalid_timing_value_days__v (
   label('Invalid Timing Value - Days'),
   active(true),
   expression('timing_measure__v != Picklist.em_event_rule_timing_measure__v.days__v || (timing_value__v >= 0 && timing_value__v <= 365)'),
   description('Error message displayed when invalid timing value is configured by the day'),
   error_message('Only timing values between 0 - 365 allowed for days measurement.'),
   error_location('timing_value__v')
);