RECREATE Objectvalidation samples_state_credential_settings__v.collabrelationship_restrictedproducts__v (
   label('Collab Relationship Restricted Products'),
   active(true),
   expression('collaborative_relationship_required__v != true || IsBlank(restricted_products__v)'),
   description('Collaborative Relationships and Restricted Products cannot be defined in the same record. If collaborative_relationship_required__v = true and restricted_products__v is not blank, display an error.'),
   error_message('Cannot define Collaborative Relationships and Restricted Products in the same record'),
   error_location('collaborative_relationship_required__v',
      'restricted_products__v')
);