RECREATE Objectvalidation samples_state_credential_settings__v.state_or_country__v (
   label('State or Country'),
   active(true),
   expression('If(IsBlank(state_province__v), Not(IsBlank(country__v)), IsBlank(country__v))'),
   description('State and Country restrictions cannot be defined in the same record. If state__v and country__v are both populated, display an error. A State or a Country must be defined for the record. If neither state__v nor country__v is populated, display an error.'),
   error_message('A record can only be created for a state or a country'),
   error_location('state_province__v',
      'country__v')
);