RECREATE Objectvalidation pricing_rule__v.discount_rule_product_type_check__v (
   label('Discount Rule Product Type Check'),
   active(true),
   expression('Not(
     And(
         object_type__vr.api_name__v = ''discount_rule__v'',
         Not(
             Or(
                 product__vr.product_type__v = ''order__v'',
                 product__vr.product_type__v = ''kit_item__v'',
                 IsBlank(product__v)
            )
        )
    )
)'),
   description('For Discount Rule, Product can be empty or of type ''Order'' and ''Kit Item'''),
   error_message('For Discount Rule, Product can be empty or of type ''Order'' and ''Kit Item'''),
   error_location('product__v')
);