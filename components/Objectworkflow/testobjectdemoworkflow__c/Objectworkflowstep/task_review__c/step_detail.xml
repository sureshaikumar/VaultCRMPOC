<?xml version="1.0" encoding="UTF-8"?>
<vwf:stepdetails xmlns:vwf="VeevaVault">
  <vwf:dialog type="task">
    <vwf:label>Task review</vwf:label>
    <vwf:hideHomePageLink>false</vwf:hideHomePageLink>
    <vwf:controls>
      <vwf:control name="this_task_is_to_review_and_assign__c" label="This task is to review and assign." type="instructions">
        <vwf:instructions>This task is to review and assign.</vwf:instructions>
      </vwf:control>
      <vwf:control name="verdict_public_key__c" type="verdict">
        <vwf:verdict label="Reviewed" name="verdict_reviewed__c" />
        <vwf:verdict label="Required more info" name="verdict_required_more_info__c">
          <vwf:comment label="Enter your comments" required="true" />
        </vwf:verdict>
      </vwf:control>
      <vwf:control name="workflow_creation_date__v" label="label" type="date">
        <vwf:datefield type="date" />
        <vwf:offset>
          <vwf:amount>9</vwf:amount>
          <vwf:unit>days</vwf:unit>
        </vwf:offset>
      </vwf:control>
    </vwf:controls>
  </vwf:dialog>
  <vwf:assignment participant="part_reviewer_to_review_task__c" excludeowner="false" />
  <vwf:assignmentType type="any" />
  <vwf:notifications />
  <vwf:reminders />
  <vwf:completeWithoutViewing value="false" />
  <vwf:taskRequirement requirement="required" />
</vwf:stepdetails>