<?xml version="1.0" encoding="UTF-8"?>
<vwf:stepdetails xmlns:vwf="VeevaVault">
  <vwf:dialog type="task">
    <vwf:label>Review Task</vwf:label>
    <vwf:hideHomePageLink>false</vwf:hideHomePageLink>
    <vwf:controls>
      <vwf:control name="this_task_is_to_assign_and_completed__c" label="This task is to assign and completed." type="instructions">
        <vwf:instructions>This task is to assign and completed.</vwf:instructions>
      </vwf:control>
      <vwf:control name="verdict_public_key__c" type="verdict">
        <vwf:verdict label="Reviewed" name="verdict_reviewed__c" />
        <vwf:verdict label="Required More Info" name="verdict_required_more_info__c">
          <vwf:comment label="Comments" required="true" />
        </vwf:verdict>
      </vwf:control>
      <vwf:control name="workflow_creation_date__v" label="label" type="date">
        <vwf:datefield type="date" />
        <vwf:offset>
          <vwf:amount>5</vwf:amount>
          <vwf:unit>days</vwf:unit>
        </vwf:offset>
      </vwf:control>
    </vwf:controls>
  </vwf:dialog>
  <vwf:assignment participant="part_reviewer__c" excludeowner="false" />
  <vwf:assignmentType type="every" />
  <vwf:notifications />
  <vwf:reminders />
  <vwf:completeWithoutViewing value="true" />
  <vwf:taskRequirement requirement="required" />
</vwf:stepdetails>