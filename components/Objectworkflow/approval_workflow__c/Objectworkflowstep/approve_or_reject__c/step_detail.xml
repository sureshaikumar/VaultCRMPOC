<?xml version="1.0" encoding="UTF-8"?>
<vwf:stepdetails xmlns:vwf="VeevaVault">
  <vwf:dialog type="task">
    <vwf:label>Approve or Reject</vwf:label>
    <vwf:hideHomePageLink>false</vwf:hideHomePageLink>
    <vwf:controls>
      <vwf:control name="to_complete_this_task_please_approve_or__c" label="To complete this task, please approve or reject &quot;$\{docName\}&quot;, indicating your functional capacity and providing your electronic signature as appropriate." type="instructions">
        <vwf:instructions>To complete this task, please approve or reject "$\{docName\}", indicating your functional capacity and providing your electronic signature as appropriate.</vwf:instructions>
      </vwf:control>
      <vwf:control name="verdict_public_key__c" type="verdict">
        <vwf:verdict label="Approved" name="verdict_approved__c">
          <vwf:esig name="esig_0__c">
            <vwf:manifestSignature value="false" />
          </vwf:esig>
          <vwf:capacities label="Capacity" required="true">
            <vwf:capacity name="capacity_0_0__c" label="Commercial" />
            <vwf:capacity name="capacity_0_1__c" label="General" />
            <vwf:capacity name="capacity_0_2__c" label="Legal" />
            <vwf:capacity name="capacity_0_3__c" label="Medical" />
            <vwf:capacity name="capacity_0_4__c" label="Regulatory" />
          </vwf:capacities>
        </vwf:verdict>
        <vwf:verdict label="Not Approved" name="verdict_not_approved__c">
          <vwf:capacities label="Capacity" required="true">
            <vwf:capacity name="capacity_1_0__c" label="Commercial" />
            <vwf:capacity name="capacity_1_1__c" label="General" />
            <vwf:capacity name="capacity_1_2__c" label="Legal" />
            <vwf:capacity name="capacity_1_3__c" label="Medical" />
            <vwf:capacity name="capacity_1_4__c" label="Regulatory" />
          </vwf:capacities>
        </vwf:verdict>
      </vwf:control>
      <vwf:control name="date_approval_due_date__c" label="label" type="date">
        <vwf:datefield type="date" />
        <vwf:offset>
          <vwf:amount>0</vwf:amount>
          <vwf:unit>days</vwf:unit>
        </vwf:offset>
      </vwf:control>
    </vwf:controls>
  </vwf:dialog>
  <vwf:assignment participant="part_approver__c" excludeowner="false" />
  <vwf:assignmentType type="every" />
  <vwf:updateSharingSettingsRules>
    <vwf:rule event="taskAssignment" operator="add">
      <vwf:roles>
        <vwf:role>Doclifecyclerole.approver__v</vwf:role>
      </vwf:roles>
    </vwf:rule>
  </vwf:updateSharingSettingsRules>
  <vwf:notifications />
  <vwf:reminders />
  <vwf:completeWithoutViewing value="false" />
  <vwf:taskRequirement requirement="required" />
  <vwf:enablePromptExclusionStateTypes value="false" />
  <vwf:enablePromptInclusionDocTypes value="false" />
</vwf:stepdetails>