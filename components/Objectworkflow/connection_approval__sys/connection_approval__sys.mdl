RECREATE Objectworkflow connection_approval__sys (
   label('Connection Approval'),
   active(true),
   object_lifecycles('Objectlifecycle.connection_lifecycle__sys'),
   document_content_lifecycle(),
   record_content_lifecycle(),
   description(),
   auto_start(false),
   envelope_name_format(),
   cancellation_comment(false),
   workflow_variables(),
   workflow_content_type('Object'),
   class(),
   cardinality('One'),
   show_fields(),
   bound_create_draft(),
   users_can_only_complete_one_task(false),
   roles_cannot_complete_task(),
   disallowed_workflow_owner_actions(),
   disallowed_non_task_owner_actions(),
   disallowed_actions(),
   Objectworkflowstep(@Objectworkflowstep/change_to_approved_state__sys.mdl),
   Objectworkflowstep(@Objectworkflowstep/change_to_rejected_state__sys.mdl),
   Objectworkflowstep(@Objectworkflowstep/decision__sys.mdl),
   Objectworkflowstep(@Objectworkflowstep/end__sys.mdl),
   Objectworkflowstep(@Objectworkflowstep/start__sys.mdl),
   Objectworkflowstep(@Objectworkflowstep/task__sys.mdl)
);