RECREATE Objectworkflow inventory_order_approval_workflow__v (
   label('Inventory Order Approval Workflow'),
   active(true),
   object_lifecycles('Objectlifecycle.inventory_order_lifecycle__v'),
   document_content_lifecycle(),
   record_content_lifecycle(),
   description('Approval workflow for Inventory Orders when the allocation associated with the ordered products requires approval for order submission.'),
   auto_start(true),
   envelope_name_format(),
   cancellation_comment(false),
   workflow_variables(),
   workflow_content_type('Object'),
   class(),
   cardinality('One'),
   show_fields(),
   bound_create_draft(),
   users_can_only_complete_one_task(false),
   roles_cannot_complete_task(),
   disallowed_workflow_owner_actions(),
   disallowed_non_task_owner_actions(),
   disallowed_actions(),
   Objectworkflowstep(@Objectworkflowstep/approve_or_reject__v.mdl),
   Objectworkflowstep(@Objectworkflowstep/change_state_to_saved__v.mdl),
   Objectworkflowstep(@Objectworkflowstep/change_state_to_submitted__v.mdl),
   Objectworkflowstep(@Objectworkflowstep/decision__v.mdl),
   Objectworkflowstep(@Objectworkflowstep/end__v.mdl),
   Objectworkflowstep(@Objectworkflowstep/notification_approved__v.mdl),
   Objectworkflowstep(@Objectworkflowstep/notification_rejected__v.mdl),
   Objectworkflowstep(@Objectworkflowstep/start__v.mdl)
);