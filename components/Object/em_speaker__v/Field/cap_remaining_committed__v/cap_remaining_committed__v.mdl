Field cap_remaining_committed__v (
   label('Cap Remaining Committed'),
   type('Number'),
   subtype('Currency'),
   active(true),
   description(),
   required(false),
   unique(false),
   max_value(100000000000000000),
   min_value(-100000000000000000),
   scale(6),
   help_content('Displays the speaker cap balance minus actuals and upcoming committed costs'),
   list_column(false),
   order(45),
   formula('annual_cap__v - (upcoming_committed_costs__v+year_to_date_spend__v)'),
   no_copy(true),
   lookup_relationship_name(),
   lookup_source_field(),
   encrypted(false),
   editable(false),
   currency_type('local'),
   enhanced_blank_handling('blanks_as_zeros_and_empty_strings'),
   rollup(false),
   control_binding()
);