Field product_display__v (
   label('Product Display'),
   type('String'),
   active(true),
   description('Product_Display_vod is formula field used as a display field concatenating the Detail_Group_vod and Product_vod fields if they are populated in this manner: ''Detail Product | Detail Group''.'),
   required(false),
   unique(false),
   max_length(1500),
   help_content(),
   list_column(false),
   order(73),
   formula('If(Not(IsBlank(Id(product__v))),  If(Not(IsBlank(Id(detail_group__v))), product__vr.name__v&" | "&detail_group__vr.name__v, product__vr.name__v),  If(Not(IsBlank(Id(detail_group__v))), detail_group__vr.name__v,""))'),
   no_copy(true),
   lookup_relationship_name(),
   lookup_source_field(),
   encrypted(false),
   editable(false),
   format_mask(),
   enhanced_blank_handling('blanks_as_zeros_and_empty_strings'),
   control_binding()
);