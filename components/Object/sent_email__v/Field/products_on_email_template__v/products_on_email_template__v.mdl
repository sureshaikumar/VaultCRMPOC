Field products_on_email_template__v (
   label('Products on Email Template'),
   type('String'),
   active(true),
   description('The products on the Email Template Document when it was sent. These values are stored as the names of the products in a semicolon delimited list. If detail groups are used, they are stored as a | delimited pair with the detail product.'),
