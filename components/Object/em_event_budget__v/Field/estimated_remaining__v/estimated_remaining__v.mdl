Field estimated_remaining__v (
   label('Estimated Remaining'),
   type('Number'),
   subtype('Currency'),
   active(true),
   description('The amount available in the budget being accessed by the event.'),
   required(false),
   unique(false),
   max_value(100000000000000000),
   min_value(-100000000000000000),
   scale(6),
   help_content(),
   list_column(false),
   order(22),
   formula('((budget__vr.total_budget__v - budget__vr.estimated_expenses__v) / BlankValue(budget__vr.local_currency__sysr.rate__sys, BlankValue(@User.preferred_currency__sysr.rate__sys, 1))) * BlankValue(local_currency__sysr.rate__sys, BlankValue(@User.preferred_currency__sysr.rate__sys, 1))'),
   no_copy(true),
   lookup_relationship_name(),
   lookup_source_field(),
   encrypted(false),
   editable(false),
   currency_type('local'),
   enhanced_blank_handling('blanks_as_zeros_and_empty_strings'),
   rollup(false),
   control_binding()
);