Field opt_expiration_date__v (
   label('Expiration Date'),
   type('Date'),
   active(true),
   description('Opt_Expiration_Date_vod is used to identify a current/live Opt record. If the Opt Expiration date is > the current date, then the record is considered live. This applies to both Opt-In and Opt-Out records.'),
