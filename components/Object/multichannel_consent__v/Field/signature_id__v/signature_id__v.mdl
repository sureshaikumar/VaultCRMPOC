   unique(false),
   max_length(50),
   help_content(),
   list_column(false),
   order(31),
   no_copy(false),
   lookup_relationship_name(),
   lookup_source_field(),
   encrypted(false),
   editable(true),
   format_mask(),
   control_binding()
);