Field language__v (
   label('Language'),
   type('String'),
   active(true),
   description(),
   required(false),
   unique(false),
   max_length(1500),
   help_content(),
   list_column(false),
   order(18),
   formula('Text(If(Not(IsBlank(email_template_document__v)), email_template_document__vr.language__v, If(Not(IsBlank(approved_document__v)), approved_document__vr.language__v, message_template__vr.language__v)))'),
   no_copy(true),
   lookup_relationship_name(),
   lookup_source_field(),
   encrypted(false),
   editable(false),
   format_mask(),
   enhanced_blank_handling('blanks_as_zeros_and_empty_strings'),
   control_binding()
);