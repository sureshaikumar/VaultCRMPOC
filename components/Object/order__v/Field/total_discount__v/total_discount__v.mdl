Field total_discount__v (
   label('Total Discount'),
   type('Number'),
   active(true),
   description('Total percentage discount given.'),
   required(false),
   unique(false),
   max_value(1),
   min_value(0),
   scale(4),
   help_content(),
   list_column(false),
   order(89),
   formula('If(list_amount__v>0, (list_amount__v - net_amount__v)/list_amount__v, 0)'),
   no_copy(true),
   lookup_relationship_name(),
   lookup_source_field(),
   encrypted(false),
   editable(false),
   format_mask('Percent("0.#######%")'),
   enhanced_blank_handling('blanks_as_zeros_and_empty_strings'),
   rollup(false),
   control_binding()
);