Field total_remaining__v (
   label('Remaining Total'),
   type('Number'),
   active(true),
   description('The remaining number of calls the team must complete in the Cycle Plan period to achieve their planned call objective for the targeted account.  Default value is 0.'),
   required(false),
   unique(false),
   max_value(9223372036854775807),
   min_value(0),
   scale(0),
   help_content(),
   list_column(false),
   order(25),
   formula('If(And(IsBlank(total_planned_calls__v ),IsBlank(total_actual_calls__v)),0                   ,If(IsBlank(total_actual_calls__v) ,total_planned_calls__v                        , If(IsBlank(total_planned_calls__v ),0                             , If((total_planned_calls__v -total_actual_calls__v)>=0,                                      total_planned_calls__v -total_actual_calls__v,                                      0)                         )                     ) )'),
   no_copy(true),
   lookup_relationship_name(),
   lookup_source_field(),
   encrypted(false),
   editable(false),
   format_mask(),
   enhanced_blank_handling('blanks_as_zeros_and_empty_strings'),
   rollup(false),
   control_binding()
);