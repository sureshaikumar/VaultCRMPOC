Field cdn_path_contains_vault_id__v (
   label('CDN Path Contains Vault ID'),
   type('Boolean'),
   active(true),
   description('Indicates whether published content belongs to the current Vault'),
   required(false),
   checkbox(false),
   help_content(),
   list_column(false),
   order(31),
   formula('Contains(cdn_path__v, Text(@Vault.id))'),
   no_copy(true),
   lookup_relationship_name(),
   lookup_source_field(),
   encrypted(false),
   editable(false),
   enhanced_blank_handling('blanks_as_blanks'),
   control_binding()
);