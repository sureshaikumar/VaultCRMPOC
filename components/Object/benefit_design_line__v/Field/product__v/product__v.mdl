   create_object_inline(false),
   order(20),
   object('formulary_products__v'),
   relationship_type('reference'),
   relationship_outbound_name('product__vr'),
   relationship_inbound_name('product__vr'),
   relationship_inbound_label('Benefit Design Lines'),
   relationship_deletion('setnull'),
   relationship_criteria(),
   no_copy(false),
   lookup_relationship_name(),
   lookup_source_field(),
   secure_relationship(false),
   editable(true),
   predefault_reference(false),
   control_binding()
);