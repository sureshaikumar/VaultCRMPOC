Field landing_tab__sys (
   label('Landing Tab'),
   type('Object'),
   active(true),
   description(),
   required(false),
   unique(false),
   help_content('Sets the tab a user will land on upon login'),
   list_column(false),
   create_object_inline(false),
   order(50),
   object('tab_group__sys'),
   relationship_type('reference'),
   relationship_outbound_name('landing_tab__sysr'),
   relationship_inbound_name('users_landing_tab__sysr'),
   relationship_inbound_label('User Landing Tab'),
   relationship_deletion('setnull'),
   relationship_criteria([( tab_type__sys != 'MENU' AND parent_tab_id__sys = null ) AND tab_type__sys != 'DASHBOARD']),
   no_copy(false),
   lookup_relationship_name(),
   lookup_source_field(),
   secure_relationship(false),
   editable(true),
   predefault_reference(false),
   control_binding()
);