Field group_identifier__v (
   label('Group Identifier'),
   type('String'),
   active(true),
   description(),
   required(false),
   unique(false),
   max_length(1500),
   help_content('If present, this is the group identifier for a grouped sample order transaction, otherwise it''s just the sample order transaction id.'),
   list_column(false),
   order(87),
   formula('if(length(group_transaction_id__v) > 0, group_transaction_id__v, id)'),
   no_copy(true),
   lookup_relationship_name(),
   lookup_source_field(),
   encrypted(false),
   editable(false),
   format_mask(),
   enhanced_blank_handling('blanks_as_zeros_and_empty_strings'),
   control_binding()
);