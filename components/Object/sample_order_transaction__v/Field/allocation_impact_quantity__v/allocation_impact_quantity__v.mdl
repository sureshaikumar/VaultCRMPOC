Field allocation_impact_quantity__v (
   label('Allocation Impact Quantity'),
   type('Number'),
   active(true),
   description(),
   required(false),
   unique(false),
   max_value(9223372036854775807),
   min_value(-9223372036854775808),
   scale(0),
   help_content('Allocation Impact Quantity is the formula that defines the impact that the Quantity and Confirmed Quantity have for a specific Transaction Type.  The Allocation Inventory Impact is summed for a given Sample Lot.'),
   list_column(false),
   order(85),
   formula('If(type__v = "brc__v" && sample_order_transaction_status__v = "submitted__v" && Not(IsBlank(lot__v)), -quantity__v, If(type__v = "transfer__v" && sample_order_transaction_status__v = "submitted__v", -quantity__v, If(type__v = "receipt__v" && sample_order_transaction_status__v = "submitted__v", confirmed_quantity__v, If(type__v = "adjustment__v" && sample_order_transaction_status__v = "submitted__v", quantity__v, 0))))'),
   no_copy(true),
   lookup_relationship_name(),
   lookup_source_field(),
   encrypted(false),
   editable(false),
   format_mask(),
   enhanced_blank_handling('blanks_as_zeros_and_empty_strings'),
   rollup(false),
   control_binding()
);