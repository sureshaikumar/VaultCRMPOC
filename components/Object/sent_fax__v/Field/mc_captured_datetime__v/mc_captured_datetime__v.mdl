Field mc_captured_datetime__v (
   label('MC Captured Datetime'),
   type('DateTime'),
   active(true),
   description('The capture datetime of the Opt-In Multichannel Consent record which allowed this Sent Fax record to pass consent validation. If there is no Opt-In (Implicit model), then this will be NULL.'),
   required(false),
   help_content(),
   list_column(false),
   order(28),
   no_copy(false),
   lookup_relationship_name(),
   lookup_source_field(),
   encrypted(false),
   editable(true),
   rollup(false),
   control_binding()
);