Field meeting_link__v (
   label('Meeting Link'),
   type('String'),
   active(true),
   description('The meeting join link of the current virtual event type scheduled for this event.'),
   required(false),
   unique(false),
   max_length(1000),
   help_content(),
   list_column(false),
   order(133),
   formula('Case(virtual_type__v,
"zoom_meeting__v",Left(zoom_remote_meeting__vr.zoom_meeting_join_link__v,1000),
"engage__v","",
"")'),
   no_copy(true),
   lookup_relationship_name(),
   lookup_source_field(),
   encrypted(false),
   editable(false),
   format_mask(),
   enhanced_blank_handling('blanks_as_blanks'),
   control_binding()
);