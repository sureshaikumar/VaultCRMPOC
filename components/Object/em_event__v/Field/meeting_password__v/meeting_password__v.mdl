Field meeting_password__v (
   label('Meeting Password'),
   type('String'),
   active(true),
   description('The meeting password of the current virtual event type scheduled for this event.'),
   required(false),
   unique(false),
   max_length(20),
   help_content(),
   list_column(false),
   order(134),
   formula('Case(virtual_type__v,
"zoom_meeting__v",zoom_remote_meeting__vr.meeting_password__v,
"engage__v",engage_webinar__vr.meeting_password__v,
"")'),
   no_copy(true),
   lookup_relationship_name(),
   lookup_source_field(),
   encrypted(false),
   editable(false),
   format_mask(),
   enhanced_blank_handling('blanks_as_blanks'),
   control_binding()
);