Field event_display_name__v (
   label('Event Display Name'),
   type('String'),
   active(true),
   description(),
   required(false),
   unique(false),
   max_length(80),
   help_content('This field is used to support disconnected signature capture for the Events Management product. This value displays on the event sign in sheet. If it is not populated, the Name field value from the event is displayed on sign in sheet.'),
