Field discrepancy__v (
   label('Discrepancy'),
   type('Number'),
   active(true),
   description('Discrepancy represents the calculated difference between the Quantity and Confirmed Quantity for a Sample Transaction.  The Discrepancy field can be utilized to report on Sample Transactions where a Discrepancy has occurred.'),
   required(false),
   unique(false),
   max_value(9223372036854775807),
   min_value(-9223372036854775808),
   scale(0),
   help_content(),
   list_column(false),
   order(77),
   formula('if(type__v  = "transfer__v" && sample_transaction_status__v  = "submitted__v" && received__v, quantity__v - blankValue(confirmed_quantity__v, 0),
        if(type__v  = "receipt__v" && sample_transaction_status__v  = "submitted__v", quantity__v - blankValue(confirmed_quantity__v, 0), 0))'),
   no_copy(true),
   lookup_relationship_name(),
   lookup_source_field(),
   encrypted(false),
   editable(false),
   format_mask(),
   enhanced_blank_handling('blanks_as_blanks'),
   rollup(false),
   control_binding()
);