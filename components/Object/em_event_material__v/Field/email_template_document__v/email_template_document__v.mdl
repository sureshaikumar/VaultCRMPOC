Field email_template_document__v (
   label('Email Template Document'),
   type('Object'),
   active(true),
   description(),
   required(false),
   unique(false),
   help_content('Used to associate an event material with an Email Template Document.'),
   list_column(false),
   create_object_inline(false),
   order(39),
   object('documents'),
   relationship_type('reference'),
   relationship_outbound_name('email_template_document__vr'),
   relationship_inbound_name('email_temp_event_material__vr'),
   relationship_inbound_label('Email Template Event Material'),
   relationship_deletion('setnull'),
   relationship_criteria([TONAME(email_template_type__v) = 'events_management_invite_template__v' AND ( TONAME(status__v) = 'approved__v' OR TONAME(status__v) = 'staged__v' )]),
   no_copy(false),
   lookup_relationship_name(),
   lookup_source_field(),
   document_version_reference('specific'),
   secure_relationship(false),
   editable(true),
   predefault_reference(false),
   control_binding()
);