Field number_of_uploads__v (
   label('# Uploads'),
   type('Number'),
   active(true),
   description('Number of objects uploaded to the server.  Calls and Orders count as one per top level object, even though they may contain many objects (e.g. an Order with 10 Order Lines, counts as 1 upload, not 11).'),
   required(false),
   unique(false),
   max_value(9999999),
   min_value(-9999999),
   scale(0),
   help_content(),
   list_column(false),
   order(15),
   no_copy(false),
   lookup_relationship_name(),
   lookup_source_field(),
   encrypted(false),
   editable(true),
   format_mask(),
   rollup(false),
   control_binding()
);