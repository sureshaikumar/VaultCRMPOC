Field sync_duration__v (
   label('Sync Duration (secs)'),
   type('Number'),
   active(true),
   description('Duration of the sync in seconds.'),
   required(false),
   unique(false),
   max_value(9223372036854775807),
   min_value(-9223372036854775808),
   scale(2),
   help_content(),
   list_column(false),
   order(26),
   formula('If(
                    And(
                      Not(IsBlank(sync_completed_datetime__v)),
                      Not(IsBlank(sync_start_datetime__v))
                    ),
                    UnixTimestamp(sync_completed_datetime__v) - UnixTimestamp(sync_start_datetime__v),
                    null
                  )'),
   no_copy(true),
   lookup_relationship_name(),
   lookup_source_field(),
   encrypted(false),
   editable(false),
   format_mask(),
   enhanced_blank_handling('blanks_as_zeros_and_empty_strings'),
   rollup(false),
   control_binding()
);