Field country__v (
   label('Country'),
   type('String'),
   active(true),
   description('Country_vod captures the two-letter country code (as specified by ISO3166) the event came from or ‘unknown’ if it couldn’t be determined. This is reported by the Multichannel Email Engine.'),
   required(false),
   unique(false),
   max_length(20),
   help_content(),
   list_column(false),
   order(16),
   no_copy(false),
   lookup_relationship_name(),
   lookup_source_field(),
   encrypted(false),
   editable(true),
   format_mask(),
   control_binding()
);