Field user_fields__v (
   label('User Fields'),
   type('String'),
   active(true),
   description('Defines up to 5 User (user__sys) fields to display in the Case UI, in the order listed. Enter as a double semicolon (;;)-delimited list, for example: user__sys.fieldname__v;;user__sys.fieldname__v;;user__sys.fieldname__v'),
   required(false),
   unique(false),
   max_length(1500),
   help_content('User Object (user__sys) fields to display in the Case UI (maximum 5). Fields are rendered in the order listed. Format fieldname__sys;;fieldname__sys;;fieldname__sys'),
   list_column(false),
   order(18),
   default_value('"user__sys.office_phone__sys;;user__sys.email__sys;;user__sys.country__v;;user__sys.timezone__sys"'),
   no_copy(false),
   lookup_relationship_name(),
   lookup_source_field(),
   encrypted(false),
   editable(true),
   format_mask(),
   control_binding()
);