Field patient_prescription_card_fields__v (
   label('Patient Prescription Fields'),
   type('String'),
   active(true),
   description('Defines up to 10 Patient Prescription (patient_prescription__v) fields to display in the Patient Overview tab, in the order listed. Enter as a double semicolon (;;)-delimited list, for example: patient_prescription__v.fieldname__v;;patient_prescription__v.fieldname__v'),
   required(false),
   unique(false),
   max_length(1500),
   help_content(),
   list_column(false),
   order(25),
   default_value('"patient_prescription__v.prescriber_phone__v;;patient_prescription__v.prescriber_email__v;;patient_prescription__v.prescriber_address__v;;patient_prescription__v.npi__v;;patient_prescription__v.date_signed__v;;patient_prescription__v.product__v;;patient_prescription__v.prescription_duration__v"'),
   no_copy(false),
   lookup_relationship_name(),
   lookup_source_field(),
   encrypted(false),
   editable(true),
   format_mask(),
   control_binding()
);