Field patient_insurance_card_fields__v (
   label('Patient Insurance Fields'),
   type('String'),
   active(true),
   description('Defines up to 10 Patient Insurance (patient_insurance__v) fields to display in the Patient Overview tab, in the order listed. Enter as a double semicolon (;;)-delimited list, for example: patient_insurance__v.fieldname__v;;patient_insurance__v.fieldname__v'),
   required(false),
   unique(false),
   max_length(1500),
   help_content(),
   list_column(false),
   order(24),
   default_value('"patient_insurance__v.phone_number__v;;patient_insurance__v.member_id__v;;patient_insurance__v.group_id__v;;patient_insurance__v.policyholder__v"'),
   no_copy(false),
   lookup_relationship_name(),
   lookup_source_field(),
   encrypted(false),
   editable(true),
   format_mask(),
   control_binding()
);