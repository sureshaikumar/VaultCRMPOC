Field patient_fields__v (
   label('Patient Fields'),
   type('String'),
   active(true),
   description('Defines up to 10 Patient Attribute (patient_attribute__v) fields to display in the Case UI, in the order listed. Enter as a double semicolon (;;)-delimited list, for example: patient_attribute__v.fieldname__v;;patient_attribute__v.fieldname__v'),
   required(false),
   unique(false),
   max_length(1500),
   help_content('Patient Attributes Object (patient_attributes__v) fields to display in the Case UI. Fields are rendered in the order listed. Format fieldname__v;;fieldname__v;;fieldname__v'),
   list_column(false),
   order(21),
   default_value('"patient_attribute__v.home_phone__v;;patient_attribute__v.mobile_phone__v;;patient_attribute__v.email__v;;patient_attribute__v.date_of_birth__v"'),
   no_copy(false),
   lookup_relationship_name(),
   lookup_source_field(),
   encrypted(false),
   editable(true),
   format_mask(),
   control_binding()
);