Field caregiver_fields__v (
   label('Caregiver Fields'),
   type('String'),
   active(true),
   description('Defines the Patient Attribute (patient_attribute__v) caregiver fields to display in the Case UI when Has Caregiver? is set to true. Enter as a double semicolon (;;)-delimited list, for example: patient_attribute__v.caregiver__v;;patient_attribute__v.caregiver_email__v;;patient_attribute__v.caregiver_mobile_phone__v;;patient_attribute__v.caregiver_relationship__v'),
   required(false),
   unique(false),
   max_length(1500),
   help_content(),
   list_column(false),
   order(23),
   default_value('"patient_attribute__v.caregiver__v;;patient_attribute__v.caregiver_email__v;;patient_attribute__v.caregiver_mobile_phone__v;;patient_attribute__v.caregiver_relationship__v"'),
   no_copy(false),
   lookup_relationship_name(),
   lookup_source_field(),
   encrypted(false),
   editable(true),
   format_mask(),
   control_binding()
);