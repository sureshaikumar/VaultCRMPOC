Field account_fields__v (
   label('Account Fields'),
   type('String'),
   active(true),
   description('Defines up to 5 Account (account__v) fields to display in the Case UI, in the order listed. Enter as a double semicolon (;;)-delimited list, for example: account__v.fieldname__v;;account__v.fieldname__v;;account__v.fieldname__v'),
   required(false),
   unique(false),
   max_length(1500),
   help_content('Account Object (account__v) fields to display in the Case UI (maximum 5). Fields are rendered in the order listed. Format fieldname__v;;fieldname__v;;fieldname__v'),
   list_column(false),
   order(10),
   default_value('"account__v.mobile_phone_cda__v;;account__v.email_cda__v;;account__v.city_cda__v;;account__v.postal_code_cda__v;;account__v.npi__v"'),
   no_copy(false),
   lookup_relationship_name(),
   lookup_source_field(),
   encrypted(false),
   editable(true),
   format_mask(),
   control_binding()
);