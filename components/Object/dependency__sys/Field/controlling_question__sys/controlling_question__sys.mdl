Field controlling_question__sys (
   label('Controlling Question'),
   type('Object'),
   active(true),
   description(),
   required(true),
   help_content(),
   list_column(false),
   create_object_inline(false),
   order(10),
   object('response__sys'),
   relationship_type('parent'),
   relationship_outbound_name('controlling_question__sysr'),
   relationship_inbound_name('controlled_dependencies__sysr'),
   relationship_inbound_label('Controlled Dependencies'),
   relationship_deletion('cascade'),
   relationship_criteria([object_type__vr.api_name__v = 'multiple_choice_response__sys' AND checklist__sys = {{this.checklist__sys}} AND checklist_answer_type__sys != 'checkbox__sys']),
   relationship_deep_copy(false),
   no_copy(false),
   lookup_relationship_name(),
   lookup_source_field(),
   secure_relationship(false),
   editable(true),
   replicate_sharing_from_parent(false),
   control_binding()
);