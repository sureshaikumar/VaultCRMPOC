   order(21),
   default_value('"NAS_PERSON_DETAILS;;NETWORK"'),
   no_copy(false),
   lookup_relationship_name(),
   lookup_source_field(),
   encrypted(false),
   editable(true),
   format_mask(),
   control_binding()
);