Field inactive__v (
   label('Inactive'),
   type('Boolean'),
   active(true),
   description('The Inactive checkbox determines if the Address record will be displayed in the Call Report and My Schedule Address Picklist for both online and offline implementations.  If the Inactive checkbox is checked, then the Address record will not be displayed.'),
