Field percent_all_goals__v (
   label('% of All Goals'),
   type('Number'),
   active(true),
   description('Percent that the distinct channel or product represents of all goals for all channels or products (depending on the RecordType). All goals add up to 100% when activity goals are used. If no goals used this value will be blank.'),
   required(false),
   unique(false),
   max_value(9999999.99),
   min_value(0),
   scale(2),
   help_content(),
   list_column(false),
   order(14),
   no_copy(false),
   lookup_relationship_name(),
   lookup_source_field(),
   encrypted(false),
   editable(true),
   format_mask('Percent("0.#######%")'),
   rollup(false),
   control_binding()
);