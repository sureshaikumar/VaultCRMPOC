Field yearly_call_activity__v (
   label('Yearly Call Activity'),
   type('Number'),
   active(true),
   description('This field displays a count of past-dated Saved and Submitted calls for the current calendar year.'),
   required(false),
   unique(false),
   max_value(10000),
   min_value(0),
   scale(0),
   help_content('The number of calls associated with the TSF''s Account and Territory this calendar year.'),
   list_column(false),
   order(26),
   formula('BlankValue(GetRelatedRecordValue($tsf_yearly_activities__vr, $call_count__v, "year__v = {{THIS_YEAR}}"), 0)'),
   no_copy(true),
   lookup_relationship_name(),
   lookup_source_field(),
   encrypted(false),
   editable(false),
   format_mask(),
   enhanced_blank_handling('blanks_as_blanks'),
   rollup(false),
   control_binding()
);