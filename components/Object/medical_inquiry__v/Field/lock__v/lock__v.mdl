Field lock__v (
   label('Lock'),
   type('Boolean'),
   active(true),
   description('The Lock field is leveraged by VBioPharma to determine if the Medical Inquiry should be editable by a User.  If the Lock field is checked, then the record will only be editable by a User with Admin privileges.'),
   required(false),
   checkbox(true),
   help_content(),
   list_column(false),
   order(25),
   default_value('false'),
   no_copy(false),
   lookup_relationship_name(),
   lookup_source_field(),
   encrypted(false),
   editable(true),
   control_binding()
);