Field om_net_amount_remaining__v (
   label('OM Net Amount Remaining'),
   type('Number'),
   subtype('Currency'),
   active(true),
   description('Shows remaining net amount to reach the defined target (target minus achieved).'),
   required(false),
   unique(false),
   max_value(100000000000000000),
   min_value(-100000000000000000),
   scale(6),
   help_content(),
   list_column(false),
   order(55),
   formula('om_net_amount_target__v - om_net_amount_achieved__v'),
   no_copy(true),
   lookup_relationship_name(),
   lookup_source_field(),
   encrypted(false),
   editable(false),
   currency_type('corporate'),
   enhanced_blank_handling('blanks_as_zeros_and_empty_strings'),
   rollup(false),
   control_binding()
);