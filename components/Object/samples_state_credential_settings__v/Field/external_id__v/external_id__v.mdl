Field external_id__v (
   label('External Id'),
   type('String'),
   active(true),
   description('The External Id field is leveraged to allow the upserting of records as well as to enforce uniqueness.  This value is set by a Trigger for each record and is equal to “[State_vod]” & “_” & “[Credential_vod]”'),
   required(false),
   unique(true),
   max_length(255),
   help_content(),
   list_column(false),
   order(13),
   no_copy(false),
   lookup_relationship_name(),
   lookup_source_field(),
   encrypted(false),
   editable(true),
   format_mask(),
   control_binding()
);