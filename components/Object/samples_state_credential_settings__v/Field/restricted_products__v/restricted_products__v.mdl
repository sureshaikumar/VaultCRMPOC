Field restricted_products__v (
   label('Restricted Products'),
   type('LongText'),
   active(true),
   description(),
   required(false),
   max_length(1000),
   help_content('Field used to hold restricted products for a particular state and credential combination.
Format should be Double semi-colon delimited list of Product Names. 
These will be textual Product Catalog records of type = Detail. 
For example, Cholecap;;Labrinon'),
   list_column(false),
   order(14),
   no_copy(false),
   lookup_relationship_name(),
   lookup_source_field(),
   encrypted(false),
   editable(true),
   control_binding()
);