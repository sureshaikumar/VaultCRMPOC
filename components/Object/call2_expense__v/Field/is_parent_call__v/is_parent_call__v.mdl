Field is_parent_call__v (
   label('Is Parent Call?'),
   type('Number'),
   active(true),
   description('Formula Field to determine if the Call Expense record is part of the Parent Call or of an Attendee Call record.  1 indicates that the record is associated with the Parent Call.  0 indicates that it is associated with an Attendee Call.'),
   required(false),
   unique(false),
   max_value(1),
   min_value(0),
   scale(0),
   help_content(),
   list_column(false),
   order(22),
   formula('If(Length(Id(call2__vr.parent_call__v) )>0, 0,1)'),
   no_copy(true),
   lookup_relationship_name(),
   lookup_source_field(),
   encrypted(false),
   editable(false),
   format_mask(),
   enhanced_blank_handling('blanks_as_blanks'),
   rollup(false),
   control_binding()
);