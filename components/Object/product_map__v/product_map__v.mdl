RECREATE Object product_map__v (
   label('Product Map'),
   label_plural('Product Maps'),
   active(true),
   description('Configuration object that stores dependency mappings between Product-Detail Group combinations and picklists'),
   help_content('The values populated in the Product and Detail Group fields on a record function jointly as the controlling picklist value to be mapped to the dependent picklist values. One Product Map record is required for each dependency combination.'),
   in_menu(true),
   allow_attachments(false),
   enable_esignatures(false),
   audit(false),
   order(857),
   dynamic_security(false),
   system_managed(false),
   available_lifecycles(),
   object_class('base'),
   allow_types(true),
   user_role_setup_object(),
   secure_sharing_settings(false),
   secure_attachments(false),
   secure_audit_trail(false),
   prevent_record_overwrite(false),
   data_store('standard'),
   triggers_disallowed(false),
   configuration_data(false),
   enable_merges(false),
   summary_fields(),
   security_tree_object(),
   tree_assignment_object_name(),
   user_reference_assignment(),
   secure_copy_record(false),
   Field(@Field/available_picklist_values__v.mdl),
   Field(@Field/controlling_detail_group__v.mdl),
   Field(@Field/controlling_detail_product__v.mdl),
   Field(@Field/created_by__v.mdl),
   Field(@Field/created_date__v.mdl),
   Field(@Field/dependent_field__v.mdl),
   Field(@Field/external_id__v.mdl),
   Field(@Field/global_id__sys.mdl),
   Field(@Field/id.mdl),
   Field(@Field/last_initiated_by__sys.mdl),
   Field(@Field/link__sys.mdl),
   Field(@Field/modified_by__v.mdl),
   Field(@Field/modified_date__v.mdl),
   Field(@Field/name__v.mdl),
   Field(@Field/object__v.mdl),
   Field(@Field/object_type__v.mdl),
   Field(@Field/status__v.mdl)
);