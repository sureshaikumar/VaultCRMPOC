RECREATE Object vfm_user__sys (
   label('Vault File Manager User'),
   label_plural('Vault File Manager Users'),
   active(true),
   description('System managed object that creates and updates records when users log in to Vault File Manager'),
   help_content('System managed object that creates and updates records when users log in to Vault File Manager'),
   in_menu(true),
   allow_attachments(false),
   enable_esignatures(false),
   audit(false),
   order(367),
   dynamic_security(false),
   system_managed(true),
   available_lifecycles(),
   object_class('base'),
   allow_types(false),
   user_role_setup_object(),
   secure_sharing_settings(false),
   secure_attachments(false),
   secure_audit_trail(false),
   prevent_record_overwrite(false),
   data_store('standard'),
   triggers_disallowed(false),
   configuration_data(false),
   enable_merges(false),
   summary_fields(),
   security_tree_object(),
   tree_assignment_object_name(),
   user_reference_assignment(),
   secure_copy_record(false),
   Field(@Field/created_by__v.mdl),
   Field(@Field/created_date__v.mdl),
   Field(@Field/global_id__sys.mdl),
   Field(@Field/id.mdl),
   Field(@Field/last_connected_date__sys.mdl),
   Field(@Field/last_initiated_by__sys.mdl),
   Field(@Field/link__sys.mdl),
   Field(@Field/modified_by__v.mdl),
   Field(@Field/modified_date__v.mdl),
   Field(@Field/name__v.mdl),
   Field(@Field/status__v.mdl),
   Field(@Field/vfm_user_id__sys.mdl),
   Field(@Field/vfm_version__sys.mdl)
);