Field ship_to_address_text__v (
   label('Ship To Address'),
   type('String'),
   active(true),
   description('The Ship to Address Formula field corresponds to a formatted version of the Ship to Address fields.  This value is leveraged in the case that the referenced Ship to Address has been deleted.  This field should not be added to a Page Layout.'),
   required(false),
   unique(false),
   max_length(1500),
   help_content(),
   list_column(false),
   order(208),
   formula('ship_address_line_1__v    & If(Length(ship_address_line_2__v) > 0,   ", " &  ship_address_line_2__v, "")  & If(Length(ship_city__v) > 0,   ", " &  ship_city__v, "")  & If(Length(ship_state__v) > 0,   ", " &  ship_state__v, "")   & If(Length(ship_zip__v) > 0,   " " &  ship_zip__v, "")  & If(Length(ship_country__v) > 0,   " " &  ship_country__v, "")'),
   no_copy(true),
   lookup_relationship_name(),
   lookup_source_field(),
   encrypted(false),
   editable(false),
   format_mask(),
   enhanced_blank_handling('blanks_as_blanks'),
   control_binding()
);