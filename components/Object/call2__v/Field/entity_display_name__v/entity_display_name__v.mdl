Field entity_display_name__v (
   label('Entity Display Name'),
   type('String'),
   active(true),
   description('Entity''s displayed name'),
   required(false),
   unique(false),
   max_length(1500),
   help_content(),
   list_column(false),
   order(206),
   formula('If(Not(IsBlank(account__v)), If(account__vr.ispersonaccount__v = TRUE, account__vr.last_name_cda__v & ", " & account__vr.first_name_cda__v & If(IsBlank(account__vr.suffix_cda__v), "", " " & account__vr.suffix_cda__v), account__vr.name__v), If(Not(IsBlank(person__v)), If(IsBlank(person__vr.first_name__sys), "", person__vr.first_name__sys & " ") & person__vr.last_name__sys, If(Not(IsBlank(user__v)), user__vr.first_name__sys & " " & user__vr.last_name__sys, If(Not(IsBlank(medical_event__v)), medical_event__vr.name__v, ""))))'),
   no_copy(true),
   lookup_relationship_name(),
   lookup_source_field(),
   encrypted(false),
   editable(false),
   format_mask(),
   enhanced_blank_handling('blanks_as_zeros_and_empty_strings'),
   control_binding()
);