Field signature_on_sync__v (
   label('Signature on Sync'),
   type('String'),
   active(true),
   description(),
   required(false),
   unique(false),
   max_length(1500),
   help_content('Indicates the presence of a practitioner signature on sync of a saved call to determine ability of practitioner to re-sign for samples with sample limits'),
   list_column(false),
   order(209),
   formula('If( IsBlank( signature_date__v ), "no__v", "yes__v" )'),
   no_copy(true),
   lookup_relationship_name(),
   lookup_source_field(),
   encrypted(false),
   editable(false),
   format_mask(),
   enhanced_blank_handling('blanks_as_zeros_and_empty_strings'),
   control_binding()
);