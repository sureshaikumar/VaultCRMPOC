Field in_therapy__v (
   label('In Therapy'),
   type('Boolean'),
   active(true),
   description('This field auto-populates ''Yes'' when the the Patient Journey Step Phase indicated as the entered therapeutic phase (''Enter Therapeutic Phase'' = Yes) record is created, this value is needed to calculate the average length of time (days) for patients from journey enrollment to the start of therapy.'),
   required(false),
   checkbox(false),
   help_content(),
   list_column(false),
   order(17),
   default_value('FALSE'),
   no_copy(true),
   lookup_relationship_name(),
   lookup_source_field(),
   encrypted(false),
   editable(true),
   control_binding()
);