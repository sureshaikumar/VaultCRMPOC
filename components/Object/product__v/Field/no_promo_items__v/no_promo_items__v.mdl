Field no_promo_items__v (
   label('No Promo Items'),
   type('String'),
   active(true),
   description('This formula field defines whether the product catalog record appears in the Samples And Promotional Items section on the Call Report. If the result of the formula is TRUE, then the product will not appear on the Samples And Promotional Items section.'),
   required(false),
   unique(false),
   max_length(1500),
   help_content(),
   list_column(false),
   order(56),
   formula('Case(product_type__v, ''detail__v'', ''TRUE'', ''order__v'', ''TRUE'', ''kit_item__v'', ''TRUE'', ''brc__v'', ''TRUE'', ''market__v'', ''TRUE'', ''submarket__v'', ''TRUE'', ''inventory_monitoring__v'', ''TRUE'', ''product_group__v'', ''TRUE'', ''sample_product_group__v'', ''TRUE'', ''detail_group__v'',''TRUE'', ''detail_topic__v'', ''TRUE'', ''FALSE'')'),
   no_copy(true),
   lookup_relationship_name(),
   lookup_source_field(),
   encrypted(false),
   editable(false),
   format_mask(),
   enhanced_blank_handling('blanks_as_zeros_and_empty_strings'),
   control_binding()
);