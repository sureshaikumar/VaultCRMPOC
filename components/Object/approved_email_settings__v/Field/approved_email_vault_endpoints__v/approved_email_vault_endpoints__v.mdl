Field approved_email_vault_endpoints__v (
   label('Approved Email Vault Endpoints'),
   type('String'),
   active(true),
   description('This is a delimited list of Vault endpoints to be used by the Approved Email process to pull documents into the Approved Documents object. Requires that a SFDC user be created and registered within the Vault domain security profile. The query string value'),
