   unique(false),
   max_length(255),
   help_content(),
   list_column(false),
   order(20),
   default_value('"APPROVED_EMAIL_VAULT_ENDPOINTS;;ApprovedEmail"'),
   no_copy(false),
   lookup_relationship_name(),
   lookup_source_field(),
   encrypted(false),
   editable(true),
   format_mask(),
   control_binding()
);