Field approved_email_field_exclusions__v (
   label('Approved Email Field Exclusion List'),
   type('String'),
   active(true),
   description('Delimited list of object.field references that should be excluded from the Core Email UI. All email values from these fields will be suppressed from the Approved Email UI. The setting values are persisted in the corresponding Veeva Message'),
   required(false),
   unique(false),
   max_length(255),
   help_content(),
   list_column(false),
   order(16),
   default_value('"APPROVED_EMAIL_FIELD_EXCLUSIONS;;ApprovedEmail"'),
   no_copy(false),
   lookup_relationship_name(),
   lookup_source_field(),
   encrypted(false),
   editable(true),
   format_mask(),
   control_binding()
);