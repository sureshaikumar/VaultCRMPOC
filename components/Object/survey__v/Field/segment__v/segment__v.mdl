Field segment__v (
   label('Segments'),
   type('LongText'),
   active(true),
   description('List of segments and min / max scoring rules.  Segments are based on the sum of an account’s response scores.  Segments are limited to 10 entries.  Example: Late Adopter; 0; 50; Early Adopter; 51; 100;'),
