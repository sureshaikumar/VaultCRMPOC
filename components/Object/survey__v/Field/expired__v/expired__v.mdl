Field expired__v (
   label('Expired'),
   type('String'),
   active(true),
   description(),
   required(false),
   unique(false),
   max_length(1500),
   help_content('If current date > End_Date_vod (on the Survey record), the survey is considered expired'),
   list_column(false),
   order(36),
   formula('If(end_date__v < Today(),"Yes","No")'),
   no_copy(true),
   lookup_relationship_name(),
   lookup_source_field(),
   encrypted(false),
   editable(false),
   format_mask(),
   enhanced_blank_handling('blanks_as_zeros_and_empty_strings'),
   control_binding()
);