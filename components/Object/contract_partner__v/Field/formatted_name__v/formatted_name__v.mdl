Field formatted_name__v (
   label('Formatted Name'),
   type('String'),
   active(true),
   description('This formula field is used to display a well formatted person account name in (lastname, firstname suffix) format.'),
   required(false),
   unique(false),
   max_length(1500),
   help_content(),
   list_column(false),
   order(38),
   formula('If(IsBlank(account__v), If(IsBlank(em_speaker__v), If(IsBlank(em_event_speaker__v), "", em_event_speaker__vr.speaker_name__v), em_speaker__vr.name__v), If(account__vr.ispersonaccount__v, account__vr.last_name_cda__v & ", " & account__vr.first_name_cda__v & If(IsBlank(account__vr.suffix_cda__v), "", " " & account__vr.suffix_cda__v), account__vr.name__v ))'),
   no_copy(true),
   lookup_relationship_name(),
   lookup_source_field(),
   encrypted(false),
   editable(false),
   format_mask(),
   enhanced_blank_handling('blanks_as_zeros_and_empty_strings'),
   control_binding()
);