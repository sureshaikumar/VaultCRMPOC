Field channel_source__v (
   label('Channel Source'),
   type('LongText'),
   active(true),
   description('Store the values of the pull through fields that will be used to create the picklist values for Channel Fields. This is a double semi colon delimited set. Eg - Account.Email;;Account.Email2__c'),
