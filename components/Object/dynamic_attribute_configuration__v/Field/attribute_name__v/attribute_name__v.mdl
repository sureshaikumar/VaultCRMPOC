Field attribute_name__v (
   label('Name'),
   type('String'),
   active(true),
   description('The unique Dynamic Attribute name used to reference the Dynamic Attribute. This value is not visible to the field-user.'),
   required(true),
   unique(true),
   max_length(255),
   help_content(),
   list_column(false),
   order(12),
   no_copy(false),
   lookup_relationship_name(),
   lookup_source_field(),
   encrypted(false),
   editable(true),
   format_mask(),
   control_binding()
);