Field unique_key__v (
   label('Unique Key'),
   type('String'),
   active(true),
   description('Unique key preventing duplicate active Network mappings. Only set for record where Active = True. Should be cleared for records where Active becomes False. Contains Country field value.'),
   required(false),
   unique(true),
   max_length(255),
   help_content(),
   list_column(false),
   order(14),
   no_copy(false),
   lookup_relationship_name(),
   lookup_source_field(),
   encrypted(false),
   editable(true),
   format_mask(),
   control_binding()
);