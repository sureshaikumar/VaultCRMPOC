Field is_parent__v (
   label('Is Parent?'),
   type('Number'),
   active(true),
   description('Used to indicate parent and child relationship between flagged text and flagged phrase(s). 1 indicates parent and 0 indicates child.'),
   required(false),
   unique(false),
   max_value(1),
   min_value(0),
   scale(0),
   help_content(),
   list_column(false),
   order(33),
   formula('If(Length(Id(parent_monitored_text__v))>0,0,1)'),
   no_copy(true),
   lookup_relationship_name(),
   lookup_source_field(),
   encrypted(false),
   editable(false),
   format_mask(),
   enhanced_blank_handling('blanks_as_zeros_and_empty_strings'),
   rollup(false),
   control_binding()
);