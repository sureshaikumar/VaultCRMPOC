Field parent_child_name__v (
   label('Parent Child Name'),
   type('String'),
   active(true),
   description(),
   required(false),
   unique(false),
   max_length(1500),
   help_content('Display name for the parent child relationship'),
   list_column(false),
   order(43),
   formula('If (Not(IsBlank(Id(location__v))), location__vr.name__v & " " & target__vr.last_name_cda__v & " " & target__vr.first_name_cda__v,"")'),
   no_copy(true),
   lookup_relationship_name(),
   lookup_source_field(),
   encrypted(false),
   editable(false),
   format_mask(),
   enhanced_blank_handling('blanks_as_blanks'),
   control_binding()
);