Field attainment_difference__v (
   label('Attainment Difference'),
   type('Number'),
   active(true),
   description('Subtracts the actual attainment from the expected attainment. This value is used to color the Attained container on the VMobile Home page widget.'),
   required(false),
   unique(false),
   max_value(9223372036854775807),
   min_value(-9223372036854775808),
   scale(0),
   help_content(),
   list_column(false),
   order(21),
   formula('((If ( Today()  >= end_date__v , 1,    If ( Today() < start_date__v, 0,        (Today() - start_date__v) / (end_date__v - start_date__v)   ) ) ) - (If(planned_calls__v > 0, actual_calls__v / planned_calls__v, 0))) * 100'),
   no_copy(true),
   lookup_relationship_name(),
   lookup_source_field(),
   encrypted(false),
   editable(false),
   format_mask(),
   enhanced_blank_handling('blanks_as_zeros_and_empty_strings'),
   rollup(false),
   control_binding()
);