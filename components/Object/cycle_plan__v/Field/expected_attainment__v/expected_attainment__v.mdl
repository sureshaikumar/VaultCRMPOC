Field expected_attainment__v (
   label('Expected Attainment'),
   type('Number'),
   active(true),
   description('Calculates the expected attainment percentage for the cycle plan period.'),
   required(false),
   unique(false),
   max_value(9223372036854775807),
   min_value(0),
   scale(2),
   help_content(),
   list_column(false),
   order(23),
   formula('If ( Today()  >= end_date__v , 1,    If ( Today() < start_date__v, 0,        (Today() - start_date__v) / (end_date__v - start_date__v)   ) )'),
   no_copy(true),
   lookup_relationship_name(),
   lookup_source_field(),
   encrypted(false),
   editable(false),
   format_mask('Percent("0.#######%")'),
   enhanced_blank_handling('blanks_as_zeros_and_empty_strings'),
   rollup(false),
   control_binding()
);