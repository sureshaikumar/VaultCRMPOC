Field remaining__v (
   label('Remaining'),
   type('Number'),
   active(true),
   description('The remaining number of calls the user must complete in the Cycle Plan period to achieve their overall planned call objective. Default value is 0.'),
   required(false),
   unique(false),
   max_value(9223372036854775807),
   min_value(0),
   scale(0),
   help_content(),
   list_column(false),
   order(25),
   formula('If(And(IsBlank(planned_calls__v),IsBlank(actual_calls__v)),0                   ,If(IsBlank(actual_calls__v) ,planned_calls__v                        , If(IsBlank(planned_calls__v ),0                             , If((planned_calls__v  -actual_calls__v )>=0,planned_calls__v  -actual_calls__v ,0)                         )                     ) )'),
   no_copy(true),
   lookup_relationship_name(),
   lookup_source_field(),
   encrypted(false),
   editable(false),
   format_mask(),
   enhanced_blank_handling('blanks_as_zeros_and_empty_strings'),
   rollup(false),
   control_binding()
);