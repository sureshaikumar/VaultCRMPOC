Field product__v (
   label('Product'),
   type('Object'),
   active(true),
   description('Lookup to the Product record which should appear on the Scientific Interest page.'),
   required(false),
   unique(false),
   help_content(),
   list_column(false),
   create_object_inline(false),
   order(18),
   object('product__v'),
   relationship_type('reference'),
   relationship_outbound_name('product__vr'),
   relationship_inbound_name('scientific_interests__vr'),
   relationship_inbound_label('Scientific Interests'),
   relationship_deletion('setnull'),
   relationship_criteria([product_type__v != 'order__v' AND product_type__v != 'kit_item__v' AND product_type__v != 'inventory_monitoring__v' AND product_type__v != 'product_group__v' AND product_type__v != 'sample_product_group__v']),
   no_copy(false),
   lookup_relationship_name(),
   lookup_source_field(),
   secure_relationship(false),
   editable(true),
   predefault_reference(false),
   control_binding()
);