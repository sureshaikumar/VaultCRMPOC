   help_content('Add up to 10 fields to display as columns in the hierarchy tab for the second level beneath the account plan in the hierarchy. The fields should be formatted as object_name__v.field_name__v'),
   list_column(false),
   order(355),
   no_copy(false),
   lookup_relationship_name(),
   lookup_source_field(),
   encrypted(false),
   editable(true),
   format_mask(),
   control_binding()
);