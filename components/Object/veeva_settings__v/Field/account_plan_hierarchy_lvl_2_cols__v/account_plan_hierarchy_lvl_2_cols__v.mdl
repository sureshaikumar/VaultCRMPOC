Field account_plan_hierarchy_lvl_2_cols__v (
   label('Account Plan Hierarchy Level 2 Columns'),
   type('String'),
   active(true),
   description('Contains a comma-delimited, ordered list of fields that display as columns on the hierarchy tab of an account plan for the second level in the account plan hierarchy. Only the first 10 fields will display.'),
