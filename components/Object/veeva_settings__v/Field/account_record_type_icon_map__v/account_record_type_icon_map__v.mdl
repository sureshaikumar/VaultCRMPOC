ICON_NAME is one of the standard ico'),
   required(false),
   unique(false),
   max_length(255),
   help_content(),
   list_column(false),
   order(13),
   default_value('"ACCOUNT_RECORD_TYPE_ICON_MAP;;Common"'),
   no_copy(false),
   lookup_relationship_name(),
   lookup_source_field(),
   encrypted(false),
   editable(true),
   format_mask(),
   control_binding()
);