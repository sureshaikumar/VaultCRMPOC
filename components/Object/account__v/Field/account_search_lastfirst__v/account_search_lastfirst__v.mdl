Field account_search_lastfirst__v (
   label('Account Search LastFirst'),
   type('String'),
   active(true),
   description('If Person account, set the field value as lastname&firstname no space'),
   required(false),
   unique(false),
   max_length(1500),
   help_content(),
   list_column(false),
   order(127),
   formula('If( ispersonaccount__v ,Substitute( last_name_cda__v," ","") & Substitute(first_name_cda__v," ",""),name__v )'),
   no_copy(true),
   lookup_relationship_name(),
   lookup_source_field(),
   encrypted(false),
   editable(false),
   format_mask(),
   enhanced_blank_handling('blanks_as_zeros_and_empty_strings'),
   control_binding()
);