Field spend_status_value__v (
   label('Spend Status Value'),
   type('String'),
   active(true),
   description('Adjust this formula field to specify an account''s spend status (using Veeva constants) based on customer-defined criteria.  This drives the image displayed in Spend_Status_vod.'),
   required(false),
   unique(false),
   max_length(1500),
   help_content(),
   list_column(false),
   order(131),
   formula('If(spend_amount__c  = "Below Monitoring Threshold", "below_threshold__v", If(spend_amount__c  = "Monitor Spend", "monitor__v", If(spend_amount__c  = "Cease Spend", "cease__v", "invalid__v")))'),
   no_copy(true),
   lookup_relationship_name(),
   lookup_source_field(),
   encrypted(false),
   editable(false),
   format_mask(),
   enhanced_blank_handling('blanks_as_zeros_and_empty_strings'),
   control_binding()
);