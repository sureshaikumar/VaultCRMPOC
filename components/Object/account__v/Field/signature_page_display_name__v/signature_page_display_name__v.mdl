Field signature_page_display_name__v (
   label('Signature Page Display Name'),
   type('String'),
   active(true),
   description(),
   required(false),
   unique(false),
   max_length(1500),
   help_content('Formula field used to display a well formatted display name for an Account on the Call Signature page (Title, Last Name, First Name, Suffix, Credentials, Specialty).'),
   list_column(false),
   order(130),
   formula('Text(salutation__v) & " " & first_name_cda__v & " " & last_name_cda__v & ", " & Text(credentials__v)'),
   no_copy(true),
   lookup_relationship_name(),
   lookup_source_field(),
   encrypted(false),
   editable(false),
   format_mask(),
   enhanced_blank_handling('blanks_as_zeros_and_empty_strings'),
   control_binding()
);