Field child_account_search_lastfirst__v (
   label('Child Account Search LastFirst'),
   type('String'),
   active(true),
   description('Field used for searching.'),
   required(false),
   unique(false),
   max_length(1500),
   help_content(),
   list_column(false),
   order(28),
   formula('If( child_account__vr.ispersonaccount__v ,Substitute( child_account__vr.last_name_cda__v," ","") & Substitute(child_account__vr.first_name_cda__v," ",""),child_account__vr.name__v )'),
   no_copy(true),
   lookup_relationship_name(),
   lookup_source_field(),
   encrypted(false),
   editable(false),
   format_mask(),
   enhanced_blank_handling('blanks_as_blanks'),
   control_binding()
);