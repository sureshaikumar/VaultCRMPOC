Field tab_url__v (
   label('Tab URL'),
   type('String'),
   subtype('Link'),
   active(true),
   description('This field stores the URL for the Territory Utilities web tab so it can be included in the email that is sent to the user on completion of a job.'),
   required(false),
   unique(false),
   max_length(255),
   help_content(),
   list_column(false),
   order(16),
   no_copy(false),
   lookup_relationship_name(),
   lookup_source_field(),
   encrypted(false),
   editable(true),
   format_mask('LinkFormat("new_window")'),
   control_binding()
);