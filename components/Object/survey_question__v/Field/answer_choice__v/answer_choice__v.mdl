Field answer_choice__v (
   label('Answer Choices'),
   type('LongText'),
   active(true),
   description('Stores the potential answer choices for multiselect picklist, picklist, and radio questions. If the question is taken from question bank, this value will be copied from Question_vod.  Weights and response text can all be edited and will not change the que'),
   required(false),
   max_length(6000),
   help_content(),
   list_column(false),
   order(10),
   no_copy(false),
   lookup_relationship_name(),
   lookup_source_field(),
   encrypted(false),
   editable(true),
   control_binding()
);