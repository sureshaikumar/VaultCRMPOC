Field reset_crm_password__v (
   label('Reset CRM Password'),
   type('Boolean'),
   active(true),
   description(),
   required(false),
   checkbox(false),
   help_content('Setting to "Yes" will send a password reset email to the user on the next push to CRM the roster member is included in (except where email address has changed). This value will be set back to "No" after the Push to CRM.'),
   list_column(false),
   order(72),
   default_value('false'),
   no_copy(false),
   lookup_relationship_name(),
   lookup_source_field(),
   encrypted(false),
   editable(true),
   control_binding()
);