   description('This agent retrospectively analyzes end users'' text inputs for potential compliance concerns.'),
   document_type(),
   model_level('ADVANCED'),
   object(),
   object_type(),
   objective(@objective.txt),
   supplemental_objective(),
   Agentaction(@Agentaction/home_office_text_monitoring__v.mdl)
);