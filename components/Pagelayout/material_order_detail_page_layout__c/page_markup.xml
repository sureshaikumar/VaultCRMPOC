<vault:page xmlns:vault="VeevaVault" controller="Object.material_order__c">
    <vault:section title="Details" name="details__c">
        <vault:detailform type="Two-Columns">
            <vault:field reference="name__v" />
            <vault:field reference="date__c" />
            <vault:field reference="ownerid__v" />
            <vault:field reference="priority__c" />
            <vault:field reference="lifecycle__v" />
            <vault:field reference="state__v" />
            <vault:field reference="state_stage_id__sys" />
            <vault:field reference="stage__sys" />
            <vault:field reference="description__c" />
        </vault:detailform>
    </vault:section>
    <vault:section title="Material Order Line Items" name="material_order_line_items__c">
        <vault:relatedObject relationship="material_order_line_item__cr" preventRecordCreate="false" modalCreateRecord="true">
            <vault:field reference="name__v" width="200px" />
            <vault:field reference="products__c" width="200px" />
            <vault:field reference="quantity__c" width="200px" />
        </vault:relatedObject>
    </vault:section>
    <vault:section title="Attachments" name="attachments__v">
        <vault:attachments />
    </vault:section>
    <vault:section title="Sytem Information" name="sys_info__c">
        <vault:detailform type="Two-Columns">
            <vault:field reference="created_by__v" />
            <vault:field reference="modified_by__v" />
            <vault:field reference="status__v" />
            <vault:field reference="created_date__v" />
            <vault:field reference="modified_date__v" />
        </vault:detailform>
    </vault:section>
    <vault:section title="Workflow Timeline" name="workflow_timeline__v">
        <vault:wftimeline />
    </vault:section>
</vault:page>