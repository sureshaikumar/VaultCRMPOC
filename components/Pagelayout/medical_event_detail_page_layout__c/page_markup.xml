<vault:page xmlns:vault="VeevaVault" controller="Objecttype.medical_event__v.base__v">
    <vault:section title="Details" name="details__c">
        <vault:detailform type="Two-Columns">
            <vault:field reference="name__v" />
            <vault:field reference="location__v" />
            <vault:field reference="description__v" />
            <vault:field reference="active__v" />
            <vault:field reference="event_type__v" />
            <vault:field reference="website__v" />
            <vault:field reference="city__v" />
            <vault:field reference="event_identifier__v" />
            <vault:field reference="start_time__v" />
            <vault:field reference="end_time__v" />
            <vault:field reference="location_address_line_2__v" />
            <vault:field reference="location_address__v" />
            <vault:field reference="postal_code__v" />
            <vault:field reference="state_province__v" />
            <vault:field reference="primary_product__v" />
            <vault:field reference="secondary_product__v" />
        </vault:detailform>
    </vault:section>
    <vault:section title="Product Information" name="product_information__c">
        <vault:detailform type="Two-Columns" />
    </vault:section>
    <vault:section title="Event Attendees" name="event_attendees__c">
        <vault:relatedObject relationship="event_attendee__vr" preventRecordCreate="false" modalCreateRecord="true">
            <vault:field reference="name__v" width="200px" />
            <vault:field reference="attendee_name__v" width="200px" />
            <vault:field reference="attendee_type__v" width="200px" />
            <vault:field reference="status__v" width="200px" />
            <vault:field reference="modified_date__v" width="200px" />
            <vault:field reference="signature_datetime__v" width="200px" />
        </vault:relatedObject>
    </vault:section>
    <vault:section title="Calls" name="calls__c">
        <vault:relatedObject relationship="call2__vr" preventRecordCreate="false" modalCreateRecord="true">
            <vault:field reference="name__v" width="200px" />
            <vault:field reference="call_datetime__v" width="200px" />
            <vault:field reference="object_type__v" width="200px" />
            <vault:field reference="state_province__v" width="200px" />
            <vault:field reference="account__v" width="200px" />
        </vault:relatedObject>
    </vault:section>
    <vault:section title="Call Discussions" name="call_discussions__c">
        <vault:relatedObject relationship="call2_discussion__vr" preventRecordCreate="false" modalCreateRecord="true">
            <vault:field reference="name__v" width="200px" />
            <vault:field reference="call_date__v" width="200px" />
            <vault:field reference="activity__c" width="200px" />
            <vault:field reference="product__v" width="200px" />
            <vault:field reference="discussion_topics__c" width="200px" />
            <vault:field reference="account__v" width="200px" />
        </vault:relatedObject>
    </vault:section>
    <vault:section title="Attachments" name="attachments__v">
        <vault:attachments />
    </vault:section>
    <vault:section title="System Information" name="sys_info__c">
        <vault:detailform type="Two-Columns">
            <vault:field reference="created_by__v" />
            <vault:field reference="modified_by__v" />
            <vault:field reference="status__v" />
            <vault:field reference="created_date__v" />
            <vault:field reference="modified_date__v" />
        </vault:detailform>
    </vault:section>
</vault:page>