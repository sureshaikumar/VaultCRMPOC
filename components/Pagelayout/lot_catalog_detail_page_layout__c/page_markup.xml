<vault:page xmlns:vault="VeevaVault" controller="Object.lot_catalog__v">
    <vault:section title="Details" name="details__c">
        <vault:detailform type="Two-Columns">
            <vault:field reference="name__v" />
            <vault:field reference="sample_description__v" />
            <vault:field reference="item_id__v" />
            <vault:field reference="suppress_lot__v" />
            <vault:field reference="product__v" />
            <vault:field reference="expiration_date__v" />
            <vault:field reference="u_m__v" />
            <vault:field reference="active__v" />
            <vault:spacer />
            <vault:spacer />
            <vault:field reference="sample__v" />
        </vault:detailform>
    </vault:section>
    <vault:section title="Sytem Information" name="sys_info__c">
        <vault:detailform type="Two-Columns">
            <vault:field reference="created_by__v" />
            <vault:field reference="modified_by__v" />
