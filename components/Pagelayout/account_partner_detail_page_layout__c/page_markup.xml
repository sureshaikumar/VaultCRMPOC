<vault:page xmlns:vault="VeevaVault" controller="Objecttype.account_partner__v.base__v">
    <vault:section title="Details" name="details__c">
        <vault:detailform type="Two-Columns">
            <vault:field reference="name__v" />
            <vault:field reference="object_type__v" />
            <vault:field reference="order_type__v" />
            <vault:field reference="account__v" />
            <vault:field reference="contract__v" />
            <vault:field reference="ownerid__v" />
        </vault:detailform>
    </vault:section>
    <vault:section title="Orders (Price Book)" name="orders_price_book__c">
        <vault:relatedObject relationship="orders__vr" preventRecordCreate="false" modalCreateRecord="false">
            <vault:field reference="name__v" width="195px" />
            <vault:field reference="account__v" width="195px" />
            <vault:field reference="price_book__v" width="195px" />
            <vault:field reference="status__v" width="195px" />
        </vault:relatedObject>
    </vault:section>
    <vault:section title="Orders (Account Partner)" name="orders_account_partner__c">
        <vault:relatedObject relationship="account_payer_wholesaler__vr" preventRecordCreate="false" modalCreateRecord="false">
            <vault:field reference="name__v" width="195px" />
            <vault:field reference="account__v" width="195px" />
            <vault:field reference="price_book__v" width="195px" />
            <vault:field reference="status__v" width="195px" />
        </vault:relatedObject>
    </vault:section>
    <vault:section title="System Information" name="sys_info__c">
        <vault:detailform type="Two-Columns">
            <vault:field reference="created_by__v" />
            <vault:field reference="modified_by__v" />
            <vault:field reference="status__v" />
            <vault:field reference="created_date__v" />
            <vault:field reference="modified_date__v" />
        </vault:detailform>
    </vault:section>
</vault:page>