<vault:page xmlns:vault="VeevaVault" controller="Objecttype.pricing_rule__v.base__v">
    <vault:section title="Details" name="details__c">
        <vault:detailform type="Two-Columns">
            <vault:field reference="name__v" />
            <vault:field reference="start_date__v" />
            <vault:field reference="end_date__v" />
            <vault:field reference="object_type__v" />
            <vault:field reference="list_price__v" />
            <vault:field reference="local_currency__sys" />
            <vault:field reference="account__v" />
            <vault:field reference="contract__v" />
            <vault:field reference="product__v" />
            <vault:field reference="active__v" />
            <vault:field reference="limit_bound__v" />
            <vault:field reference="quantity_min__v" />
            <vault:field reference="quantity_max__v" />
            <vault:field reference="order_campaign__v" />
        </vault:detailform>
    </vault:section>
    <vault:section title="Pricing Subrules" name="pricing_subrules__c">
