<vault:page xmlns:vault="VeevaVault" controller="Objecttype.em_stage_configuration__v.base__v">
    <vault:section title="Details" name="details__c">
        <vault:detailform type="Two-Columns">
            <vault:field reference="name__v" />
            <vault:field reference="stage__v" />
            <vault:field reference="event_rule__v" />
        </vault:detailform>
    </vault:section>
    <vault:section title="Statuses" name="statuses__c">
        <vault:detailform type="One-Column">
