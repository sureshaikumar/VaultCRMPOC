<vault:page xmlns:vault="VeevaVault" controller="Object.integration__sys">
    <vault:section title="Details" name="details__c">
        <vault:detailform type="Two-Columns">
            <vault:field reference="connection__sys" />
            <vault:field reference="connection_status__sys" />
            <vault:field reference="name__v" />
            <vault:field reference="integration_api_name__sys" />
            <vault:field reference="remote_vault_integration__sys" />
            <vault:field reference="remote_vault_integration_name__sys" />
            <vault:field reference="remote_vault_integration_id__sys" />
            <vault:field reference="last_successful_run__sys" />
        </vault:detailform>
    </vault:section>
    <vault:section title="Integration Points - Outbound" name="integration_points_outbound_section__c">
        <vault:relatedObject relationship="integration_points__sysr" preventRecordCreate="false" modalCreateRecord="false">
            <vault:vqlFilterCriteria query="object_type__vr.api_name__v = 'outbound__sys'" applyOnCreate="true" />
            <vault:field reference="name__v" width="200px" />
            <vault:field reference="integration_point_api_name__sys" width="200px" />
            <vault:field reference="description__sys" width="200px" />
        </vault:relatedObject>
    </vault:section>
    <vault:section title="Integration Points - Inbound" name="integration_points_inbound_section__c">
        <vault:relatedObject relationship="integration_points__sysr" preventRecordCreate="false" modalCreateRecord="false">
            <vault:vqlFilterCriteria query="object_type__vr.api_name__v = 'inbound__sys'" applyOnCreate="true" />
            <vault:field reference="name__v" width="200px" />
            <vault:field reference="integration_point_api_name__sys" width="200px" />
            <vault:field reference="description__sys" width="200px" />
        </vault:relatedObject>
    </vault:section>
    <vault:section title="System Information" name="sys_info__c">
        <vault:detailform type="Two-Columns">
            <vault:field reference="created_by__v" />
            <vault:field reference="modified_by__v" />
            <vault:field reference="status__v" />
            <vault:field reference="created_date__v" />
            <vault:field reference="modified_date__v" />
        </vault:detailform>
    </vault:section>
</vault:page>