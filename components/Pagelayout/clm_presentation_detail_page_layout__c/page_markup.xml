<vault:page xmlns:vault="VeevaVault" controller="Object.clm_presentation__v">
    <vault:section title="Details" name="details__c">
        <vault:detailform type="Two-Columns">
            <vault:field reference="name__v" />
            <vault:field reference="description__v" />
            <vault:field reference="product__v" />
            <vault:field reference="detail_group__v" />
            <vault:field reference="clm_presentation_status__v" />
            <vault:field reference="version__v" />
            <vault:field reference="keywords__v" />
            <vault:field reference="directory__v" />
            <vault:field reference="start_date__v" />
            <vault:field reference="end_date__v" />
            <vault:field reference="total_slides__v" />
            <vault:field reference="hidden__v" />
            <vault:field reference="legacy_ipad_content_mode__v" />
            <vault:field reference="ownerid__v" />
            <vault:field reference="language__v" />
            <vault:field reference="type__v" />
        </vault:detailform>
    </vault:section>
    <vault:section title="Integration Details" name="integration_details__c" helpContent="Details on the source Vault for the Presentation">
        <vault:detailform type="Two-Columns">
            <vault:field reference="approved__v" />
            <vault:field reference="mobile_id__v" />
            <vault:field reference="id" />
            <vault:field reference="original_record_id__v" />
            <vault:field reference="legacy_crm_id__v" />
            <vault:field reference="presentation_id__v" />
            <vault:field reference="vault_last_modified_date_time__v" />
            <vault:field reference="vault_dns__v" />
            <vault:field reference="vault_doc_id__v" />
            <vault:field reference="vault_external_id__v" />
            <vault:field reference="vault_guid__v" />
            <vault:field reference="vexternal_id__v" />
            <vault:field reference="copied_from__v" />
            <vault:field reference="copy_date__v" />
        </vault:detailform>
    </vault:section>
    <vault:section title="Presentation Slides (CLM Presentation)" name="presentation_slides_clm_presentation__c">
        <vault:relatedObject relationship="clm_presentation_slide__vr" preventRecordCreate="false" modalCreateRecord="true">
            <vault:field reference="name__v" width="200px" />
            <vault:field reference="key_message__v" width="200px" />
            <vault:field reference="display_order__v" width="200px" />
        </vault:relatedObject>
    </vault:section>
    <vault:section title="System Information" name="sys_info__c">
        <vault:detailform type="Two-Columns">
            <vault:field reference="created_by__v" />
            <vault:field reference="modified_by__v" />
            <vault:field reference="status__v" />
            <vault:field reference="created_date__v" />
            <vault:field reference="modified_date__v" />
        </vault:detailform>
    </vault:section>
</vault:page>