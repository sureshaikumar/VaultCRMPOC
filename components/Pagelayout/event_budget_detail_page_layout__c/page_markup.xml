<vault:page xmlns:vault="VeevaVault" controller="Objecttype.em_event_budget__v.base__v">
    <vault:section title="Details" name="details__c">
        <vault:detailform type="Two-Columns">
            <vault:field reference="name__v" />
            <vault:field reference="event__v" />
            <vault:field reference="budget__v" />
            <vault:spacer />
            <vault:spacer />
            <vault:field reference="ownerid__v" />
            <vault:field reference="estimate__v" />
            <vault:field reference="committed__v" />
            <vault:field reference="actual__v" />
            <vault:field reference="estimated_remaining__v" />
            <vault:field reference="lifecycle__v" />
            <vault:field reference="state__v" />
            <vault:field reference="state_stage_id__sys" />
            <vault:field reference="stage__sys" />
        </vault:detailform>
    </vault:section>
    <vault:section title="Expense Estimates" name="expense_estimates__c">
        <vault:relatedObject relationship="em_expense_estimate__vr" preventRecordCreate="false" modalCreateRecord="true">
            <vault:field reference="name__v" width="200px" />
            <vault:field reference="expense_type_name__v" width="200px" />
            <vault:field reference="estimate__v" width="200px" />
        </vault:relatedObject>
    </vault:section>
    <vault:section title="Expense Lines" name="expense_lines__c">
        <vault:relatedObject relationship="expense_line_expense_budgets__vr" preventRecordCreate="false" modalCreateRecord="true">
            <vault:field reference="name__v" width="200px" />
            <vault:field reference="expense_type_name__v" width="200px" />
            <vault:field reference="committed__v" width="200px" />
            <vault:field reference="actual__v" width="200px" />
        </vault:relatedObject>
    </vault:section>
    <vault:section title="System Information" name="sys_info__c">
        <vault:detailform type="Two-Columns">
            <vault:field reference="created_by__v" />
            <vault:field reference="modified_by__v" />
            <vault:field reference="status__v" />
            <vault:field reference="created_date__v" />
            <vault:field reference="modified_date__v" />
        </vault:detailform>
    </vault:section>
    <vault:section title="Attachments" name="attachments__v">
        <vault:attachments />
    </vault:section>
    <vault:section title="Workflow Timeline" name="workflow_timeline__v">
        <vault:wftimeline />
    </vault:section>
</vault:page>