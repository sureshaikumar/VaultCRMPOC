        <vault:detailform type="Two-Columns">
            <vault:field reference="name__v" />
            <vault:field reference="display_order__v" />
            <vault:field reference="applies_to__v" />
            <vault:field reference="active__v" />
            <vault:field reference="detail_topic__v" />
            <vault:field reference="metric_type__v" />
            <vault:field reference="red_yellow__v" />
            <vault:field reference="yellow_green__v" />
            <vault:field reference="product__v" />
            <vault:field reference="detail_group__v" />
