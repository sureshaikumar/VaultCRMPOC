<vault:page xmlns:vault="VeevaVault" controller="Object.clm_presentation_slide__v">
    <vault:section title="Details" name="details__c">
        <vault:detailform type="Two-Columns">
            <vault:field reference="name__v" />
            <vault:field reference="clm_presentation__v" />
            <vault:field reference="key_message__v" />
            <vault:field reference="display_order__v" />
            <vault:field reference="external_id__v" />
            <vault:field reference="mandatory_slides__v" />
            <vault:field reference="mobile_id__v" />
            <vault:field reference="vexternal_id__v" />
            <vault:field reference="sub_presentation__v" />
        </vault:detailform>
    </vault:section>
    <vault:section title="System Information" name="sys_info__c">
        <vault:detailform type="Two-Columns">
            <vault:field reference="created_by__v" />
            <vault:field reference="modified_by__v" />
            <vault:field reference="status__v" />
            <vault:field reference="created_date__v" />
            <vault:field reference="modified_date__v" />
        </vault:detailform>
    </vault:section>
</vault:page>