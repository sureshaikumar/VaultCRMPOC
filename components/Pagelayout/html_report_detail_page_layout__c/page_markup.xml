<vault:page xmlns:vault="VeevaVault" controller="Objecttype.html_report__v.base__v">
    <vault:section title="Details" name="details__c">
        <vault:detailform type="Two-Columns">
            <vault:field reference="name__v" />
            <vault:field reference="description__v" />
            <vault:field reference="object_type__v" />
            <vault:field reference="platform__v" />
            <vault:field reference="object_recordtype__v" />
            <vault:field reference="sharing_group__v" />
            <vault:field reference="visibility_criteria__v" />
            <vault:field reference="external_id__v" />
            <vault:field reference="profile__v" />
            <vault:field reference="application_profile__v" />
            <vault:field reference="target_platform__v" />
            <vault:spacer />
        </vault:detailform>
    </vault:section>
    <vault:section title="Publishing Information" name="details1__c">
        <vault:detailform type="Two-Columns">
            <vault:field reference="html_report_status__v" />
            <vault:field reference="publish_process_timestamp__v" />
        </vault:detailform>
    </vault:section>
    <vault:section title="Studio Information" name="details2__c">
        <vault:detailform type="Two-Columns">
            <vault:field reference="studio_version__v" />
            <vault:field reference="studio_id__v" />
        </vault:detailform>
    </vault:section>
    <vault:section title="Attachments" name="attachments__v">
        <vault:attachments />
    </vault:section>
    <vault:section title="System Information" name="sys_info__c">
        <vault:detailform type="Two-Columns">
            <vault:field reference="created_by__v" />
            <vault:field reference="modified_by__v" />
            <vault:field reference="status__v" />
            <vault:field reference="created_date__v" />
            <vault:field reference="modified_date__v" />
        </vault:detailform>
    </vault:section>
</vault:page>