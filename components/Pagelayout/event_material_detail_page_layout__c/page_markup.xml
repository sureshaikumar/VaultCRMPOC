<vault:page xmlns:vault="VeevaVault" controller="Objecttype.em_event_material__v.base__v">
    <vault:section title="Details" name="details__c">
        <vault:detailform type="One-Column">
            <vault:field reference="material__v" />
            <vault:field reference="approved__v" />
            <vault:field reference="em_print_generation_status__v" />
            <vault:field reference="em_print_generation_error__v" />
            <vault:field reference="event_material_name__v" />
            <vault:field reference="lifecycle__v" />
            <vault:field reference="state__v" />
            <vault:field reference="state_stage_id__sys" />
            <vault:field reference="stage__sys" />
        </vault:detailform>
    </vault:section>
    <vault:section title="Material Details" name="material_details__c">
        <vault:detailform type="Two-Columns">
            <vault:field reference="name__v" />
            <vault:field reference="external_id__v" />
            <vault:field reference="description__v" />
            <vault:field reference="current_material_status__v" />
        </vault:detailform>
    </vault:section>
    <vault:section title="System Information" name="sys_info__c">
        <vault:detailform type="Two-Columns">
            <vault:field reference="created_by__v" />
            <vault:field reference="modified_by__v" />
            <vault:field reference="status__v" />
            <vault:field reference="created_date__v" />
            <vault:field reference="modified_date__v" />
        </vault:detailform>
    </vault:section>
    <vault:section title="Attachments" name="attachments__v">
        <vault:attachments />
    </vault:section>
    <vault:section title="Workflow Timeline" name="workflow_timeline__v">
        <vault:wftimeline />
    </vault:section>
</vault:page>