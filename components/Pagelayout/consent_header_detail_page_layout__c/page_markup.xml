<vault:page xmlns:vault="VeevaVault" controller="Objecttype.consent_header__v.base__v">
    <vault:section title="Details" name="details__c">
        <vault:detailform type="Two-Columns">
            <vault:field reference="name__v" />
            <vault:field reference="object_type__v" />
            <vault:field reference="allow_confirmation_by_email__v" />
            <vault:field reference="approved_email_consent_level__v" />
            <vault:field reference="consent_header_help_text__v" />
            <vault:field reference="inactive_datetime__v" />
            <vault:field reference="reject_channel_source_edit_on_cancel__v" />
            <vault:field reference="request_receipt__v" />
            <vault:field reference="signature_required_on_opt_out__v" />
            <vault:field reference="consent_header_status__v" />
            <vault:field reference="subscription_option__v" />
            <vault:field reference="ownerid__v" />
            <vault:field reference="lifecycle__v" />
            <vault:field reference="state__v" />
            <vault:field reference="state_stage_id__sys" />
            <vault:field reference="stage__sys" />
            <vault:field reference="country__v" />
            <vault:field reference="language__v" />
        </vault:detailform>
    </vault:section>
    <vault:section title="Consent Types" name="consent_types__c">
        <vault:relatedObject relationship="consent_type__vr" preventRecordCreate="false" modalCreateRecord="false">
            <vault:field reference="name__v" width="200px" />
        </vault:relatedObject>
    </vault:section>
    <vault:section title="System Information" name="sys_info__c">
        <vault:detailform type="Two-Columns">
            <vault:field reference="created_by__v" />
            <vault:field reference="modified_by__v" />
            <vault:field reference="status__v" />
            <vault:field reference="created_date__v" />
            <vault:field reference="modified_date__v" />
        </vault:detailform>
    </vault:section>
    <vault:section title="Workflow Timeline" name="workflow_timeline__v">
        <vault:wftimeline />
    </vault:section>
</vault:page>