<vault:page xmlns:vault="VeevaVault" controller="Object.glossary_definition__sys">
    <vault:section title="Details" name="details__c">
        <vault:detailform type="One-Column">
            <vault:field reference="name__v" />
            <vault:field reference="glossary_definition_text__sys" />
            <vault:field reference="glossary_definition_language__sys" />
            <vault:field reference="glossary_related_english_definition__sys" />
        </vault:detailform>
    </vault:section>
    <vault:section title="Related Definitions" name="related_definitions__v">
        <vault:relatedObject relationship="definitions__sysr" preventRecordCreate="false" modalCreateRecord="false">
            <vault:field reference="name__v" width="200px" />
            <vault:field reference="glossary_definition_language__sys" width="200px" />
            <vault:field reference="state__v" width="200px" />
            <vault:field reference="created_by__v" width="200px" />
            <vault:field reference="created_date__v" width="200px" />
            <vault:field reference="modified_by__v" width="200px" />
            <vault:field reference="modified_date__v" width="200px" />
        </vault:relatedObject>
    </vault:section>
    <vault:section title="Workflow Timeline" name="workflow_timeline__v">
        <vault:wftimeline />
    </vault:section>
    <vault:section title="System Information" name="sys_info__c">
        <vault:detailform type="Two-Columns">
            <vault:field reference="created_by__v" />
            <vault:field reference="modified_by__v" />
            <vault:field reference="state__v" />
            <vault:field reference="created_date__v" />
            <vault:field reference="modified_date__v" />
        </vault:detailform>
    </vault:section>
</vault:page>