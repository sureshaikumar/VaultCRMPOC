<vault:page xmlns:vault="VeevaVault" controller="Object.doc_type_detail__v">
    <vault:section title="Details" name="details__c">
        <vault:detailform type="One-Column">
            <vault:field reference="name__v" />
            <vault:field reference="status__v" />
            <vault:field reference="external_id__v" />
            <vault:field reference="level__v" />
            <vault:field reference="type__v" />
            <vault:field reference="subtype__v" />
            <vault:field reference="group_inherited__v" />
            <vault:field reference="is_leaf__v" />
            <vault:field reference="enabled__v" />
            <vault:field reference="document_type_name__v" />
        </vault:detailform>
    </vault:section>
    <vault:section title="Subtypes and Classifications for Type" name="subtypes_and_classifications_for_type__c">
        <vault:relatedObject relationship="subtype_classification__vr" preventRecordCreate="false" modalCreateRecord="false">
            <vault:field reference="name__v" width="200px" />
            <vault:field reference="level__v" width="200px" />
            <vault:field reference="type__v" width="200px" />
            <vault:field reference="subtype__v" width="200px" />
        </vault:relatedObject>
    </vault:section>
    <vault:section title="Classifications for Subtype" name="classifications_for_subtype__c">
        <vault:relatedObject relationship="classification__vr" preventRecordCreate="false" modalCreateRecord="false">
            <vault:field reference="name__v" width="200px" />
            <vault:field reference="level__v" width="200px" />
            <vault:field reference="type__v" width="200px" />
            <vault:field reference="subtype__v" width="200px" />
        </vault:relatedObject>
    </vault:section>
    <vault:section title="System Information" name="sys_info__c">
        <vault:detailform type="Two-Columns">
            <vault:field reference="created_by__v" />
            <vault:field reference="modified_by__v" />
            <vault:field reference="created_date__v" />
            <vault:field reference="modified_date__v" />
        </vault:detailform>
    </vault:section>
</vault:page>