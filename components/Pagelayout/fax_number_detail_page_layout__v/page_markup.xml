<vault:page xmlns:vault="VeevaVault" controller="Object.fax_number__v">
    <vault:section title="Details" name="details__v">
        <vault:detailform type="Two-Columns">
            <vault:field reference="name__v" />
            <vault:field reference="status__v" />
            <vault:field reference="fax_number__v" />
            <vault:field reference="fax_direction__v" />
            <vault:field reference="service_status__v" />
            <vault:field reference="created_by__v" />
            <vault:field reference="created_date__v" />
            <vault:field reference="modified_by__v" />
            <vault:field reference="modified_date__v" />
        </vault:detailform>
    </vault:section>
    <vault:section title="Fax Templates" name="fax_templates__v">
        <vault:relatedDocument referenceField="from_fax_number__v" preventDocumentAdd="false">
            <vault:field reference="name__v" width="200px" />
            <vault:field reference="document_number__v" width="200px" />
            <vault:field reference="status__v" width="200px" />
        </vault:relatedDocument>
    </vault:section>
</vault:page>