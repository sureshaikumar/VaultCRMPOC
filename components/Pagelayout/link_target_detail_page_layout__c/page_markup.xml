        <vault:detailform type="One-Column">
            <vault:field reference="name__v" />
            <vault:field reference="suggestedlink_link_target_type__v" />
            <vault:field reference="document_id__v" />
            <vault:field reference="anchor_id__sys" />
            <vault:field reference="anchor_title__sys" />
            <vault:field reference="anchor_page__sys" />
            <vault:field reference="target__sys" />
        </vault:detailform>
    </vault:section>
    <vault:section title="Sytem Information" name="sys_info__c">
