<vault:page xmlns:vault="VeevaVault" controller="Objecttype.contract__v.base__v">
    <vault:section title="Details" name="details__c">
        <vault:detailform type="Two-Columns">
            <vault:field reference="name__v" />
            <vault:field reference="start_date__v" />
            <vault:field reference="end_date__v" />
            <vault:field reference="object_type__v" />
            <vault:field reference="disclaimer__v" />
            <vault:field reference="contract_status__v" />
            <vault:field reference="call_objective__v" />
        </vault:detailform>
    </vault:section>
    <vault:section title="Attachments" name="attachments__v">
        <vault:attachments />
    </vault:section>
    <vault:section title="Contract Lines" name="contract_lines__c">
        <vault:relatedObject relationship="contract_lines__vr" preventRecordCreate="false" modalCreateRecord="true">
            <vault:field reference="name__v" width="199px" />
            <vault:field reference="product__v" width="199px" />
            <vault:field reference="em_rate__v" width="199px" />
            <vault:field reference="start_date__v" width="199px" />
            <vault:field reference="end_date__v" width="199px" />
            <vault:field reference="status__v" width="199px" />
        </vault:relatedObject>
    </vault:section>
    <vault:section title="Contract Partners" name="contract_partners__c">
        <vault:relatedObject relationship="contract_partners__vr" preventRecordCreate="false" modalCreateRecord="false">
            <vault:field reference="name__v" width="199px" />
            <vault:field reference="account__v" width="199px" />
            <vault:field reference="signature_datetime__v" width="199px" />
            <vault:field reference="contract_partner_status__v" width="199px" />
            <vault:field reference="created_by__v" width="199px" />
        </vault:relatedObject>
    </vault:section>
    <vault:section title="Inventory Monitorings" name="inventory_monitorings__c">
        <vault:relatedObject relationship="inventory_monitorings__vr" preventRecordCreate="false" modalCreateRecord="false">
            <vault:field reference="name__v" width="199px" />
            <vault:field reference="account__v" width="199px" />
            <vault:field reference="datetime__v" width="199px" />
            <vault:field reference="notes__v" width="199px" />
            <vault:field reference="status__v" width="199px" />
        </vault:relatedObject>
    </vault:section>
    <vault:section title="Orders" name="orders__c">
        <vault:relatedObject relationship="orders__vr" preventRecordCreate="false" modalCreateRecord="false">
            <vault:field reference="name__v" width="199px" />
            <vault:field reference="account__v" width="199px" />
            <vault:field reference="contract__v" width="199px" />
            <vault:field reference="created_date__v" width="199px" />
            <vault:field reference="last_inventory_monitoring__v" width="199px" />
            <vault:field reference="order_date__v" width="199px" />
            <vault:field reference="order_status__v" width="199px" />
        </vault:relatedObject>
    </vault:section>
    <vault:section title="System Information" name="sys_info__c">
        <vault:detailform type="Two-Columns">
            <vault:field reference="created_by__v" />
            <vault:field reference="modified_by__v" />
            <vault:field reference="status__v" />
            <vault:field reference="created_date__v" />
            <vault:field reference="modified_date__v" />
        </vault:detailform>
    </vault:section>
    <vault:section title="Workflow Timeline" name="workflow_timeline__v">
        <vault:wftimeline />
    </vault:section>
</vault:page>