<vault:page xmlns:vault="VeevaVault" controller="Objecttype.outbound_package__v.migration__sys">
    <vault:section title="Details" name="details__c">
        <vault:detailform type="Two-Columns">
            <vault:field reference="name__v" />
            <vault:field reference="status__v" />
            <vault:field reference="summary__v" />
            <vault:field reference="description__v" />
            <vault:field reference="object_type__v" />
            <vault:field reference="owner__v" />
            <vault:field reference="created_date__v" />
            <vault:field reference="modified_date__v" />
            <vault:field reference="target_vault__v" />
            <vault:control reference="outbound_package_vault_id_control__sys" name="outbound_package_vault_id_control__c" />
        </vault:detailform>
    </vault:section>
    <vault:section title="Components" name="components__c">
        <vault:relatedObject relationship="package_component__vr" preventRecordCreate="false" modalCreateRecord="false">
            <vault:field reference="vault_component__vr.name__v" width="180px" />
            <vault:field reference="vault_component__vr.component_name__v" width="180px" />
            <vault:field reference="vault_component__vr.component_type__v" width="180px" />
            <vault:field reference="vault_component__vr.modified_date__v" width="180px" />
        </vault:relatedObject>
    </vault:section>
    <vault:section title="Data" name="data_set__c" reference="outbound_package_data_section_control__v" />
    <vault:section title="Code" name="code__c">
        <vault:detailform type="One-Column">
            <vault:field reference="include_java_sdk_code__sys" />
            <vault:field reference="java_sdk_deployment_option__sys" />
        </vault:detailform>
    </vault:section>
    <vault:section title="Settings" name="settings__c" reference="package_setting_section_control__v" />
    <vault:section title="Packages" name="attachments__v">
        <vault:attachments />
    </vault:section>
</vault:page>