<vault:page xmlns:vault="VeevaVault" controller="Object.document_usage__v">
    <vault:section title="Details" name="details__c">
        <vault:detailform type="One-Column">
            <vault:field reference="name__v" />
            <vault:field reference="activity_date__v" />
            <vault:field reference="activity_type__v" />
            <vault:field reference="channel__v" />
            <vault:field reference="context__v" />
            <vault:field reference="document_id__v" />
            <vault:field reference="document_type__v" />
            <vault:field reference="user__v" />
        </vault:detailform>
    </vault:section>
    <vault:section title="System Information" name="sys_info__c">
        <vault:detailform type="Two-Columns">
            <vault:field reference="created_by__v" />
            <vault:field reference="modified_by__v" />
            <vault:field reference="status__v" />
            <vault:field reference="created_date__v" />
            <vault:field reference="modified_date__v" />
        </vault:detailform>
    </vault:section>
</vault:page>