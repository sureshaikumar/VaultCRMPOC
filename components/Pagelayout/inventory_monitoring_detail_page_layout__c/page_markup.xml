<vault:page xmlns:vault="VeevaVault" controller="Objecttype.inventory_monitoring__v.base__v">
    <vault:section title="Details" name="details__c">
        <vault:detailform type="Two-Columns">
            <vault:field reference="name__v" />
            <vault:field reference="datetime__v" />
            <vault:field reference="notes__v" />
            <vault:field reference="inventory_monitoring_status__v" />
            <vault:field reference="account__v" />
            <vault:field reference="object_type__v" />
            <vault:field reference="contract__v" />
        </vault:detailform>
    </vault:section>
    <vault:section title="Inventory Monitoring Lines" name="inventory_monitoring_lines__c">
        <vault:relatedObject relationship="inventory_monitoring_lines__vr" preventRecordCreate="false" modalCreateRecord="true">
            <vault:field reference="name__v" width="200px" />
            <vault:field reference="product__v" width="200px" />
            <vault:field reference="inventory__v" width="200px" />
            <vault:field reference="position__v" width="200px" />
        </vault:relatedObject>
    </vault:section>
    <vault:section title="Attachments" name="attachments__v">
        <vault:attachments />
    </vault:section>
    <vault:section title="System Information" name="sys_info__c">
        <vault:detailform type="Two-Columns">
            <vault:field reference="created_by__v" />
            <vault:field reference="modified_by__v" />
            <vault:field reference="status__v" />
            <vault:field reference="created_date__v" />
            <vault:field reference="modified_date__v" />
        </vault:detailform>
    </vault:section>
    <vault:section title="Workflow Timeline" name="workflow_timeline__v">
        <vault:wftimeline />
    </vault:section>
</vault:page>