        <vault:detailform type="Two-Columns">
            <vault:field reference="name__v" />
            <vault:field reference="object_type__v" />
            <vault:field reference="account_plan__v" />
            <vault:field reference="product__v" />
            <vault:field reference="strengths__v" />
            <vault:field reference="weaknesses__v" />
            <vault:field reference="opportunities__v" />
            <vault:field reference="threats__v" />
