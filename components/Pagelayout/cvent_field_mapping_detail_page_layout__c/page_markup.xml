<vault:page xmlns:vault="VeevaVault" controller="Objecttype.cvent_field_mapping__v.base__v">
    <vault:section title="Details" name="details__c">
        <vault:detailform type="Two-Columns">
            <vault:field reference="name__v" />
            <vault:field reference="cvent_field__v" />
            <vault:field reference="object_type__v" />
            <vault:field reference="cvent_field_id__v" />
            <vault:field reference="external_id__v" />
            <vault:field reference="salesforce_field_api_name__v" />
            <vault:field reference="sync_direction__v" />
            <vault:field reference="cvent_object_mapping__v" />
            <vault:field reference="cvent_request_form__v" />
            <vault:field reference="ownerid__v" />
        </vault:detailform>
    </vault:section>
    <vault:section title="Cvent Value Mappings" name="cvent_value_mappings__c">
        <vault:relatedObject relationship="cvent_value_mappings__vr" preventRecordCreate="false" modalCreateRecord="true">
            <vault:field reference="name__v" width="200px" />
            <vault:field reference="cvent_value__v" width="200px" />
            <vault:field reference="salesforce_value__v" width="200px" />
        </vault:relatedObject>
    </vault:section>
    <vault:section title="System Information" name="sys_info__c">
        <vault:detailform type="Two-Columns">
            <vault:field reference="created_by__v" />
            <vault:field reference="modified_by__v" />
            <vault:field reference="status__v" />
            <vault:field reference="created_date__v" />
            <vault:field reference="modified_date__v" />
        </vault:detailform>
    </vault:section>
</vault:page>