            <vault:field reference="license_expiration_date__v" />
            <vault:field reference="license_status__v" />
            <vault:field reference="assmca__v" />
            <vault:field reference="dea__v" />
            <vault:field reference="dea_expiration_date__v" />
            <vault:field reference="ship_dea__v" />
            <vault:field reference="ship_dea_expiration_date__v" />
            <vault:field reference="ship_assmca__v" />
            <vault:field reference="call2_status__v" />
            <vault:field reference="call_type__v" />
            <vault:field reference="object_type__v" />
            <vault:field reference="call_date__v" />
            <vault:field reference="signature_date__v" />
            <vault:field reference="license__v" />
