<vault:page xmlns:vault="VeevaVault" controller="Object.pricing_subrule__v">
    <vault:section title="Details" name="details__c">
        <vault:detailform type="Two-Columns">
            <vault:field reference="name__v" />
            <vault:field reference="pricing_rule__v" />
            <vault:field reference="product__v" />
            <vault:field reference="comparison_type__v" />
            <vault:field reference="min_quantity__v" />
            <vault:field reference="max_quantity__v" />
            <vault:field reference="inventory_monitoring_field_value__v" />
            <vault:field reference="inventory_monitoring_line_field__v" />
        </vault:detailform>
    </vault:section>
    <vault:section title="System Information" name="sysinfo__c">
        <vault:detailform type="Two-Columns">
            <vault:field reference="created_by__v" />
            <vault:field reference="modified_by__v" />
            <vault:field reference="status__v" />
            <vault:field reference="created_date__v" />
            <vault:field reference="modified_date__v" />
        </vault:detailform>
    </vault:section>
</vault:page>