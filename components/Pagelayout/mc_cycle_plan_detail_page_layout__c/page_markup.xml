            <vault:field reference="territory__v" />
            <vault:field reference="ownerid__v" />
            <vault:field reference="start_date__v" />
            <vault:field reference="end_date__v" />
            <vault:field reference="days_total__v" />
            <vault:field reference="days_remaining__v" />
            <vault:field reference="percent_cycle_completed__v" />
            <vault:field reference="mc_cycle_plan_status__v" />
            <vault:field reference="lock__v" />
            <vault:field reference="cycle__v" />
            <vault:field reference="last_calculated__v" />
            <vault:spacer />
            <vault:spacer />
            <vault:spacer />
            <vault:field reference="aln_activity_goals__v" />
            <vault:field reference="aln_align_rule_id__v" />
            <vault:field reference="aln_legacy_align_id__v" />
            <vault:field reference="aln_targeting_id__v" />
            <vault:field reference="aln_territory_assigned_accounts__v" />
            <vault:field reference="aln_territory_model__v" />
