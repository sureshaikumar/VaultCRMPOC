    </vault:section>
    <vault:section title="Calculations" name="calculations__c">
        <vault:detailform type="Two-Columns">
            <vault:field reference="channel_interactions_goal__v" />
            <vault:field reference="channel_interactions_earned__v" />
            <vault:field reference="channel_interaction_attainment__v" />
            <vault:field reference="channel_interaction_status__v" />
            <vault:field reference="product_interactions_goal__v" />
            <vault:field reference="product_interactions_earned__v" />
            <vault:field reference="product_interaction_attainment__v" />
            <vault:field reference="product_interaction_status__v" />
        </vault:detailform>
    </vault:section>
    <vault:section title="Description" name="description__c">
        <vault:detailform type="One-Column">
            <vault:field reference="description__v" />
        </vault:detailform>
    </vault:section>
    <vault:section title="Cycle Plan Summary" name="cycle_plan_summary__c">
        <vault:relatedObject relationship="mc_cycle_plan_summaries__vr" preventRecordCreate="false" modalCreateRecord="true">
            <vault:field reference="name__v" width="200px" />
            <vault:field reference="object_type__v" width="200px" />
            <vault:field reference="summary_for__v" width="200px" />
            <vault:field reference="attainment__v" width="200px" />
        </vault:relatedObject>
    </vault:section>
    <vault:section title="MC Cycle Plan Targets" name="mc_cycle_plan_targets__c">
        <vault:relatedObject relationship="mc_cycle_plan_targets__vr" preventRecordCreate="false" modalCreateRecord="true">
            <vault:field reference="name__v" width="200px" />
            <vault:field reference="target__v" width="200px" />
            <vault:field reference="channel_attainment__v" width="200px" />
            <vault:field reference="channel_status__v" width="200px" />
            <vault:field reference="product_attainment__v" width="200px" />
            <vault:field reference="product_status__v" width="200px" />
        </vault:relatedObject>
    </vault:section>
    <vault:section title="System Information" name="sys_info__c">
        <vault:detailform type="Two-Columns">
            <vault:field reference="created_by__v" />
            <vault:field reference="modified_by__v" />
