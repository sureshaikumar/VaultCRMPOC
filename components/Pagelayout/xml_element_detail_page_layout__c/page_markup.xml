<vault:page xmlns:vault="VeevaVault" controller="Objecttype.xml_element__v.base__v">
    <vault:section title="Details" name="details__c">
        <vault:detailform type="One-Column">
            <vault:field reference="name__v" />
            <vault:field reference="element_name__v" />
            <vault:field reference="form_template__v" />
            <vault:field reference="form_template_unbound__v" />
            <vault:field reference="formula__v" />
            <vault:field reference="variable__v" />
            <vault:field reference="object_type__v" />
            <vault:field reference="parent__v" />
        </vault:detailform>
    </vault:section>
    <vault:section title="System Information" name="sys_info__c">
        <vault:detailform type="Two-Columns">
            <vault:field reference="created_by__v" />
            <vault:field reference="modified_by__v" />
            <vault:field reference="status__v" />
            <vault:field reference="created_date__v" />
            <vault:field reference="modified_date__v" />
        </vault:detailform>
    </vault:section>
</vault:page>