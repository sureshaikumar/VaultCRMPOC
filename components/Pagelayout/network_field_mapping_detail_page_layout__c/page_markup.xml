<vault:page xmlns:vault="VeevaVault" controller="Objecttype.network_field_mapping__v.base__v">
    <vault:section title="Details" name="details__c">
        <vault:detailform type="Two-Columns">
            <vault:field reference="name__v" />
            <vault:field reference="network_field_api_name__v" />
            <vault:field reference="crm_field_api_name__v" />
            <vault:field reference="object_type__v" />
            <vault:field reference="object_mapping_reference__v" />
            <vault:field reference="network_object_mapping__v" />
            <vault:field reference="validation_status__v" />
            <vault:field reference="validation_notes__v" />
            <vault:field reference="external_id__v" />
            <vault:spacer />
        </vault:detailform>
    </vault:section>
    <vault:section title="System Information" name="sys_info__c">
        <vault:detailform type="Two-Columns">
            <vault:field reference="created_by__v" />
            <vault:field reference="modified_by__v" />
            <vault:field reference="status__v" />
            <vault:field reference="created_date__v" />
            <vault:field reference="modified_date__v" />
        </vault:detailform>
    </vault:section>
    <vault:section title="Reference Mappings" name="reference_mappings__c">
        <vault:relatedObject relationship="network_reference_mappings__vr" preventRecordCreate="false" modalCreateRecord="false">
            <vault:field reference="name__v" width="200px" />
            <vault:field reference="network_reference_code__v" width="200px" />
            <vault:field reference="crm_picklist_value__v" width="200px" />
            <vault:field reference="crm_lookup_id__v" width="200px" />
            <vault:field reference="crm_record_type_name__v" width="200px" />
            <vault:field reference="direction__v" width="200px" />
            <vault:field reference="object_type__v" width="200px" />
            <vault:field reference="validation_status__v" width="200px" />
            <vault:field reference="validation_notes__v" width="200px" />
            <vault:field reference="external_id__v" width="200px" />
        </vault:relatedObject>
    </vault:section>
</vault:page>