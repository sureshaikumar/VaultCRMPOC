<vault:page xmlns:vault="VeevaVault" controller="Object.benefit_design__v">
    <vault:section title="Details" name="details__c">
        <vault:detailform type="Two-Columns">
            <vault:field reference="name__v" />
            <vault:field reference="external_id__v" />
            <vault:field reference="lives__v" />
            <vault:field reference="percent_lives__v" />
            <vault:field reference="primary_benefit_design__v" />
            <vault:field reference="type__v" />
            <vault:field reference="account__v" />
            <vault:field reference="parent_design__v" />
            <vault:field reference="ownerid__v" />
            <vault:field reference="account_name__v" />
            <vault:field reference="payer_id__v" />
            <vault:field reference="child_last_modified__v" />
        </vault:detailform>
    </vault:section>
    <vault:section title="Benefit Design Lines" name="benefit_design_lines__c">
        <vault:relatedObject relationship="benefit_design_line__vr" preventRecordCreate="false" modalCreateRecord="true">
            <vault:field reference="name__v" width="200px" />
            <vault:field reference="product__v" width="200px" />
            <vault:field reference="status_source__v" width="200px" />
            <vault:field reference="status__v" width="200px" />
            <vault:field reference="restrictions__v" width="200px" />
            <vault:field reference="restrictions_source__v" width="200px" />
            <vault:field reference="modified_date__v" width="200px" />
        </vault:relatedObject>
    </vault:section>
    <vault:section title="System Information" name="sys_info__c">
        <vault:detailform type="Two-Columns">
            <vault:field reference="created_by__v" />
            <vault:field reference="modified_by__v" />
            <vault:field reference="status__v" />
            <vault:field reference="created_date__v" />
            <vault:field reference="modified_date__v" />
        </vault:detailform>
    </vault:section>
</vault:page>