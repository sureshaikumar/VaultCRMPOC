<vault:page xmlns:vault="VeevaVault" controller="Object.network_mapping__v">
    <vault:section title="Details" name="details__c">
        <vault:detailform type="Two-Columns">
            <vault:field reference="name__v" />
            <vault:field reference="description__v" />
            <vault:field reference="active__v" />
            <vault:field reference="country__v" />
            <vault:field reference="validation_status__v" />
            <vault:field reference="validation_notes__v" />
            <vault:field reference="external_id__v" />
        </vault:detailform>
    </vault:section>
    <vault:section title="System Information" name="sys_info__c">
        <vault:detailform type="Two-Columns">
            <vault:field reference="created_by__v" />
            <vault:field reference="modified_by__v" />
            <vault:field reference="status__v" />
            <vault:field reference="created_date__v" />
            <vault:field reference="modified_date__v" />
        </vault:detailform>
    </vault:section>
    <vault:section title="Network Object Mappings" name="network_object_mappings__c">
        <vault:relatedObject relationship="network_object_mappings__vr" preventRecordCreate="false" modalCreateRecord="false">
            <vault:field reference="name__v" width="200px" />
            <vault:field reference="crm_object_api_name__v" width="200px" />
            <vault:field reference="network_object_api_name__v" width="200px" />
            <vault:field reference="external_id_api_name__v" width="200px" />
            <vault:field reference="person_account__v" width="200px" />
            <vault:field reference="validation_status__v" width="200px" />
            <vault:field reference="validation_notes__v" width="200px" />
            <vault:field reference="external_id__v" width="200px" />
        </vault:relatedObject>
    </vault:section>
</vault:page>