<vault:page xmlns:vault="VeevaVault" controller="Objecttype.homepage_widget__v.base__v">
    <vault:section title="Details" name="details__c">
        <vault:detailform type="Two-Columns">
            <vault:field reference="name__v" />
            <vault:field reference="homepage__v" />
            <vault:field reference="object_type__v" />
            <vault:field reference="row__v" />
            <vault:field reference="order__v" />
            <vault:field reference="widget_width__v" />
            <vault:field reference="max_height__v" />
            <vault:field reference="object__v" />
            <vault:field reference="rows_to_display__v" />
            <vault:field reference="text__v" />
            <vault:field reference="view__v" />
        </vault:detailform>
    </vault:section>
    <vault:section title="System Information" name="sys_info__c">
        <vault:detailform type="Two-Columns">
            <vault:field reference="created_by__v" />
            <vault:field reference="modified_by__v" />
            <vault:field reference="status__v" />
            <vault:field reference="created_date__v" />
            <vault:field reference="modified_date__v" />
        </vault:detailform>
    </vault:section>
</vault:page>