        <vault:detailform type="One-Column">
            <vault:field reference="name__v" />
            <vault:field reference="status__v" />
            <vault:field reference="edl__v" />
            <vault:field reference="doc_type_details__v" />
            <vault:field reference="steady_state_doc_count__v" />
            <vault:field reference="all_doc_count__v" />
            <vault:field reference="expected_steady_state_count__v" />
            <vault:field reference="completeness__v" />
            <vault:field reference="created_by__v" />
            <vault:field reference="created_date__v" />
            <vault:field reference="modified_by__v" />
            <vault:field reference="modified_date__v" />
            <vault:field reference="source_edl_template__v" />
            <vault:field reference="source_edl_item_template__v" />
            <vault:field reference="matching_fields__v" />
            <vault:field reference="batch_update__v" />
