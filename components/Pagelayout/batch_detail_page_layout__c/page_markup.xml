<vault:page xmlns:vault="VeevaVault" controller="Object.batch__v">
    <vault:section title="Details" name="details__c">
        <vault:detailform type="Two-Columns">
            <vault:field reference="name__v" />
            <vault:field reference="description__v" />
            <vault:field reference="external_id__v" />
        </vault:detailform>
    </vault:section>
    <vault:section title="Workflow Timeline" name="workflow_timeline__v">
        <vault:wftimeline />
    </vault:section>
    <vault:section title="Documents" name="documents__c">
        <vault:relatedDocument referenceField="batch_number__v" preventDocumentAdd="false">
            <vault:field reference="name__v" width="199px" />
            <vault:field reference="document_number__v" width="199px" />
            <vault:field reference="type__v" width="199px" />
            <vault:field reference="subtype__v" width="199px" />
            <vault:field reference="classification__v" width="199px" />
            <vault:field reference="status__v" width="199px" />
        </vault:relatedDocument>
    </vault:section>
    <vault:section title="System Information" name="sys_info__c">
        <vault:detailform type="Two-Columns">
            <vault:field reference="created_by__v" />
            <vault:field reference="modified_by__v" />
            <vault:field reference="lifecycle__v" />
            <vault:field reference="status__v" />
            <vault:field reference="created_date__v" />
            <vault:field reference="modified_date__v" />
            <vault:field reference="state__v" />
        </vault:detailform>
    </vault:section>
</vault:page>