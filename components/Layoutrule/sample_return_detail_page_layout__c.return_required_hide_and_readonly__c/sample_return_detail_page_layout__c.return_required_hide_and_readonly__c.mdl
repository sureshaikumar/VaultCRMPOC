RECREATE Layoutrule sample_return_detail_page_layout__c.return_required_hide_and_readonly__c (
   active(true),
   description('This rule defines the fields that are read only and required on the create and edit view of Sample Return Transaction.'),
   displayed_as_readonly_fields('sample_transaction_status__v',
      'type__v',
      'submitted_date__v'),
   displayed_as_required_fields('return_to__v',
      'adjusted_date__v',
      'state_province__v',
      'zip__v',
      'reason__v',
      'city__v',
      'adjust_for__v',
      'address_line_1__v'),
   expression('type__v = ''return__v'''),
   focus_on_layout(false),
   hidden_pages(),
   hide_controls(),
   hide_fields('lot__v',
      'state_province__v'),
   hide_sections(),
   hide_layout(false),
   label('Return: Required, Hide and Read-Only'),
   order(100)
);