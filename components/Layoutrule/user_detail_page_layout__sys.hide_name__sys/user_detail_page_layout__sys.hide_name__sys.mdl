RECREATE Layoutrule user_detail_page_layout__sys.hide_name__sys (
   active(true),
   description('Hide Name system managed field'),
   displayed_as_readonly_fields(),
   displayed_as_required_fields(),
   expression('true'),
   focus_on_layout(false),
   hidden_pages(),
   hide_controls(),
   hide_fields('name__v'),
   hide_sections(),
   hide_layout(false),
   label('Hide Name'),
   order(400)
);