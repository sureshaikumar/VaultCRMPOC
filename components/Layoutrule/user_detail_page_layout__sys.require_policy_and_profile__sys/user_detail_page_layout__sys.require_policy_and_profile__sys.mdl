RECREATE Layoutrule user_detail_page_layout__sys.require_policy_and_profile__sys (
   active(true),
   description('Make Security Policy and Security Profile fields required'),
   displayed_as_readonly_fields(),
   displayed_as_required_fields('security_policy__sys',
      'security_profile__sys'),
   expression('true'),
   focus_on_layout(false),
   hidden_pages(),
   hide_controls(),
   hide_fields(),
   hide_sections(),
   hide_layout(false),
   label('Require security policy and profile'),
   order(100)
);