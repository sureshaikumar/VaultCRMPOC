RECREATE Layoutrule survey_detail_page_layout__c.require_product_field__c (
   active(true),
   description(),
   displayed_as_readonly_fields(),
   displayed_as_required_fields('product__v'),
   expression('assignment_type__v=''product__v'''),
   focus_on_layout(false),
   hidden_pages(),
   hide_controls(),
   hide_fields(),
   hide_sections(),
   hide_layout(false),
   label('Require Product Field'),
   order(100)
);