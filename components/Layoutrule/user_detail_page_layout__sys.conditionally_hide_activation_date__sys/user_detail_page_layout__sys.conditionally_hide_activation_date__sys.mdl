RECREATE Layoutrule user_detail_page_layout__sys.conditionally_hide_activation_date__sys (
   active(true),
   description('Hide Inactivation Date on user creation or if the field is blank'),
   displayed_as_readonly_fields(),
   displayed_as_required_fields(),
   expression('Or(isBlank(created_date__v), isBlank(inactivation_date__sys))'),
   focus_on_layout(false),
   hidden_pages(),
   hide_controls(),
   hide_fields('inactivation_date__sys'),
   hide_sections(),
   hide_layout(false),
   label('Conditionally hide activation date'),
   order(200)
);