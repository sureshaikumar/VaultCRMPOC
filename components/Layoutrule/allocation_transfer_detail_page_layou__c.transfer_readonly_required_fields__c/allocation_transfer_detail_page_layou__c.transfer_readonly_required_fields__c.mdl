RECREATE Layoutrule allocation_transfer_detail_page_layou__c.transfer_readonly_required_fields__c (
   active(true),
   description('This rule defines the fields that are read only and required on the create and edit view of Sample Order Transfer Transaction.'),
   displayed_as_readonly_fields('confirmed_quantity__v',
      'receipt_comments__v',
      'sample_order_transaction_status__v',
      'submitted_date__v',
      'type__v'),
   displayed_as_required_fields('city__v',
      'state_province__v',
      'transfer_to__v',
      'transferred_from__v',
      'address_line_1__v',
      'transferred_date__v',
      'zip__v'),
   expression('type__v = ''transfer__v'''),
   focus_on_layout(false),
   hidden_pages(),
   hide_controls(),
   hide_fields('state_province__v'),
   hide_sections(),
   hide_layout(false),
   label('Transfer Read-Only & Required Fields'),
   order(100)
);