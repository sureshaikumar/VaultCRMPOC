RECREATE Layoutrule prediction_metric_detail_page_layout__c.autoclassification_metric_page__sys (
   active(true),
   description(),
   displayed_as_readonly_fields(),
   displayed_as_required_fields(),
   expression('trained_model_type__sys = "document_classification__sys"'),
   focus_on_layout(false),
   hidden_pages(),
   hide_controls(),
   hide_fields('partial_predictions_above_threshold__sys',
      'field_extracted__sys'),
   hide_sections(),
   hide_layout(false),
   label('Autoclassification Metric Page'),
   order(200)
);