RECREATE Layoutrule definition_detail_page_layout__c.hide_related_definition_field__sys (
   active(true),
   description('Hides Related Definition field on English-language records.'),
   displayed_as_readonly_fields(),
   displayed_as_required_fields(),
   expression('And(Or(glossary_definition_language__sysr.name__v="English", IsBlank(glossary_definition_language__sysr.name__v)), IsBlank(glossary_related_english_definition__sysr.name__v))'),
   focus_on_layout(false),
   hidden_pages(),
   hide_controls(),
   hide_fields('glossary_related_english_definition__sys'),
   hide_sections(),
   hide_layout(false),
   label('Hide Related Definition Field'),
   order(200)
);