RECREATE Layoutrule sample_transfer_detail_page_layout__c.transfer_required_hide_and_readonly__c (
   active(true),
   description('This rule defines the fields that are read only and required on the create and edit view of Sample Transfer Transaction.'),
   displayed_as_readonly_fields('confirmed_quantity__v',
      'receipt_comments__v',
      'sample_transaction_status__v',
      'submitted_date__v',
      'type__v'),
   displayed_as_required_fields('transferred_from__v',
      'transfer_to__v',
      'transferred_date__v',
      'state_province__v',
      'zip__v',
      'city__v',
      'address_line_1__v'),
   expression('type__v = ''transfer__v'''),
   focus_on_layout(false),
   hidden_pages(),
   hide_controls(),
   hide_fields('lot__v',
      'state_province__v'),
   hide_sections(),
   hide_layout(false),
   label('Transfer: Required, Hide and Read-Only'),
   order(100)
);