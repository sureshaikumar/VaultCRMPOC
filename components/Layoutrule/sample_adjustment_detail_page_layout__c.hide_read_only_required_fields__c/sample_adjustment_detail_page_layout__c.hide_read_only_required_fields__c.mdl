RECREATE Layoutrule sample_adjustment_detail_page_layout__c.hide_read_only_required_fields__c (
   active(true),
   description('Layout rule to hide, make fields read-only and required for adjustment.'),
   displayed_as_readonly_fields('type__v',
      'submitted_date__v',
      'sample_transaction_status__v'),
   displayed_as_required_fields('adjusted_date__v',
      'reason__v',
      'adjust_for__v'),
   expression('type__v = ''adjustmet__v'''),
   focus_on_layout(false),
   hidden_pages(),
   hide_controls(),
   hide_fields('lot__v'),
   hide_sections(),
   hide_layout(false),
   label('Hide, Read-Only, Required Fields'),
   order(100)
);