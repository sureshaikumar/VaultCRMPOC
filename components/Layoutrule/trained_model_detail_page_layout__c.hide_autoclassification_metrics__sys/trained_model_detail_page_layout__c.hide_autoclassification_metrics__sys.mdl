RECREATE Layoutrule trained_model_detail_page_layout__c.hide_autoclassification_metrics__sys (
   active(true),
   description(),
   displayed_as_readonly_fields(),
   displayed_as_required_fields(),
   expression('trained_model_type__sys = "metadata_extraction__sys"'),
   focus_on_layout(false),
   hidden_pages(),
   hide_controls(),
   hide_fields(),
   hide_sections('document_classification_model_perf_metrics__c',
      'document_classification_prediction_metrics__c'),
   hide_layout(false),
   label('Hide Auto-classification Metrics'),
   order(500)
);