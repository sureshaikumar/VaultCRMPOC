   active(true),
   description(),
   displayed_as_readonly_fields(),
   displayed_as_required_fields(),
   expression('true'),
   focus_on_layout(false),
   hidden_pages(),
   hide_controls(),
   hide_fields('security_profile__sys'),
   hide_sections(),
   hide_layout(false),
   label('Hide Security Profile'),
   order(100)
);