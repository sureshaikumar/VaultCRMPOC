RECREATE Layoutrule adjustment_detail_page_layout__c.adjustment_readonly_required_fields__c (
   active(true),
   description('This rule defines the fields that are read only and required on the create and edit view of Sample Order Adjustment Transaction.'),
   displayed_as_readonly_fields('sample_order_transaction_status__v',
      'submitted_date__v',
      'type__v'),
   displayed_as_required_fields('reason__v',
      'adjusted_date__v',
      'adjust_for__v'),
   expression('type__v = ''adjustment__v'''),
   focus_on_layout(false),
   hidden_pages(),
   hide_controls(),
   hide_fields(),
   hide_sections(),
   hide_layout(false),
   label('Adjustment Read-Only & Required Fields'),
   order(100)
);