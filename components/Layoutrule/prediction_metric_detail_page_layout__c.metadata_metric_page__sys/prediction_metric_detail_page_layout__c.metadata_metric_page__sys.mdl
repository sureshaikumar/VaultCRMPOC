RECREATE Layoutrule prediction_metric_detail_page_layout__c.metadata_metric_page__sys (
   active(true),
   description(),
   displayed_as_readonly_fields(),
   displayed_as_required_fields(),
   expression('trained_model_type__sys = "metadata_extraction__sys"'),
   focus_on_layout(false),
   hidden_pages(),
   hide_controls(),
   hide_fields('correct_predictions__sys'),
   hide_sections(),
   hide_layout(false),
   label('Metadata Metric Page'),
   order(100)
);