RECREATE Vsmentity perf_stats__v (
   label('Performance Statistics'),
   active(true),
   description('Each day, Vault automatically creates a new (non-editable) record in the Performance Statistics object. Fields on the record track key performance metrics for your Vault.'),
   synonyms('Perf Stats',
      'Vault Usage',
      'Performance Metrics',
      'Usage Statistics'),
   target('Object.perf_stats__v'),
   target_label('Performance Statistics'),
   Vsmfield(@Vsmfield/active_custom_objects__v.mdl),
   Vsmfield(@Vsmfield/active_user_count__v.mdl),
   Vsmfield(@Vsmfield/avg_time_api_call__v.mdl),
   Vsmfield(@Vsmfield/avg_time_doc_view__v.mdl),
   Vsmfield(@Vsmfield/avg_time_lib_view__v.mdl),
   Vsmfield(@Vsmfield/avg_time_login__v.mdl),
   Vsmfield(@Vsmfield/avg_time_object_detail_view__v.mdl),
   Vsmfield(@Vsmfield/avg_time_object_list_view__v.mdl),
   Vsmfield(@Vsmfield/avg_time_report__v.mdl),
   Vsmfield(@Vsmfield/avg_time_search__v.mdl),
   Vsmfield(@Vsmfield/custom_obj_record_count__v.mdl),
   Vsmfield(@Vsmfield/doc_count__v.mdl),
   Vsmfield(@Vsmfield/doc_upload_count__v.mdl),
   Vsmfield(@Vsmfield/doc_version_count__v.mdl),
   Vsmfield(@Vsmfield/doc_view_count__v.mdl),
   Vsmfield(@Vsmfield/edit_doc_field_count__v.mdl),
   Vsmfield(@Vsmfield/new_api_calls__v.mdl),
   Vsmfield(@Vsmfield/new_workflows__v.mdl),
   Vsmfield(@Vsmfield/object_detail_view_count__v.mdl),
   Vsmfield(@Vsmfield/report_views__v.mdl),
   Vsmfield(@Vsmfield/search_count__v.mdl),
   Vsmfield(@Vsmfield/task_count__v.mdl),
   Vsmfield(@Vsmfield/unique_login_count__v.mdl),
   Vsmfield(@Vsmfield/unique_vault_mobile_visit_count__v.mdl)
);