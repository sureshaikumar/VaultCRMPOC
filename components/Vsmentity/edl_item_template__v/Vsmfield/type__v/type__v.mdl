Vsmfield type__v (
   label('Document Type'),
   active(true),
   description('The top-level document type associated with this EDL item template, representing the first level of the document type hierarchy. Use this to filter EDL item templates by broad document category. IMPORTANT: For the full type hierarchy in a single field, use doc_type_details__v instead.'),
   example_values(),
   synonyms('doc type',
         'document type',
         'type'),
   target('type__v'),
   target_label('Document Type'),
   vsm_picklist(),
   vsm_picklist_local()
);