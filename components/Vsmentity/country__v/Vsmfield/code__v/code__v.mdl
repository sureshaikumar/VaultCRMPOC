Vsmfield code__v (
   label('Code'),
   active(true),
   description('Short alphanumeric code identifying the country, typically following ISO 3166-1 standards (e.g., \''US\'', \''DE\'', \''FR\''). Use this field when filtering or referencing countries by their standardized code rather than full name.'),
   example_values(),
   synonyms('country code',
         'ISO code',
         'abbreviation'),
   target('code__sys'),
   target_label('Code'),
   vsm_picklist(),
   vsm_picklist_local()
);