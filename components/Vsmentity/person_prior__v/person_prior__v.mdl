RECREATE Vsmentity person_prior__v (
   label('Prior Person'),
   active(true),
   description('A system-managed object representing a prior or previous iteration of a Person record. This object is used to track historical changes to person records, supporting scenarios such as identity merges, deduplication, or person record consolidation workflows. It serves as a reference to earlier versions or alternate representations of a person entity, helping maintain data lineage and audit trails across person record changes.'),
   synonyms('prior person',
      'previous person record',
      'historical person',
      'predecessor identity'),
   target('Object.person_prior__sys'),
   target_label('Prior Person'),
   Vsmfield(@Vsmfield/email__v.mdl),
   Vsmfield(@Vsmfield/first_name__v.mdl),
   Vsmfield(@Vsmfield/language__v.mdl),
   Vsmfield(@Vsmfield/last_name__v.mdl),
   Vsmfield(@Vsmfield/locale__v.mdl),
   Vsmfield(@Vsmfield/manager__v.mdl),
   Vsmfield(@Vsmfield/mobile_phone__v.mdl),
   Vsmfield(@Vsmfield/name__v.mdl),
   Vsmfield(@Vsmfield/person__v.mdl),
   Vsmfield(@Vsmfield/timezone__v.mdl),
   Vsmfield(@Vsmfield/username__v.mdl),
   Vsmmetric(@Vsmmetric/prior_person_count__v.mdl),
   Vsmrelationship(@Vsmrelationship/person__v.mdl)
);