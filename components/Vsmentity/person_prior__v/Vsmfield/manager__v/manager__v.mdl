Vsmfield manager__v (
   label('Manager'),
   active(true),
   description('The prior manager associated with this person before an organizational change. References a person or user object. Use this to audit reporting structure history or track org chart changes over time.'),
   example_values(),
   synonyms('supervisor',
         'reports to',
         'prior manager'),
   target('manager__sys'),
   target_label('Manager'),
   vsm_picklist(),
   vsm_picklist_local()
);