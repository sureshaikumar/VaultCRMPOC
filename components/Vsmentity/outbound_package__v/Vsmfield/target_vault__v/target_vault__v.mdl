Vsmfield target_vault__v (
   label('Target Vault'),
   active(true),
   description('Numeric identifier of the Vault instance to which this outbound package is intended to be deployed. Use to identify dependencies when compiling individual elements to include in the package.'),
   example_values(),
   synonyms('target',
         'destination vault',
         'to vault',
         'destination environment'),
   target('target_vault__v'),
   target_label('Target Vault'),
   vsm_picklist(),
   vsm_picklist_local()
);