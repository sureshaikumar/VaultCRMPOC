RECREATE Vsmentity activity__v (
   label('Activity'),
   active(true),
   description('Represents a discrete unit of work, task, or action from Vault workflows or User Tasks. Activities are used to log, schedule, or monitor specific actions taken by users or systems as part of broader business processes. They are commonly queried to audit progress, track completion status, and understand engagement across related records or workflows.'),
   synonyms('task',
      'action',
      'event'),
   target('Object.activity__v'),
   target_label('Activity'),
   Vsmfield(@Vsmfield/activity_state__v.mdl),
   Vsmfield(@Vsmfield/assigned__v.mdl),
   Vsmfield(@Vsmfield/assigned_to__v.mdl),
   Vsmfield(@Vsmfield/complete__v.mdl),
   Vsmfield(@Vsmfield/completion_date__v.mdl),
   Vsmfield(@Vsmfield/created_date__v.mdl),
   Vsmfield(@Vsmfield/description__v.mdl),
   Vsmfield(@Vsmfield/due_date__v.mdl),
   Vsmfield(@Vsmfield/end__v.mdl),
   Vsmfield(@Vsmfield/first_assigned_date__v.mdl),
   Vsmfield(@Vsmfield/last_assigned_date__v.mdl),
   Vsmfield(@Vsmfield/name__v.mdl),
   Vsmfield(@Vsmfield/object_type__v.mdl),
   Vsmfield(@Vsmfield/parent__v.mdl),
   Vsmfield(@Vsmfield/priority__v.mdl),
   Vsmfield(@Vsmfield/start__v.mdl),
   Vsmfield(@Vsmfield/status__v.mdl),
   Vsmfield(@Vsmfield/task_object_type__v.mdl),
   Vsmmetric(@Vsmmetric/overdue_activity_count__v.mdl)
);