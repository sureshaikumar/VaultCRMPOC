Vsmfield profile_name__v (
   label('Profile Name'),
   active(true),
   description('The system-defined name of the security profile, typically used internally to reference the profile configuration. IMPORTANT: This may differ from name__v (the record label); use this field when querying by the canonical system-assigned profile name rather than the user-facing record name.'),
   example_values(),
   synonyms('security profile name',
         'system profile name',
         'profile display name'),
   target('profile_name__sys'),
   target_label('Profile Name'),
   vsm_picklist(),
   vsm_picklist_local()
);