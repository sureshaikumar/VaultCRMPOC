Vsmfield password__v (
   label('Password'),
   active(true),
   description('The password credential used for basic username/password authentication with an external system. IMPORTANT: This is for basic authentication only; for OAuth-based connections, use client_secret__sys instead.'),
   example_values(),
   synonyms('credential',
         'auth password',
         'login password'),
   target('password__sys'),
   target_label('Password'),
   vsm_picklist(),
   vsm_picklist_local()
);