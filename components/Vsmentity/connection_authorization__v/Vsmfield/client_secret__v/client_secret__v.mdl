Vsmfield client_secret__v (
   label('Client Secret'),
   active(true),
   description('The confidential secret paired with the client ID to authenticate OAuth-based connections. IMPORTANT: This is a sensitive credential field used for OAuth flows, not to be confused with the password field used for basic authentication.'),
   example_values(),
   synonyms('OAuth secret',
         'app secret',
         'consumer secret',
         'client password'),
   target('client_secret__sys'),
   target_label('Client Secret'),
   vsm_picklist(),
   vsm_picklist_local()
);