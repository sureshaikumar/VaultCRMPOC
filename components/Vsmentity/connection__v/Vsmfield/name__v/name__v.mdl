Vsmfield name__v (
   label('Name'),
   active(true),
   description('The human-readable display name of the connection. This is the primary identifier shown in the UI and used to distinguish connections from one another in lists and reports.'),
   example_values(),
   synonyms('connection name',
         'title',
         'label'),
   target('name__v'),
   target_label('Name'),
   vsm_picklist(),
   vsm_picklist_local()
);