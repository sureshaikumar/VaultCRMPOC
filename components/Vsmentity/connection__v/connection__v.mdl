RECREATE Vsmentity connection__v (
   label('Connection'),
   active(true),
   description('Represents a configured connection between Vault and another Vault, an external system, or an LLM. Connections define the integration endpoints, authentication settings, and communication parameters used to enable data exchange or workflow automation with other Vaults or third-party platforms. They are typically referenced by integration rules, workflow steps, or automated processes that need to interact with external systems.'),
   synonyms('connections',
      'integration',
      'link',
      'interface'),
   target('Object.connection__sys'),
   target_label('Connection'),
   Vsmfield(@Vsmfield/api_name__v.mdl),
   Vsmfield(@Vsmfield/authorized_connection_user__v.mdl),
   Vsmfield(@Vsmfield/certificate_id__v.mdl),
   Vsmfield(@Vsmfield/connection_authorization__v.mdl),
   Vsmfield(@Vsmfield/name__v.mdl),
   Vsmfield(@Vsmfield/object_type__v.mdl),
   Vsmrelationship(@Vsmrelationship/authorized_connection_user__v.mdl),
   Vsmrelationship(@Vsmrelationship/connection_authorization__v.mdl),
   Vsmrelationship(@Vsmrelationship/connection_backed_crosslinks__v.mdl),
   Vsmrelationship(@Vsmrelationship/connection_client__v.mdl),
   Vsmrelationship(@Vsmrelationship/connection_stats__v.mdl),
   Vsmrelationship(@Vsmrelationship/integration__v.mdl),
   Vsmrelationship(@Vsmrelationship/object_type__v.mdl),
   Vsmrelationship(@Vsmrelationship/reference_lookup__v.mdl)
);