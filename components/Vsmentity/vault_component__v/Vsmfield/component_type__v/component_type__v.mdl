Vsmfield component_type__v (
   label('Component Type'),
   active(true),
   description('Classifies the vault component by its functional type (e.g., object, workflow, document type, picklist). Use this field to filter or group components by category when managing vault configurations or performing deployments.'),
   example_values(),
   synonyms('type',
         'component category',
         'kind'),
   target('component_type__v'),
   target_label('Component Type'),
   vsm_picklist(),
   vsm_picklist_local()
);