Vsmfield document_id_unbound__v (
   label('Document (unbound)'),
   active(true),
   description('Stores the numeric document ID for cases where the document reference is not bound to a Vault document object, such as when the document has been deleted or is from an external system. IMPORTANT: Use document_id__v for active, linked Vault documents; this field captures unresolved or historical references.'),
   example_values(),
   synonyms('unbound doc ID',
         'external doc ID',
         'doc number',
         'unlinked document'),
   target('document_id_unbound__v'),
   target_label('Document (unbound)'),
   vsm_picklist(),
   vsm_picklist_local()
);