RECREATE Vsmentity veevaid_invite_vault_user_creation__v (
   label('VeevaID invite: Vault User Creation'),
   active(true),
   description('Represents a VeevaID-based invitation event. This object tracks the process by which external users are invited via VeevaID to gain access to a Vault, serving as a record of the user provisioning workflow. It is used by system administrators and identity management processes to monitor individuals invited to VeevaID and whether or not they have accepted the invitation. Accepting the invitation grants the user access to the Vault.'),
   synonyms('VeevaID invite',
      'user creation invite',
      'vault user invite',
      'user provisioning'),
   target('Object.veevaid_invite_vault_user_creation__sys'),
   target_label('VeevaID invite: Vault User Creation'),
   Vsmfield(@Vsmfield/application_registration_id__v.mdl),
   Vsmfield(@Vsmfield/bounce_support__v.mdl),
   Vsmfield(@Vsmfield/failure_reason__v.mdl),
   Vsmfield(@Vsmfield/initiating_user__v.mdl),
   Vsmfield(@Vsmfield/license_type__v.mdl),
   Vsmfield(@Vsmfield/origin__v.mdl),
   Vsmfield(@Vsmfield/registrant_email__v.mdl),
   Vsmfield(@Vsmfield/registrant_user__v.mdl),
   Vsmfield(@Vsmfield/security_profile__v.mdl),
   Vsmfield(@Vsmfield/system_registration_id__v.mdl),
   Vsmfield(@Vsmfield/vault_user_creation__v.mdl),
   Vsmrelationship(@Vsmrelationship/initiating_user__v.mdl),
   Vsmrelationship(@Vsmrelationship/registrant_user__v.mdl)
);