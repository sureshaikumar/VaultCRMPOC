Vsmfield language__v (
   label('Language'),
   active(true),
   description('Reference to the Language object associated with this locale. Defines the base language (e.g., English, French) that this locale is built upon. Use to filter locales by language or to navigate to language-level settings.'),
   example_values(),
   synonyms('language reference',
         'associated language',
         'linked language'),
   target('language__sys'),
   target_label('Language'),
   vsm_picklist(),
   vsm_picklist_local()
);