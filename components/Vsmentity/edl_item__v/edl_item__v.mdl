RECREATE Vsmentity edl_item__v (
   label('EDL Item'),
   active(true),
   description('An individual entry on an Expected Document List (EDL), representing a specific document type where at least one document, whether or not a document is expected in that document type, and how many documents are expected.'),
   synonyms('EDL entry',
      'exclusion list item',
      'denied party entry',
      'restricted party'),
   target('Object.edl_item__v'),
   target_label('EDL Item'),
   Vsmfield(@Vsmfield/all_doc_count__v.mdl),
   Vsmfield(@Vsmfield/batch_update__v.mdl),
   Vsmfield(@Vsmfield/classification__v.mdl),
   Vsmfield(@Vsmfield/completeness__v.mdl),
   Vsmfield(@Vsmfield/doc_type_details__v.mdl),
   Vsmfield(@Vsmfield/edl__v.mdl),
   Vsmfield(@Vsmfield/expected_steady_state_count__v.mdl),
   Vsmfield(@Vsmfield/matching_fields__v.mdl),
   Vsmfield(@Vsmfield/name__v.mdl),
   Vsmfield(@Vsmfield/source_edl_item_template__v.mdl),
   Vsmfield(@Vsmfield/source_edl_template__v.mdl),
   Vsmfield(@Vsmfield/steady_state_doc_count__v.mdl),
   Vsmfield(@Vsmfield/subtype__v.mdl),
   Vsmfield(@Vsmfield/type__v.mdl),
   Vsmmetric(@Vsmmetric/document_completeness_rate__v.mdl)
);