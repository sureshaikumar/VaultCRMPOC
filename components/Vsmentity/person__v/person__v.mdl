RECREATE Vsmentity person__v (
   label('Person'),
   active(true),
   description('Represents an individual person tracked within the Vault system. Person records are used to identify and manage individuals associated with business processes, such as contacts, stakeholders, authors, or participants in workflows. Persons can be linked to Users, but may be individuals tracked who do not have access to Vault. This object serves as a foundational entity that can be referenced across various objects and relationships within the system.'),
   synonyms('people',
      'individual',
      'contact',
      'personnel'),
   target('Object.person__sys'),
   target_label('Person'),
   Vsmfield(@Vsmfield/email__v.mdl),
   Vsmfield(@Vsmfield/first_name__v.mdl),
   Vsmfield(@Vsmfield/language__v.mdl),
   Vsmfield(@Vsmfield/last_name__v.mdl),
   Vsmfield(@Vsmfield/locale__v.mdl),
   Vsmfield(@Vsmfield/manager__v.mdl),
   Vsmfield(@Vsmfield/mobile_phone__v.mdl),
   Vsmfield(@Vsmfield/name__v.mdl),
   Vsmfield(@Vsmfield/outbound_email_status__v.mdl),
   Vsmfield(@Vsmfield/timezone__v.mdl),
   Vsmfield(@Vsmfield/username__v.mdl),
   Vsmfield(@Vsmfield/vault_user__v.mdl),
   Vsmfield(@Vsmfield/veeva_id__v.mdl),
   Vsmrelationship(@Vsmrelationship/manager__v.mdl),
   Vsmrelationship(@Vsmrelationship/person_prior__v.mdl),
   Vsmrelationship(@Vsmrelationship/persons__v.mdl),
   Vsmrelationship(@Vsmrelationship/vault_user__v.mdl)
);