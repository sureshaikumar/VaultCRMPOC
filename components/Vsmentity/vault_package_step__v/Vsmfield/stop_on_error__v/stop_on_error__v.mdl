Vsmfield stop_on_error__v (
   label('Stop On Error'),
   active(true),
   description('Boolean flag indicating whether the package deployment should halt if this step encounters an error. When true, any failure in this step will stop the entire inbound package installation.'),
   example_values(),
   synonyms('halt on error',
         'fail on error',
         'error stop',
         'abort on failure'),
   target('stop_on_error__v'),
   target_label('Stop On Error'),
   vsm_picklist(),
   vsm_picklist_local()
);