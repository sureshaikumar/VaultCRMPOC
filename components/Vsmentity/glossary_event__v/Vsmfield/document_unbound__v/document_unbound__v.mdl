Vsmfield document_unbound__v (
   label('Document (unbound)'),
   active(true),
   description('Numeric identifier for a document not directly bound to the glossary event record. Used when the document reference cannot be resolved to a standard object relationship, such as for deleted or external documents.'),
   example_values(),
   synonyms('unbound doc',
         'doc ID',
         'unbound document reference'),
   target('document_unbound__v'),
   target_label('Document (unbound)'),
   vsm_picklist(),
   vsm_picklist_local()
);