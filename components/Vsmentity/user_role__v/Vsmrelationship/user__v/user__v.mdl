Vsmrelationship user__v (
   label('User'),
   active(true),
   cardinality('MANY_TO_ONE'),
   description('The user to whom this role is assigned, linking the role record back to a specific Vault user account. Use this to find all roles assigned to a particular user (e.g., user__sysr.user_name__sys = ''john.doe@example.com'').'),
   join_object(),
   synonyms('assigned user',
         'user',
         'who has role',
         'user assigned'),
   target('user__sysr'),
   target_label('User'),
   target_object('user__sys')
);