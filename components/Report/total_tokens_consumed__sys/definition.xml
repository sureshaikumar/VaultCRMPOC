<?xml version="1.0" encoding="UTF-8"?>
<vrp:query xmlns:vrp="VaultReport">
  <vrp:querySettings includeAllVersions="false" />
  <vrp:select>
    <vrp:selectItem type="PROPERTY" action="NONE" property="daily_agent_activity__sys.name__v" />
    <vrp:selectItem type="PROPERTY" action="NONE" property="daily_agent_activity__sys.FF_mtokens__c" />
    <vrp:selectItem type="PROPERTY" action="NONE" property="daily_agent_activity__sys.total_tokens__sys" />
  </vrp:select>
  <vrp:where>
    <vrp:whereItem action="INLASTDAYS" leftValue="daily_agent_activity__sys.created_date__v" rightValue="60" labelLanguage="en" type="PROPERTY" rightValueType="VALUE" runtime="false" />
  </vrp:where>
  <vrp:group>
    <vrp:groupItem index="0" name="daily_agent_activity__sys.total_tokens__sys" groupBySortOn="daily_agent_activity__sys.total_tokens__sys" groupBySortOrder="ASCENDING">
      <vrp:function>
        <vrp:selectItem type="FUNCTION" action="SUM" property="SUM" display="NUMBER">
          <vrp:children>
            <vrp:selectItem type="PROPERTY" action="NONE" property="daily_agent_activity__sys.FF_mtokens__c" />
          </vrp:children>
        </vrp:selectItem>
        <vrp:selectItem type="FUNCTION" action="SUM" property="SUM" display="NUMBER">
          <vrp:children>
            <vrp:selectItem type="PROPERTY" action="NONE" property="daily_agent_activity__sys.total_tokens__sys" />
          </vrp:children>
        </vrp:selectItem>
      </vrp:function>
    </vrp:groupItem>
  </vrp:group>
  <vrp:order>
    <vrp:orderItem index="0" name="daily_agent_activity__sys.name__v" sortDirection="ASCENDING" />
  </vrp:order>
  <vrp:formulaFields>
    <vrp:formulaField key="daily_agent_activity__sys.FF_mtokens__c" label="Total Tokens (in millions)">
      <vrp:type>STANDARD</vrp:type>
      <vrp:formula>daily_agent_activity__sys.total_tokens__sys/1000000</vrp:formula>
      <vrp:returnType>Number</vrp:returnType>
      <vrp:scale>5</vrp:scale>
      <vrp:displayFormat>Number</vrp:displayFormat>
      <vrp:enhancedBlankHandling>blanks_as_blanks</vrp:enhancedBlankHandling>
      <vrp:aggregateDisplayLevel>all_levels</vrp:aggregateDisplayLevel>
    </vrp:formulaField>
  </vrp:formulaFields>
</vrp:query>