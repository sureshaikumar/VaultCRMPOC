<?xml version="1.0" encoding="UTF-8"?>
<rules>
    <rule>
        <expression operator="and">
            <expression operator="in">
                <expression operator="field" type="string">
                    <value>Document.type__v</value>
                </expression>
                <expression operator="value" type="string">
                    <value>presentation__v</value>
                </expression>
                <expression operator="value" type="string">
                    <value>shared_resource__v</value>
                </expression>
                <expression operator="value" type="string">
                    <value>slide__v</value>
                </expression>
            </expression>
            <expression operator="isBlank">
                <expression operator="field" type="string">
                    <value>Document.link__sys</value>
                </expression>
            </expression>
        </expression>
        <actions>
            <action type="CHECK_ENTRY_ACTION">
                <EntryAction type="SetFieldFromFormula" property="Document.vexternal_id__v" expression="Document.id__v&amp;&quot;_Draft&quot;" treatBlankAsZero="false" errorHandlingType="smartErrorHandling" />
            </action>
        </actions>
    </rule>
</rules>