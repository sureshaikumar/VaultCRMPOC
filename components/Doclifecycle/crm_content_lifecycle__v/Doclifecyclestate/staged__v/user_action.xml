<?xml version="1.0" encoding="UTF-8"?>
<rules>
    <rule>
        <actions>
            <action type="CHECK_USER_ACTION">
                <UserAction actionType="StateChange" newState="approved__v" label="Change State to Approved" publicKey="change_state_to_approved__v" />
            </action>
            <action type="CHECK_USER_ACTION">
                <UserAction actionType="StateChange" newState="expired__v" label="Change State to Expired" publicKey="change_state_to_expired__v" />
            </action>
        </actions>
    </rule>
    <rule>
        <expression operator="and">
            <expression operator="in">
                <expression operator="field" type="string">
                    <value>Document.type__v</value>
                </expression>
                <expression operator="value" type="string">
                    <value>shared_resource__v</value>
                </expression>
                <expression operator="value" type="string">
                    <value>slide__v</value>
                </expression>
            </expression>
            <expression operator="eq">
                <expression operator="field" type="boolean">
                    <value>Document.latest_version__v</value>
                </expression>
                <expression operator="value" type="boolean">
                    <value>true</value>
                </expression>
            </expression>
        </expression>
        <actions>
            <action type="Documentaction.com.veeva.vault.app.vaultcrm.core.clm.actions.CrmContentLifecyclePublishDistributionPackageDocumentAction" name="Documentaction.com.veeva.vault.app.vaultcrm.core.clm.actions.CrmContentLifecyclePublishDistributionPackageDocumentAction" configuredLabel="Publish Distribution Package">
                <publicKey>sdkDocLifecycleUA12ey2u4tfutq2__v</publicKey>
            </action>
            <action type="Documentaction.com.veeva.vault.app.vaultcrm.core.clm.actions.CrmContentLifecycleWithdrawDistributionPackageDocumentAction" name="Documentaction.com.veeva.vault.app.vaultcrm.core.clm.actions.CrmContentLifecycleWithdrawDistributionPackageDocumentAction" configuredLabel="Withdraw Distribution Package">
                <publicKey>sdkDocLifecycleUAdxskzgvpqz0__v</publicKey>
            </action>
        </actions>
    </rule>
    <rule>
        <expression operator="and">
            <expression operator="eq">
                <expression operator="field" type="string">
                    <value>Document.type__v</value>
                </expression>
                <expression operator="value" type="string">
                    <value>dynamic_word_template__v</value>
                </expression>
            </expression>
            <expression operator="eq">
                <expression operator="field" type="boolean">
                    <value>Document.latest_version__v</value>
                </expression>
                <expression operator="value" type="boolean">
                    <value>true</value>
                </expression>
            </expression>
        </expression>
        <actions>
            <action type="Documentaction.com.veeva.vault.app.vaultcrm.core.clm.actions.CrmContentLifecycleProcessContentDocumentAction" name="Documentaction.com.veeva.vault.app.vaultcrm.core.clm.actions.CrmContentLifecycleProcessContentDocumentAction" configuredLabel="Process Content">
                <publicKey>sdkDocLifecycleUA1af2o5bznnrp0__c</publicKey>
            </action>
        </actions>
    </rule>
    <rule>
        <expression operator="in">
            <expression operator="field" type="string">
                <value>Document.type__v</value>
            </expression>
            <expression operator="value" type="string">
                <value>email_fragment__v</value>
            </expression>
            <expression operator="value" type="string">
                <value>email_template__v</value>
            </expression>
            <expression operator="value" type="string">
                <value>template_fragment__v</value>
            </expression>
        </expression>
        <actions>
            <action type="Documentaction.com.veeva.vault.app.vaultcrm.approvedemail.actions.CrmContentLifecycleRerenderAeRenditionsDocumentAction" name="Documentaction.com.veeva.vault.app.vaultcrm.approvedemail.actions.CrmContentLifecycleRerenderAeRenditionsDocumentAction" configuredLabel="Re-render Approved Email Renditions">
                <publicKey>sdkDocLifecycleUA1p0yir6kr3asz__c</publicKey>
            </action>
        </actions>
    </rule>
</rules>