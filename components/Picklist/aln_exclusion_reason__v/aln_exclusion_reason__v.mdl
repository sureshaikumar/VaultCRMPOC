RECREATE Picklist aln_exclusion_reason__v (
   label('Exclusion Reason'),
   active(true),
   Picklistentry(@Picklistentry/state_license_revocation__v.mdl),
   Picklistentry(@Picklistentry/compliance_or_debarment__v.mdl),
   Picklistentry(@Picklistentry/internal_conflict__v.mdl),
   Picklistentry(@Picklistentry/feedback__v.mdl),
   Picklistentry(@Picklistentry/remove_from_territory_request__v.mdl),
   system_managed(false),
   order_type('order_asc__sys')
);