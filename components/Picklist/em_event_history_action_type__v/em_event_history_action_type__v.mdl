   label('Action Type'),
   active(true),
   Picklistentry(@Picklistentry/submit_for_approval__v.mdl),
   Picklistentry(@Picklistentry/approve__v.mdl),
   Picklistentry(@Picklistentry/reject__v.mdl),
   Picklistentry(@Picklistentry/cancel_event__v.mdl),
   Picklistentry(@Picklistentry/reschedule__v.mdl),
   Picklistentry(@Picklistentry/close__v.mdl),
   Picklistentry(@Picklistentry/unlock__v.mdl),
   Picklistentry(@Picklistentry/created__v.mdl),
   Picklistentry(@Picklistentry/em_business_rule_execution__v.mdl),
   Picklistentry(@Picklistentry/lifecycle_stage_change__v.mdl),
   Picklistentry(@Picklistentry/recall_approval_request__v.mdl),
   Picklistentry(@Picklistentry/workflow_verdict__v.mdl),
   system_managed(false),
   order_type('order_asc__sys')
);