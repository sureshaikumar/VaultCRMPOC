RECREATE Picklist patient_crm_patient_journey_step_status__v (
   label('Step Status'),
   active(true),
   Picklistentry(@Picklistentry/in_progress__v.mdl),
   Picklistentry(@Picklistentry/completed__v.mdl),
   Picklistentry(@Picklistentry/escalated__v.mdl),
   Picklistentry(@Picklistentry/discontinued__v.mdl),
   Picklistentry(@Picklistentry/canceled__v.mdl),
   Picklistentry(@Picklistentry/inactive__v.mdl),
   system_managed(false),
   order_type('order_asc__sys')
);