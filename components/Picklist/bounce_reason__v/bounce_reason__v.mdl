RECREATE Picklist bounce_reason__v (
   label('Bounce Reason'),
   active(true),
   Picklistentry(@Picklistentry/mailbox_full__v.mdl),
   Picklistentry(@Picklistentry/already_bounced__v.mdl),
   Picklistentry(@Picklistentry/blocked_content__v.mdl),
   Picklistentry(@Picklistentry/blocked_sender__v.mdl),
   Picklistentry(@Picklistentry/invalid_address__v.mdl),
   Picklistentry(@Picklistentry/server_issue__v.mdl),
   Picklistentry(@Picklistentry/unknown__v.mdl),
   system_managed(false),
   order_type('order_asc__sys')
);