RECREATE Picklist workflow_task_item_status__sys (
   label('Workflow Task Item Status'),
   active(true),
   Picklistentry(@Picklistentry/pending__sys.mdl),
   Picklistentry(@Picklistentry/completed__sys.mdl),
   Picklistentry(@Picklistentry/cancelled__sys.mdl),
   Picklistentry(@Picklistentry/excluded__sys.mdl),
   system_managed(false),
   order_type('order_asc__sys')
);