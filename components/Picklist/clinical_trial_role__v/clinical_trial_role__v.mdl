RECREATE Picklist clinical_trial_role__v (
   label('Role'),
   active(true),
   Picklistentry(@Picklistentry/principal_investigator__v.mdl),
   Picklistentry(@Picklistentry/protocol_chair__v.mdl),
   Picklistentry(@Picklistentry/protocol_co_chair__v.mdl),
   Picklistentry(@Picklistentry/study_coordinator__v.mdl),
   system_managed(false),
   order_type('order_asc__sys')
);