RECREATE Picklist aln_task_status__v (
   label('Task Status'),
   active(true),
   Picklistentry(@Picklistentry/completed__v.mdl),
   Picklistentry(@Picklistentry/completed_with_errors__v.mdl),
   Picklistentry(@Picklistentry/completed_with_errors_and_warnings__v.mdl),
   Picklistentry(@Picklistentry/completed_with_warnings__v.mdl),
   Picklistentry(@Picklistentry/running__v.mdl),
   Picklistentry(@Picklistentry/queued__v.mdl),
   Picklistentry(@Picklistentry/aborted__v.mdl),
   Picklistentry(@Picklistentry/paused__v.mdl),
   Picklistentry(@Picklistentry/completed_writing_log__v.mdl),
   Picklistentry(@Picklistentry/discarded__v.mdl),
   Picklistentry(@Picklistentry/canceled__v.mdl),
   system_managed(false),
   order_type('order_asc__sys')
);