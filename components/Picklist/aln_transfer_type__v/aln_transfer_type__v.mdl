RECREATE Picklist aln_transfer_type__v (
   label('Transfer Type'),
   active(true),
   Picklistentry(@Picklistentry/transferred_to_other_user__v.mdl),
   Picklistentry(@Picklistentry/transferred_from_other_user__v.mdl),
   Picklistentry(@Picklistentry/shared_with_other_user__v.mdl),
   system_managed(false),
   order_type('order_asc__sys')
);