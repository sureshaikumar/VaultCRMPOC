RECREATE Picklist execution_status__sys (
   label('Execution Status'),
   active(true),
   Picklistentry(@Picklistentry/pending__sys.mdl),
   Picklistentry(@Picklistentry/in_progress__sys.mdl),
   Picklistentry(@Picklistentry/success__sys.mdl),
   Picklistentry(@Picklistentry/failed__sys.mdl),
   system_managed(false),
   order_type('order_asc__sys')
);