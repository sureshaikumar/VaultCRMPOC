RECREATE Picklist social_binding_activity_status__v (
   label('Social Binding Activity Status'),
   active(true),
   Picklistentry(@Picklistentry/submitted__v.mdl),
   Picklistentry(@Picklistentry/pending__v.mdl),
   Picklistentry(@Picklistentry/approved__v.mdl),
   Picklistentry(@Picklistentry/denied__v.mdl),
   Picklistentry(@Picklistentry/failed__v.mdl),
   system_managed(false),
   order_type('order_asc__sys')
);