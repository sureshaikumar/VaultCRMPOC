RECREATE Picklist target_process_state__v (
   label('Target Process State'),
   active(true),
   Picklistentry(@Picklistentry/scheduled__v.mdl),
   Picklistentry(@Picklistentry/retry__v.mdl),
   Picklistentry(@Picklistentry/not_started__v.mdl),
   Picklistentry(@Picklistentry/closed__v.mdl),
   Picklistentry(@Picklistentry/no_consent__v.mdl),
   system_managed(false),
   order_type('order_asc__sys')
);