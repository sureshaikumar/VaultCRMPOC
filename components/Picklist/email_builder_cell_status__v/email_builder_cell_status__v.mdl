RECREATE Picklist email_builder_cell_status__v (
   label('Email Builder Cell Status'),
   active(true),
   Picklistentry(@Picklistentry/approved__v.mdl),
   Picklistentry(@Picklistentry/expired__v.mdl),
   Picklistentry(@Picklistentry/staged__v.mdl),
   system_managed(false),
   order_type('order_asc__sys')
);