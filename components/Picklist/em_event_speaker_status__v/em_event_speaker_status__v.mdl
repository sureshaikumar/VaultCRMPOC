   Picklistentry(@Picklistentry/invited__v.mdl),
   Picklistentry(@Picklistentry/accepted__v.mdl),
   Picklistentry(@Picklistentry/rejected__v.mdl),
   Picklistentry(@Picklistentry/attended__v.mdl),
   Picklistentry(@Picklistentry/signed__v.mdl),
   Picklistentry(@Picklistentry/cleared_signature__v.mdl),
   Picklistentry(@Picklistentry/registered__v.mdl),
   system_managed(false),
