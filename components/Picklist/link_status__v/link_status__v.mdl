RECREATE Picklist link_status__v (
   label('Link Status'),
   active(true),
   Picklistentry(@Picklistentry/active__v.mdl),
   Picklistentry(@Picklistentry/deleted__v.mdl),
   Picklistentry(@Picklistentry/obsolete__v.mdl),
   Picklistentry(@Picklistentry/rendition_not_available__v.mdl),
   Picklistentry(@Picklistentry/steady_state_not_available__v.mdl),
   Picklistentry(@Picklistentry/source_vault_not_available__v.mdl),
   Picklistentry(@Picklistentry/retrieving_rendition__v.mdl),
   Picklistentry(@Picklistentry/archived__v.mdl),
   Picklistentry(@Picklistentry/inactive__v.mdl),
   Picklistentry(@Picklistentry/connection_invalid__sys.mdl),
   Picklistentry(@Picklistentry/source_file_not_available__sys.mdl),
   Picklistentry(@Picklistentry/source_file_and_rendition_not_available__sys.mdl),
   Picklistentry(@Picklistentry/retrieving_source_file_and_rendition__sys.mdl),
   system_managed(false),
   order_type('order_asc__sys')
);