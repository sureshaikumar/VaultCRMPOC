   label('Target Status'),
   active(true),
   Picklistentry(@Picklistentry/not_started__v.mdl),
   Picklistentry(@Picklistentry/pre_explanation_complete__v.mdl),
   Picklistentry(@Picklistentry/in_progress__v.mdl),
   Picklistentry(@Picklistentry/canceled__v.mdl),
   Picklistentry(@Picklistentry/reopened__v.mdl),
   Picklistentry(@Picklistentry/complete__v.mdl),
   system_managed(false),
   order_type('order_asc__sys')
);