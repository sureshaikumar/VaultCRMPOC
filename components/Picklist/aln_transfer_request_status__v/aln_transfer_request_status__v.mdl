RECREATE Picklist aln_transfer_request_status__v (
   label('The status of the transfer request'),
   active(true),
   Picklistentry(@Picklistentry/pending__v.mdl),
   Picklistentry(@Picklistentry/accepted__v.mdl),
   Picklistentry(@Picklistentry/rejected__v.mdl),
   Picklistentry(@Picklistentry/cancelled__v.mdl),
   system_managed(false),
   order_type('order_asc__sys')
);