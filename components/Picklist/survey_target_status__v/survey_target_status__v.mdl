RECREATE Picklist survey_target_status__v (
   label('Survey Target Status'),
   active(true),
   Picklistentry(@Picklistentry/development__v.mdl),
   Picklistentry(@Picklistentry/pending__v.mdl),
   Picklistentry(@Picklistentry/saved__v.mdl),
   Picklistentry(@Picklistentry/submitted__v.mdl),
   Picklistentry(@Picklistentry/late_submission__v.mdl),
   system_managed(false),
   order_type('order_asc__sys')
);