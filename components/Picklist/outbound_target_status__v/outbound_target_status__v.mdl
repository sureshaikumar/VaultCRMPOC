   label('Outbound Target Status'),
   active(true),
   Picklistentry(@Picklistentry/active__v.mdl),
   Picklistentry(@Picklistentry/removed__v.mdl),
   Picklistentry(@Picklistentry/done__v.mdl),
   system_managed(false),
   order_type('order_asc__sys')
);