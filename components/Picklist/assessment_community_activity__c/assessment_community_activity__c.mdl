RECREATE Picklist assessment_community_activity__c (
   label('Community Activity'),
   active(true),
   Picklistentry(@Picklistentry/very_active__c.mdl),
   Picklistentry(@Picklistentry/somewhat_active__c.mdl),
   Picklistentry(@Picklistentry/slightly_active__c.mdl),
   Picklistentry(@Picklistentry/not_active__c.mdl),
   system_managed(false),
   order_type('order_asc__sys')
);