RECREATE Picklist coaching_report_status__v (
   label('Coaching Report Status'),
   active(true),
   Picklistentry(@Picklistentry/in_progress__v.mdl),
   Picklistentry(@Picklistentry/completed_rep_approved__v.mdl),
   Picklistentry(@Picklistentry/completed_pending_approval__v.mdl),
   Picklistentry(@Picklistentry/rejected__v.mdl),
   system_managed(false),
   order_type('order_asc__sys')
);