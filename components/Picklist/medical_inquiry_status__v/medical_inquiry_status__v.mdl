RECREATE Picklist medical_inquiry_status__v (
   label('Medical Inquiry Status'),
   active(true),
   Picklistentry(@Picklistentry/new__v.mdl),
   Picklistentry(@Picklistentry/closed__v.mdl),
   Picklistentry(@Picklistentry/submitted__v.mdl),
   Picklistentry(@Picklistentry/saved__v.mdl),
   Picklistentry(@Picklistentry/in_progress__v.mdl),
   system_managed(false),
   order_type('order_asc__sys')
);