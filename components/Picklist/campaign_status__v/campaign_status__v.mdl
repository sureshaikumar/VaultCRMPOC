RECREATE Picklist campaign_status__v (
   label('Campaign Status'),
   active(true),
   Picklistentry(@Picklistentry/draft__v.mdl),
   Picklistentry(@Picklistentry/active__v.mdl),
   Picklistentry(@Picklistentry/scheduled__v.mdl),
   Picklistentry(@Picklistentry/completed__v.mdl),
   Picklistentry(@Picklistentry/canceled__v.mdl),
   system_managed(false),
   order_type('order_asc__sys')
);