RECREATE Picklist planogram_line_orientation__v (
   label('Orientation'),
   active(true),
   Picklistentry(@Picklistentry/0__v.mdl),
   Picklistentry(@Picklistentry/90__v.mdl),
   Picklistentry(@Picklistentry/180__v.mdl),
   Picklistentry(@Picklistentry/270__v.mdl),
   system_managed(false),
   order_type('order_asc__sys')
);