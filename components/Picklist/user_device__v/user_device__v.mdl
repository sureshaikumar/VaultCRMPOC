RECREATE Picklist user_device__v (
   label('User Device'),
   active(true),
   Picklistentry(@Picklistentry/online__v.mdl),
   Picklistentry(@Picklistentry/ipad__v.mdl),
   Picklistentry(@Picklistentry/iphone__v.mdl),
   Picklistentry(@Picklistentry/android__v.mdl),
   Picklistentry(@Picklistentry/desktop_windows__v.mdl),
   Picklistentry(@Picklistentry/desktop_macos__v.mdl),
   Picklistentry(@Picklistentry/data_load__v.mdl),
   system_managed(false),
   order_type('order_asc__sys')
);