RECREATE Picklist vault_clinical_sit_vault_clinical_status__v (
   label('Vault Clinical Status'),
   active(true),
   Picklistentry(@Picklistentry/active__v.mdl),
   Picklistentry(@Picklistentry/inactive__v.mdl),
   Picklistentry(@Picklistentry/archived__v.mdl),
   Picklistentry(@Picklistentry/deleted_in_vault_clinical__v.mdl),
   system_managed(false),
   order_type('order_asc__sys')
);