RECREATE Picklist microsoft_connection_status__v (
   label('Microsoft Connection Status'),
   active(true),
   Picklistentry(@Picklistentry/new__v.mdl),
   Picklistentry(@Picklistentry/pending__v.mdl),
   Picklistentry(@Picklistentry/connected__v.mdl),
   Picklistentry(@Picklistentry/disconnected__v.mdl),
   system_managed(false),
   order_type('order_asc__sys')
);