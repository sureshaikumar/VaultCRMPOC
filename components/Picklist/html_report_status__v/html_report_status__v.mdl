RECREATE Picklist html_report_status__v (
   label('HTML Report Status'),
   active(true),
   Picklistentry(@Picklistentry/in_progress__v.mdl),
   Picklistentry(@Picklistentry/published__v.mdl),
   Picklistentry(@Picklistentry/failed__v.mdl),
   Picklistentry(@Picklistentry/unpublished__v.mdl),
   system_managed(false),
   order_type('order_asc__sys')
);