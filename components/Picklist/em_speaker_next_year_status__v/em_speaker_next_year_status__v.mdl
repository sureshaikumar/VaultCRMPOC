RECREATE Picklist em_speaker_next_year_status__v (
   label('Next Year Status'),
   active(true),
   Picklistentry(@Picklistentry/nominated__v.mdl),
   Picklistentry(@Picklistentry/eligible__v.mdl),
   Picklistentry(@Picklistentry/expired__v.mdl),
   system_managed(false),
   order_type('order_asc__sys')
);