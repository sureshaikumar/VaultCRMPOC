RECREATE Picklist signature_request_status__v (
   label('Signature Request Status'),
   active(true),
   Picklistentry(@Picklistentry/requested__v.mdl),
   Picklistentry(@Picklistentry/signature_captured__v.mdl),
   Picklistentry(@Picklistentry/signature_accepted__v.mdl),
   Picklistentry(@Picklistentry/signature_declined__v.mdl),
   Picklistentry(@Picklistentry/request_canceled__v.mdl),
   Picklistentry(@Picklistentry/request_expired__v.mdl),
   system_managed(false),
   order_type('order_asc__sys')
);