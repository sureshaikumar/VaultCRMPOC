RECREATE Picklist deployment_status__v (
   label('Engage Portal Deployment Status'),
   active(true),
   Picklistentry(@Picklistentry/success__v.mdl),
   Picklistentry(@Picklistentry/failed__v.mdl),
   Picklistentry(@Picklistentry/in_progress__v.mdl),
   system_managed(false),
   order_type('order_asc__sys')
);