RECREATE Picklist document_query_modifier__v (
   label('Document Query Modifier'),
   active(true),
   Picklistentry(@Picklistentry/latest_version__v.mdl),
   Picklistentry(@Picklistentry/all_versions__v.mdl),
   Picklistentry(@Picklistentry/latest_matching_version__v.mdl),
   system_managed(false),
   order_type('order_asc__sys')
);