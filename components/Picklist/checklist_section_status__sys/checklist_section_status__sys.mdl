RECREATE Picklist checklist_section_status__sys (
   label('Checklist Section Status'),
   active(true),
   Picklistentry(@Picklistentry/hidden__sys.mdl),
   Picklistentry(@Picklistentry/not_started__sys.mdl),
   Picklistentry(@Picklistentry/in_progress__sys.mdl),
   Picklistentry(@Picklistentry/completed__sys.mdl),
   system_managed(false),
   order_type('order_asc__sys')
);