RECREATE Picklist inventory_order_line_exception_severity__v (
   label('Exception Severity'),
   active(true),
   Picklistentry(@Picklistentry/prevent__v.mdl),
   Picklistentry(@Picklistentry/warn__v.mdl),
   Picklistentry(@Picklistentry/require_approval__v.mdl),
   system_managed(false),
   order_type('order_asc__sys')
);