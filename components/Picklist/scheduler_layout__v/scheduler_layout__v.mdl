RECREATE Picklist scheduler_layout__v (
   label('Scheduler Layout'),
   active(true),
   Picklistentry(@Picklistentry/day__v.mdl),
   Picklistentry(@Picklistentry/week__v.mdl),
   Picklistentry(@Picklistentry/month__v.mdl),
   Picklistentry(@Picklistentry/scheduler__v.mdl),
   Picklistentry(@Picklistentry/map__v.mdl),
   system_managed(false),
   order_type('order_asc__sys')
);