RECREATE Picklist em_attendee_engage_provisioning_status__v (
   label('Engage Provisioning Status'),
   active(true),
   Picklistentry(@Picklistentry/missing_name__v.mdl),
   Picklistentry(@Picklistentry/request_failed__v.mdl),
   Picklistentry(@Picklistentry/retry_request__v.mdl),
   Picklistentry(@Picklistentry/success__v.mdl),
   system_managed(false),
   order_type('order_asc__sys')
);