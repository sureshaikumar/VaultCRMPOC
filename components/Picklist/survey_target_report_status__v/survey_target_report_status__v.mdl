RECREATE Picklist survey_target_report_status__v (
   label('Report Status'),
   active(true),
   Picklistentry(@Picklistentry/in_progress__v.mdl),
   Picklistentry(@Picklistentry/under_employee_review__v.mdl),
   Picklistentry(@Picklistentry/completed__v.mdl),
   Picklistentry(@Picklistentry/recalled__v.mdl),
   system_managed(false),
   order_type('order_asc__sys')
);