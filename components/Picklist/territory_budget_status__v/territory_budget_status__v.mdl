RECREATE Picklist territory_budget_status__v (
   label('Territory Budget Status'),
   active(true),
   Picklistentry(@Picklistentry/new__v.mdl),
   Picklistentry(@Picklistentry/approved__v.mdl),
   Picklistentry(@Picklistentry/submit_for_approval__v.mdl),
   Picklistentry(@Picklistentry/closed__v.mdl),
   system_managed(false),
   order_type('order_asc__sys')
);