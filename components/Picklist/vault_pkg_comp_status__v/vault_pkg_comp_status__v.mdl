   label('Inbound Package Component Status'),
   active(true),
   Picklistentry(@Picklistentry/imported__v.mdl),
   Picklistentry(@Picklistentry/verified__v.mdl),
   Picklistentry(@Picklistentry/not_verified__v.mdl),
   Picklistentry(@Picklistentry/in_deploy__v.mdl),
   Picklistentry(@Picklistentry/deployed__v.mdl),
   Picklistentry(@Picklistentry/deployed_with_warning__v.mdl),
   Picklistentry(@Picklistentry/not_supported__v.mdl),
   Picklistentry(@Picklistentry/skipped__v.mdl),
   Picklistentry(@Picklistentry/error__v.mdl),
   Picklistentry(@Picklistentry/failed_with_partial_commit__v.mdl),
   Picklistentry(@Picklistentry/deployed_with_failures__v.mdl),
   Picklistentry(@Picklistentry/deployed_with_error__v.mdl),
   Picklistentry(@Picklistentry/blocked__v.mdl),
   Picklistentry(@Picklistentry/queued__v.mdl),
   system_managed(false),
   order_type('order_asc__sys')
);