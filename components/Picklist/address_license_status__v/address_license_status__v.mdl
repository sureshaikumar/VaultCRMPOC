RECREATE Picklist address_license_status__v (
   label('License Status'),
   active(true),
   Picklistentry(@Picklistentry/new__v.mdl),
   Picklistentry(@Picklistentry/valid__v.mdl),
   Picklistentry(@Picklistentry/invalid__v.mdl),
   Picklistentry(@Picklistentry/expired__v.mdl),
   Picklistentry(@Picklistentry/sampled__v.mdl),
   system_managed(false),
   order_type('order_asc__sys')
);