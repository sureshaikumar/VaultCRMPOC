RECREATE Picklist clinical_trial_status__v (
   label('Clinical Trial Status'),
   active(true),
   Picklistentry(@Picklistentry/active__v.mdl),
   Picklistentry(@Picklistentry/approved_not_yet_active__v.mdl),
   Picklistentry(@Picklistentry/closed__v.mdl),
   Picklistentry(@Picklistentry/completed__v.mdl),
   Picklistentry(@Picklistentry/temporarily_closed__v.mdl),
   system_managed(false),
   order_type('order_asc__sys')
);