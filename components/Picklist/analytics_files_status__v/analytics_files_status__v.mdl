RECREATE Picklist analytics_files_status__v (
   label('Analytics Files Status'),
   active(true),
   Picklistentry(@Picklistentry/loaded__v.mdl),
   Picklistentry(@Picklistentry/in_progress__v.mdl),
   Picklistentry(@Picklistentry/process__v.mdl),
   Picklistentry(@Picklistentry/moved_to_production__v.mdl),
   Picklistentry(@Picklistentry/failed__v.mdl),
   Picklistentry(@Picklistentry/archived__v.mdl),
   system_managed(false),
   order_type('order_asc__sys')
);