RECREATE Picklist order_approval_status__v (
   label('Approval Status'),
   active(true),
   Picklistentry(@Picklistentry/approved__v.mdl),
   Picklistentry(@Picklistentry/in_progress__v.mdl),
   Picklistentry(@Picklistentry/recalled__v.mdl),
   Picklistentry(@Picklistentry/rejected__v.mdl),
   system_managed(false),
   order_type('order_asc__sys')
);