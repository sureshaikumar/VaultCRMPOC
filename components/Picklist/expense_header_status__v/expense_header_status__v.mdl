RECREATE Picklist expense_header_status__v (
   label('Expense Header Status'),
   active(true),
   Picklistentry(@Picklistentry/unpaid__v.mdl),
   Picklistentry(@Picklistentry/paid_in_full__v.mdl),
   Picklistentry(@Picklistentry/partial_payment__v.mdl),
   system_managed(false),
   order_type('order_asc__sys')
);