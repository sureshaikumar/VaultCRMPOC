RECREATE Picklist address_sample_send_status__v (
   label('Sample Send Status'),
   active(true),
   Picklistentry(@Picklistentry/pending__v.mdl),
   Picklistentry(@Picklistentry/valid__v.mdl),
   Picklistentry(@Picklistentry/invalid__v.mdl),
   system_managed(false),
   order_type('order_asc__sys')
);