<?xml version="1.0" encoding="UTF-8"?>
<vault:dashboard xmlns:vault="VeevaVault" type="Eighteen-Columns" layoutVersion="V2" combinePromptsBy="referencedField">
  <vault:chart name="all_accounts__c" label="All Accounts" type="table" report="Report.account__c" description="" footer="">
    <vault:position row="0" col="0" sizeX="6" sizeY="9" />
    <vault:format showReportName="true" groupsToDisplay="20" />
    <vault:series metric="RecordCount">
      <vault:grouping key="NoGrouping" value="AllValues" />
    </vault:series>
    <vault:tableChartReportColumns showRecordDetails="true">
      <vault:reportColumn key="account__v.name__v" label="Account &gt; Name" property="link" />
      <vault:reportColumn key="account__v.status_cda__v" label="Account &gt; Status" property="data" />
    </vault:tableChartReportColumns>
  </vault:chart>
  <vault:chart name="oncology_accounts__c" label="Oncology Accounts" type="table" report="Report.account_with_address1__c" description="" footer="">
    <vault:position row="0" col="6" sizeX="6" sizeY="9" />
    <vault:format showReportName="true" groupsToDisplay="20" />
    <vault:series metric="RecordCount">
      <vault:grouping key="NoGrouping" value="AllValues" />
    </vault:series>
    <vault:tableChartReportColumns showRecordDetails="true">
      <vault:reportColumn key="account__v.name__v" label="Account &gt; Name" property="link" />
      <vault:reportColumn key="address__v___account__v.name__v" label="Address &gt; Address line 1" property="link" />
      <vault:reportColumn key="account__v.type__v" label="Account &gt; Account Type" property="data" />
    </vault:tableChartReportColumns>
  </vault:chart>
  <vault:chart name="gpo_account__c" label="GPO Account" type="gauge" report="Report.gpo_with_daq__c" description="" footer="">
    <vault:position row="0" col="12" sizeX="6" sizeY="7" />
    <vault:format showmetrics="true" showgroupings="true" showvalue="true" min="0.0" max="100.0">
      <vault:range color="#427B2E" min="0.0" max="30.0" />
      <vault:range color="#D9780D" min="30.0" max="70.0" />
      <vault:range color="#B71307" min="70.0" max="100.0" />
    </vault:format>
    <vault:series metric="RecordCount.dynamic_attribute_query__v___account__v" unitlabel="  ">
      <vault:grouping key="NoGrouping" value="AllValues" />
    </vault:series>
  </vault:chart>
</vault:dashboard>