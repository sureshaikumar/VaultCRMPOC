RECREATE Docfield rendition_profile__v (
   label('Rendition Profile'),
   active(true),
   type('ObjectReference'),
   object('Object.rendition_profile__sys'),
   required(false),
   shared(true),
   multi_value(false),
   display_section('Docfieldlayout.general__c'),
   default_value(),
   blank_fields(),
   controlling_field(),
   max_value(),
   min_value(),
   max_length(),
   scale(),
   help_content('Defines the rendition settings used to create the viewable rendition. Changing the selection does not re-render the document, but Vault will apply the new settings on the next rendering event (manual re-render, upload new source file, etc.).'),
   default_security('editable'),
   security_override_editable(),
   security_override_readonly(),
   security_override_hidden(),
   used_in(),
   defined_in(),
   picklist(),
   lookupObjectFieldKey(),
   lookupObjectId(),
   lookupFieldId(),
   relationship_criteria(),
   no_copy(false),
   secure_relationship(false)
);