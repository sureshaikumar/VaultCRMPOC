RECREATE Docfield email_allows_documents__v (
   label('Insert Documents'),
   active(true),
   type('Boolean'),
   object(),
   required(false),
   shared(false),
   multi_value(false),
   display_section('Docfieldlayout.general__c'),
   default_value(),
   blank_fields(),
   controlling_field(),
   max_value(),
   min_value(),
   max_length(),
   scale(),
   help_content('If true, indicates that the Email Template HTML markup contains the {{insertEmailFragments}} markup token and therefore can include Email Fragment inserts.'),
   default_security('editable'),
   security_override_editable(),
   security_override_readonly(),
   security_override_hidden(),
   used_in(),
   defined_in('Doctype.email_template__v'),
   picklist(),
   lookupObjectFieldKey(),
   lookupObjectId(),
   lookupFieldId(),
   relationship_criteria(),
   no_copy(false),
   secure_relationship(false)
);