RECREATE Docfield global_id__sys (
   label('Global ID'),
   active(true),
   type('String'),
   object(),
   required(false),
   shared(false),
   multi_value(false),
   display_section('Docfieldlayout.general__c'),
   default_value(),
   blank_fields(),
   controlling_field(),
   max_value(),
   min_value(),
   max_length(50),
   scale(),
   help_content('This value is unique to this document in this vault. This is useful for integrations.'),
   default_security('editable'),
   security_override_editable(),
   security_override_readonly(),
   security_override_hidden(),
   used_in(),
   defined_in('Doctype.base_document__v'),
   picklist(),
   lookupObjectFieldKey(),
   lookupObjectId(),
   lookupFieldId(),
   relationship_criteria(),
   no_copy(true),
   secure_relationship(false)
);