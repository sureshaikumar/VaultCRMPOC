RECREATE Docfield link__sys (
   label('Document Link'),
   active(true),
   type('String'),
   object(),
   required(false),
   shared(false),
   multi_value(false),
   display_section('Docfieldlayout.general__c'),
   default_value(),
   blank_fields(),
   controlling_field(),
   max_value(),
   min_value(),
   max_length(200),
   scale(),
   help_content('This field is intended to store a value that uniquely identifies the source of this document’s content, such as a vault document’s Global ID.'),
   default_security('editable'),
   security_override_editable(),
   security_override_readonly(),
   security_override_hidden(),
   used_in(),
   defined_in('Doctype.base_document__v'),
   picklist(),
   lookupObjectFieldKey(),
   lookupObjectId(),
   lookupFieldId(),
   relationship_criteria(),
   no_copy(true),
   secure_relationship(false)
);