RECREATE Docfield segment__v (
   label('Segment'),
   active(true),
   type('String'),
   object(),
   required(false),
   shared(false),
   multi_value(false),
   display_section('Docfieldlayout.content_library_details__v'),
   default_value(),
   blank_fields(),
   controlling_field(),
   max_value(),
   min_value(),
   max_length(80),
   scale(),
   help_content('Segment for which this slide should display. If blank, this slide displays for all accounts not aligned to a segment.'),
   default_security('editable'),
   security_override_editable(),
   security_override_readonly(),
   security_override_hidden(),
   used_in(),
   defined_in('Doctype.slide__v'),
   picklist(),
   lookupObjectFieldKey(),
   lookupObjectId(),
   lookupFieldId(),
   relationship_criteria(),
   no_copy(false),
   secure_relationship(false)
);