RECREATE Docfield document_number__v (
   label('Document Number'),
   active(true),
   type('Autonumber'),
   object(),
   required(true),
   shared(false),
   multi_value(false),
   display_section('Docfieldlayout.general__c'),
   default_value(),
   blank_fields(),
