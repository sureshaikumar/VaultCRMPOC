   max_value(),
   min_value(),
   max_length(),
   scale(),
   help_content('The unique identifier for each document in Vault. Once created, it cannot be modified (except when document is reclassified).'),
   default_security('editable'),
   security_override_editable(),
   security_override_readonly(),
   security_override_hidden(),
   used_in(),
   defined_in('Doctype.base_document__v'),
   picklist(),
   lookupObjectFieldKey(),
   lookupObjectId(),
   lookupFieldId(),
   relationship_criteria(),
   no_copy(false),
   secure_relationship(false)
);