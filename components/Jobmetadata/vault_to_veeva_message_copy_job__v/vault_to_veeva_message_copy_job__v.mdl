   job_code('Sdkjob.com.veeva.vault.app.vaultcrm.core.common.jobs.VaultMessageToVeevaMessageCopyJob'),
   queue(),
   single_instance_states('scheduled',
      'queued',
      'running'),
   timeout_duration()
);