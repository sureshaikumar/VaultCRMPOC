RECREATE Jobmetadata medical_inquiry_crm_outbound_job__v (
   label('Medical Inquiry to Medical Outbound Job'),
   active(true),
   chunk_size(500),
   description('A job that sends a spark message to Medical indicating that there are updated Medical Inquiries ready to be transferred from Vault CRM to Medical.'),
   job_code('Sdkjob.com.veeva.vault.app.vaultcrm.core.medical.jobs.SendMedicalOutboundMessageJob'),
   queue(),
   single_instance_states('scheduled',
      'queued'),
   timeout_duration()
);