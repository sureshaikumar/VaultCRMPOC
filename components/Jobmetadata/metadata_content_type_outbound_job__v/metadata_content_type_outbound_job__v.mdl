   label('Commercial Metadata Content Type Outbound Job'),
   active(true),
   chunk_size(500),
   description('A job that sends a spark message to a Commercial Vault indicating that there is updated Content Type metadata ready to be synced from Vault CRM.'),
   job_code('Sdkjob.com.veeva.vault.app.vaultcrm.core.commercialmetadata.jobs.CommercialMetadataContentTypeOutboundJob'),
   queue(),
   single_instance_states('scheduled',
      'queued'),
   timeout_duration()
);