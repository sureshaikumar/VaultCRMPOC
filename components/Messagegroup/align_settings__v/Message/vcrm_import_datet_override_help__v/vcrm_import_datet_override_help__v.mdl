Message vcrm_import_datet_override_help__v (
   label(),
   active(true),
   default_value('Setting this field will cause the next Import from CRM to retrieve all records that were<br/>inserted or updated after this date for all objects that are imported from CRM. This may<br/>not be set in conjunction with a full CRM refresh, and the date cannot be in the future.'),
   system_managed(false)
);